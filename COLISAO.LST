     1                                  ; =============================================================================
     2                                  ; colisao.asm  -  Deteccao de golpes validos (soco e chute)
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; Um golpe so causa dano no FRAME DE IMPACTO da animacao (um unico frame por
     5                                  ; golpe), de modo que cada soco/chute tira no maximo 1 ponto de energia.
     6                                  ;
     7                                  ; Condicoes de acerto:
     8                                  ;   SOCO  : |x_atacante - x_defensor| <= ALCANCE_SOCO
     9                                  ;           |y_atacante - y_defensor| <= TOLERANCIA_Y (mesma altura)
    10                                  ;           defensor NAO esta abaixado          -> defesa: abaixar ou pular
    11                                  ;   CHUTE : |x_atacante - x_defensor| <= ALCANCE_CHUTE
    12                                  ;           defensor NAO esta no ar             -> defesa: pular
    13                                  ;
    14                                  ; Rotina publica: verifica_golpe
    15                                  ; =============================================================================
    16                                  
    17                                  %include "const.inc"
    18                              <1> ; =============================================================================
    19                              <1> ; const.inc  -  Constantes compartilhadas por todos os modulos do jogo
    20                              <1> ; -----------------------------------------------------------------------------
    21                              <1> ; Contem apenas EQUs (nao gera codigo nem dados). Incluido com
    22                              <1> ;   %include "const.inc"
    23                              <1> ; em cada modulo .asm. Qualquer alteracao aqui exige remontar todos os
    24                              <1> ; modulos (o Makefile ja declara essa dependencia).
    25                              <1> ; =============================================================================
    26                              <1> 
    27                              <1> ; ------------------------------- Hardware -------------------------------------
    28                              <1> KB_DATA         EQU     60h         ; porta de dados do teclado (8042)
    29                              <1> KB_CTL          EQU     61h         ; porta de controle do teclado (8255 PB)
    30                              <1> PICTRL          EQU     20h         ; porta de comando do PIC 8259
    31                              <1> EOI             EQU     20h         ; comando End Of Interrupt
    32                              <1> INT_TEC         EQU     09h         ; interrupcao de hardware do teclado (IRQ1)
    33                              <1> INT_CLK         EQU     08h         ; interrupcao de hardware do 8253 (IRQ0)
    34                              <1> 
    35                              <1> ; ------------------------------- Scan codes (make) ----------------------------
    36                              <1> TEC_ESC         EQU     01h
    37                              <1> TEC_Q           EQU     10h
    38                              <1> TEC_W           EQU     11h
    39                              <1> TEC_R           EQU     13h
    40                              <1> TEC_T           EQU     14h
    41                              <1> TEC_Y           EQU     15h
    42                              <1> TEC_P           EQU     19h
    43                              <1> TEC_ENTER       EQU     1Ch
    44                              <1> TEC_A           EQU     1Eh
    45                              <1> TEC_S           EQU     1Fh
    46                              <1> TEC_D           EQU     20h
    47                              <1> TEC_N           EQU     31h
    48                              <1> TEC_M           EQU     32h
    49                              <1> TEC_CIMA        EQU     48h         ; seta para cima   (chega apos o prefixo E0h)
    50                              <1> TEC_ESQ         EQU     4Bh         ; seta esquerda    (apos E0h)
    51                              <1> TEC_DIR         EQU     4Dh         ; seta direita     (apos E0h)
    52                              <1> TEC_BAIXO       EQU     50h         ; seta para baixo  (apos E0h)
    53                              <1> 
    54                              <1> ; ------------------------------- Cores (paleta padrao VGA) --------------------
    55                              <1>                                     ; I R G B
    56                              <1> preto           EQU     0           ; 0 0 0 0
    57                              <1> azul            EQU     1           ; 0 0 0 1
    58                              <1> verde           EQU     2           ; 0 0 1 0
    59                              <1> cyan            EQU     3           ; 0 0 1 1
    60                              <1> vermelho        EQU     4           ; 0 1 0 0
    61                              <1> magenta         EQU     5           ; 0 1 0 1
    62                              <1> marrom          EQU     6           ; 0 1 1 0
    63                              <1> branco          EQU     7           ; 0 1 1 1
    64                              <1> cinza           EQU     8           ; 1 0 0 0
    65                              <1> azul_claro      EQU     9           ; 1 0 0 1
    66                              <1> verde_claro     EQU     10          ; 1 0 1 0
    67                              <1> cyan_claro      EQU     11          ; 1 0 1 1
    68                              <1> rosa            EQU     12          ; 1 1 0 0
    69                              <1> magenta_claro   EQU     13          ; 1 1 0 1
    70                              <1> amarelo         EQU     14          ; 1 1 1 0
    71                              <1> branco_intenso  EQU     15          ; 1 1 1 1
    72                              <1> 
    73                              <1> ; ------------------------------- Arena e HUD ----------------------------------
    74                              <1> ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
    75                              <1> ARENA_ESQ       EQU     10
    76                              <1> ARENA_DIR       EQU     629
    77                              <1> ARENA_BAIXO     EQU     70          ; chao
    78                              <1> ARENA_TOPO      EQU     420         ; acima disso fica o HUD
    79                              <1> 
    80                              <1> BARRA_Y_BAIXO   EQU     440         ; barras de energia
    81                              <1> BARRA_Y_TOPO    EQU     460
    82                              <1> BARRA_P1_X      EQU     20          ; J1: X = 20..219
    83                              <1> BARRA_P2_X      EQU     420         ; J2: X = 420..619
    84                              <1> LARG_BLOCO      EQU     20          ; 1 ponto de energia = 20 px de barra
    85                              <1> 
    86                              <1> ; Linhas de texto (modo 12h: 30 linhas x 80 colunas, celula 8x16)
    87                              <1> LIN_TEMPO       EQU     1           ; cronometro (centro do HUD)
    88                              <1> COL_TEMPO       EQU     38
    89                              <1> LIN_MSG         EQU     6           ; mensagens no centro da arena (acima do pulo)
    90                              <1> LIN_CONFIRMA    EQU     27          ; confirmacao de saida (abaixo do chao)
    91                              <1> 
    92                              <1> ; ------------------------------- Regras do jogo -------------------------------
    93                              <1> ENERGIA_INICIAL EQU     10          ; golpes validos para perder o round
    94                              <1> ROUNDS_VITORIA  EQU     2           ; melhor de tres
    95                              <1> TEMPO_ROUND     EQU     180         ; 3 minutos, em segundos
    96                              <1> MOTIVO_KO       EQU     1           ; round terminou por falta de energia
    97                              <1> MOTIVO_TEMPO    EQU     2           ; round terminou por tempo esgotado
    98                              <1> 
    99                              <1> ; ------------------------------- Fisica dos lutadores -------------------------
   100                              <1> VELOCIDADE      EQU     4           ; pixels por tique (~73 px/s)
   101                              <1> LIM_ESQ         EQU     40          ; menor X permitido para o centro do boneco
   102                              <1> LIM_DIR         EQU     598         ; maior X permitido (braco vai ate +27)
   103                              <1> DIST_MIN        EQU     50          ; distancia minima entre os dois lutadores
   104                              <1> Y_CHAO          EQU     156         ; Y dos ombros com o lutador no chao
   105                              <1> VEL_PULO        EQU     22          ; velocidade vertical inicial do pulo (px/tique)
   106                              <1> GRAVIDADE       EQU     2           ; reducao de VY a cada tique
   107                              <1> X_INICIAL_J1    EQU     150
   108                              <1> X_INICIAL_J2    EQU     490
   109                              <1> 
   110                              <1> ; ------------------------------- Colisao --------------------------------------
   111                              <1> ALCANCE_SOCO    EQU     68          ; distancia maxima em X para o soco acertar
   112                              <1> ALCANCE_CHUTE   EQU     74          ; distancia maxima em X para o chute acertar
   113                              <1> TOLERANCIA_Y    EQU     25          ; diferenca de altura maxima para o soco
   114                              <1> FRAME_IMPACTO_SOCO  EQU 2           ; frame da animacao em que o soco "pega"
   115                              <1> FRAME_IMPACTO_CHUTE EQU 3           ; frame da animacao em que o chute "pega"
   116                              <1> 
   117                              <1> ; ------------------------------- Estados de animacao --------------------------
   118                              <1> EST_IDLE        EQU     0
   119                              <1> EST_ANDA        EQU     1
   120                              <1> EST_SOCO        EQU     2
   121                              <1> EST_CHUTE       EQU     3
   122                              <1> EST_ABAIXA      EQU     4
   123                              <1> 
   124                              <1> ; ------------------------------- Estrutura de um jogador (20 bytes) -----------
   125                              <1> ; Acesse sempre como [SI+campo] ou [jogadorN+campo].
   126                              <1> JX              EQU     0           ; dw  posicao X atual (centro do tronco)
   127                              <1> JY              EQU     2           ; dw  posicao Y atual (ombros)
   128                              <1> JXANT           EQU     4           ; dw  X onde foi desenhado por ultimo
   129                              <1> JYANT           EQU     6           ; dw  Y onde foi desenhado por ultimo
   130                              <1> JFRAME          EQU     8           ; db  frame atual da animacao
   131                              <1> JFRAMEANT       EQU     9           ; db  frame desenhado por ultimo
   132                              <1> JDIR            EQU     10          ; db  0 = olha p/ direita, 1 = p/ esquerda
   133                              <1> JDIRANT         EQU     11          ; db  direcao desenhada por ultimo
   134                              <1> JCOR            EQU     12          ; db  cor do lutador (escolhida na selecao)
   135                              <1> JENERGIA        EQU     13          ; db  energia (comeca em ENERGIA_INICIAL)
   136                              <1> JESTADO         EQU     14          ; db  estado de animacao (EST_*)
   137                              <1> JESTADOANT      EQU     15          ; db  estado desenhado por ultimo
   138                              <1> JVY             EQU     16          ; dw  velocidade vertical (positiva = sobe)
   139                              <1> JPULO           EQU     18          ; db  1 = no ar, 0 = no chao
   140                              <1>                                     ; byte 19: reserva (alinhamento)
   141                              <1> TAM_JOGADOR     EQU     20
   142                                  
   143                                  global  verifica_golpe
   144                                  
   145                                  extern  atualiza_barra              ; hud.asm
   146                                  extern  ultimo_golpe                ; logica.asm
   147                                  extern  jogador1                    ; jogador.asm
   148                                  
   149                                  segment code public class=CODE
   150                                  
   151                                  ; =============================================================================
   152                                  ; verifica_golpe
   153                                  ; Entrada: SI = atacante, DI = defensor.
   154                                  ; Se o golpe for valido, decrementa a energia do defensor, atualiza a barra
   155                                  ; na tela e registra quem acertou por ultimo (usado no desempate).
   156                                  ; =============================================================================
   157                                  verifica_golpe:
   158 00000000 50                              PUSH    AX
   159 00000001 53                              PUSH    BX
   160                                  
   161 00000002 8A440E                          MOV     AL, [SI+JESTADO]
   162 00000005 8A6408                          MOV     AH, [SI+JFRAME]
   163                                  
   164 00000008 3C02                            CMP     AL, EST_SOCO
   165 0000000A 7407                            JE      vg_testa_soco
   166 0000000C 3C03                            CMP     AL, EST_CHUTE
   167 0000000E 7423                            JE      vg_testa_chute
   168 00000010 E95600                          JMP     vg_fim
   169                                  
   170                                          ; ---- soco ------------------------------------------------------------
   171                                  vg_testa_soco:
   172 00000013 80FC02                          CMP     AH, FRAME_IMPACTO_SOCO
   173 00000016 7551                            JNE     vg_fim
   174 00000018 807D0E04                        CMP     byte [DI+JESTADO], EST_ABAIXA   ; defensor abaixado: soco passa por cima
   175 0000001C 744B                            JE      vg_fim
   176 0000001E 8B4402                          MOV     AX, [SI+JY]                     ; mesma altura?
   177 00000021 2B4502                          SUB     AX, [DI+JY]
   178 00000024 7902                            JNS     vg_soco_abs_y
   179 00000026 F7D8                            NEG     AX
   180                                  vg_soco_abs_y:
   181 00000028 3D1900                          CMP     AX, TOLERANCIA_Y
   182 0000002B 7F3C                            JG      vg_fim                          ; defensor no ar (ou atacante)
   183 0000002D BB4400                          MOV     BX, ALCANCE_SOCO
   184 00000030 E90E00                          JMP     vg_checa_dist_x
   185                                  
   186                                          ; ---- chute -----------------------------------------------------------
   187                                  vg_testa_chute:
   188 00000033 80FC03                          CMP     AH, FRAME_IMPACTO_CHUTE
   189 00000036 7531                            JNE     vg_fim
   190 00000038 807D1200                        CMP     byte [DI+JPULO], 0              ; defensor no ar: chute passa por baixo
   191 0000003C 752B                            JNE     vg_fim
   192 0000003E BB4A00                          MOV     BX, ALCANCE_CHUTE
   193                                  
   194                                          ; ---- distancia horizontal -------------------------------------------
   195                                  vg_checa_dist_x:
   196 00000041 8B04                            MOV     AX, [SI+JX]
   197 00000043 2B05                            SUB     AX, [DI+JX]
   198 00000045 7902                            JNS     vg_abs_x
   199 00000047 F7D8                            NEG     AX
   200                                  vg_abs_x:
   201 00000049 39D8                            CMP     AX, BX
   202 0000004B 7F1C                            JG      vg_fim                          ; longe demais
   203                                  
   204                                          ; ---- golpe valido ----------------------------------------------------
   205 0000004D 807D0D00                        CMP     byte [DI+JENERGIA], 0
   206 00000051 7416                            JE      vg_fim
   207 00000053 FE4D0D                          DEC     byte [DI+JENERGIA]
   208 00000056 E8(0000)                        CALL    atualiza_barra
   209 00000059 C606[0000]01                    MOV     byte [ultimo_golpe], 1          ; registra quem acertou
   210 0000005E 81FE[0000]                      CMP     SI, jogador1
   211 00000062 7405                            JE      vg_fim
   212 00000064 C606[0000]02                    MOV     byte [ultimo_golpe], 2
   213                                  vg_fim:
   214 00000069 5B                              POP     BX
   215 0000006A 58                              POP     AX
   216 0000006B C3                              RET
