     1                                  ; =============================================================================
     2                                  ; graficos.asm  -  Rotinas graficas do Jogo de Luta (modo 12h, 640x480x16)
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; desenha_jogador : desenha um lutador completo (generica para P1 e P2)
     5                                  ; cursor, caracter, plot_xy, circle, full_circle, line, linha_grossa
     6                                  ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
     7                                  ; =============================================================================
     8                                  
     9                                  global  desenha_jogador
    10                                  global  cursor
    11                                  global  caracter
    12                                  global  plot_xy
    13                                  global  circle
    14                                  global  full_circle
    15                                  global  line
    16                                  global  linha_grossa
    17                                  
    18                                  extern  cor                     ; trabalho.asm
    19                                  extern  deltAX                  ; trabalho.asm
    20                                  extern  deltay                  ; trabalho.asm
    21                                  extern  tam_corpo               ; trabalho.asm
    22                                  
    23                                  segment code public class=CODE
    24                                  
    25                                  ;-----------------------------------------------------------------------------
    26                                  ; desenha_jogador
    27                                  ; Entrada:
    28                                  ;   AL = cor (use preto para APAGAR)
    29                                  ;   AH = indice do frame da animacao (cada frame = 32 bytes em v_idle)
    30                                  ;	BH = estado da animação (0 = idle, 1 = andando, 2 = soco, 3 = chute)
    31                                  ;   BL = espelho: 0 = olha para a direita, 1 = olha para a esquerda
    32                                  ;        (com espelho, os offsets X do frame tem o sinal invertido)
    33                                  ;   CX = X base (centro do tronco)
    34                                  ;   DX = Y base (altura dos ombros)
    35                                  ; Preserva todos os registradores e flags.
    36                                  ;
    37                                  ; Formato de um frame (8 pontos X,Y relativos ao ombro):
    38                                  ;   braco esq: articulacao, mao   | braco dir: articulacao, mao
    39                                  ;   perna esq: joelho, pe         | perna dir: joelho, pe
    40                                  ; Bracos partem do ombro (X, Y); pernas partem do quadril (X, Y - tam_corpo).
    41                                  ;-----------------------------------------------------------------------------
    42                                  ;-----------------------------------------------------------------------------
    43                                  ; desenha_jogador (Versão Esqueleto Dinâmico - 40 bytes por frame)
    44                                  ;-----------------------------------------------------------------------------
    45                                  desenha_jogador:
    46 00000000 9C                              PUSHF
    47 00000001 50                              PUSH    AX
    48 00000002 53                              PUSH    BX
    49 00000003 51                              PUSH    CX
    50 00000004 52                              PUSH    DX
    51 00000005 56                              PUSH    SI
    52 00000006 57                              PUSH    DI
    53                                  
    54 00000007 A2[0000]                        MOV     [cor], AL
    55 0000000A 881E[1000]                      MOV     [espelho], BL
    56 0000000E 890E[0000]                      MOV     [base_x], CX
    57 00000012 8916[0200]                      MOV     [base_y], DX
    58                                          
    59 00000016 50                              PUSH    AX
    60 00000017 53                              PUSH    BX
    61                                  
    62                                          ; 1. Encontra a animação correta
    63 00000018 88F8                            MOV     AL, BH
    64 0000001A 30E4                            XOR     AH, AH
    65 0000001C D1E0                            SHL     AX, 1
    66 0000001E 89C6                            MOV     SI, AX
    67 00000020 8B9C[1100]                      MOV     BX, [tabela_animacoes + SI]
    68                                  
    69                                          ; 2. Calcula offset do Frame (AH * 40 bytes: SHL 3 + SHL 5)
    70 00000024 5A                              POP     DX
    71 00000025 58                              POP     AX
    72                                          
    73 00000026 50                              PUSH    AX
    74 00000027 88E0                            MOV     AL, AH
    75 00000029 30E4                            XOR     AH, AH
    76 0000002B 89C7                            MOV     DI, AX
    77 0000002D C1E703                          SHL     DI, 3                   ; DI = frame * 8
    78 00000030 89F9                            MOV     CX, DI
    79 00000032 C1E702                          SHL     DI, 2                   ; DI = frame * 32
    80 00000035 01CF                            ADD     DI, CX                  ; DI = frame * 40
    81 00000037 01DF                            ADD     DI, BX                  ; DI aponta para o frame correto
    82 00000039 58                              POP     AX
    83                                  
    84                                          ; 3. Lê Ponto 0: Offset do Ombro (relativo à base JX, JY)
    85 0000003A E87500                          CALL    le_ponto_ombro
    86 0000003D A3[0400]                        MOV     [ombro_x], AX
    87 00000040 891E[0600]                      MOV     [ombro_y], BX
    88                                  
    89                                          ; 4. Lê Ponto 1: Vetor do Quadril (relativo ao Ombro)
    90 00000044 E88600                          CALL    le_ponto_quadril
    91 00000047 A3[0800]                        MOV     [quadril_x], AX
    92 0000004A 891E[0A00]                      MOV     [quadril_y], BX
    93                                  
    94                                          ; ---- Cabeça: Raio 10, centro 10px acima do Ombro ----
    95 0000004E A1[0400]                        MOV     AX, [ombro_x]
    96 00000051 50                              PUSH    AX
    97 00000052 A1[0600]                        MOV     AX, [ombro_y]
    98 00000055 050A00                          ADD     AX, 10
    99 00000058 50                              PUSH    AX
   100 00000059 B80A00                          MOV     AX, 10
   101 0000005C 50                              PUSH    AX
   102 0000005D E8F801                          CALL    full_circle
   103                                  
   104                                          ; ---- Tronco: Linha do Ombro ao Quadril ----
   105 00000060 A1[0400]                        MOV     AX, [ombro_x]
   106 00000063 50                              PUSH    AX
   107 00000064 A1[0600]                        MOV     AX, [ombro_y]
   108 00000067 50                              PUSH    AX
   109 00000068 A1[0800]                        MOV     AX, [quadril_x]
   110 0000006B 50                              PUSH    AX
   111 0000006C A1[0A00]                        MOV     AX, [quadril_y]
   112 0000006F 50                              PUSH    AX
   113 00000070 E8A202                          CALL    linha_grossa
   114                                  
   115                                          ; ---- 4 Membros (2 Braços saem do Ombro, 2 Pernas saem do Quadril) ----
   116 00000073 B90400                          MOV     CX, 4
   117                                  dj_membro:
   118 00000076 81F90200                        CMP     CX, 2
   119 0000007A 770A                            JA      dj_origem_ombro
   120                                          ; Pernas (CX = 2, 1) saem do Quadril
   121 0000007C A1[0800]                        MOV     AX, [quadril_x]
   122 0000007F 8B1E[0A00]                      MOV     BX, [quadril_y]
   123 00000083 E90700                          JMP     dj_origem_ok
   124                                  dj_origem_ombro:
   125                                          ; Braços (CX = 4, 3) saem do Ombro
   126 00000086 A1[0400]                        MOV     AX, [ombro_x]
   127 00000089 8B1E[0600]                      MOV     BX, [ombro_y]
   128                                  dj_origem_ok:
   129 0000008D A3[0C00]                        MOV     [membro_base_x], AX
   130 00000090 891E[0E00]                      MOV     [membro_base_y], BX
   131                                  
   132 00000094 50                              PUSH    AX                      ; x1 = origem
   133 00000095 53                              PUSH    BX                      ; y1
   134 00000096 E84F00                          CALL    le_ponto_membro         ; AX,BX = articulação
   135 00000099 50                              PUSH    AX                      ; x2
   136 0000009A 53                              PUSH    BX                      ; y2
   137 0000009B E87702                          CALL    linha_grossa
   138                                  
   139 0000009E 50                              PUSH    AX                      ; x1 = articulação
   140 0000009F 53                              PUSH    BX                      ; y1
   141 000000A0 E84500                          CALL    le_ponto_membro         ; AX,BX = extremidade
   142 000000A3 50                              PUSH    AX                      ; x2
   143 000000A4 53                              PUSH    BX                      ; y2
   144 000000A5 E86D02                          CALL    linha_grossa
   145                                  
   146 000000A8 E2CC                            LOOP    dj_membro
   147                                  
   148 000000AA 5F                              POP     DI
   149 000000AB 5E                              POP     SI
   150 000000AC 5A                              POP     DX
   151 000000AD 59                              POP     CX
   152 000000AE 5B                              POP     BX
   153 000000AF 58                              POP     AX
   154 000000B0 9D                              POPF
   155 000000B1 C3                              RET
   156                                  
   157                                  ; Auxiliares de leitura de pontos
   158                                  le_ponto_ombro:
   159 000000B2 8B05                            MOV     AX, [DI]
   160 000000B4 803E[1000]00                    CMP     byte [espelho], 0
   161 000000B9 7402                            JE      lpo_sem
   162 000000BB F7D8                            NEG     AX
   163                                  lpo_sem:
   164 000000BD 0306[0000]                      ADD     AX, [base_x]
   165 000000C1 8B5D02                          MOV     BX, [DI+2]
   166 000000C4 031E[0200]                      ADD     BX, [base_y]
   167 000000C8 81C70400                        ADD     DI, 4
   168 000000CC C3                              RET
   169                                  
   170                                  le_ponto_quadril:
   171 000000CD 8B05                            MOV     AX, [DI]
   172 000000CF 803E[1000]00                    CMP     byte [espelho], 0
   173 000000D4 7402                            JE      lpq_sem
   174 000000D6 F7D8                            NEG     AX
   175                                  lpq_sem:
   176 000000D8 0306[0400]                      ADD     AX, [ombro_x]
   177 000000DC 8B5D02                          MOV     BX, [DI+2]
   178 000000DF 031E[0600]                      ADD     BX, [ombro_y]
   179 000000E3 81C70400                        ADD     DI, 4
   180 000000E7 C3                              RET
   181                                  
   182                                  le_ponto_membro:
   183 000000E8 8B05                            MOV     AX, [DI]
   184 000000EA 803E[1000]00                    CMP     byte [espelho], 0
   185 000000EF 7402                            JE      lpm_sem
   186 000000F1 F7D8                            NEG     AX
   187                                  lpm_sem:
   188 000000F3 0306[0C00]                      ADD     AX, [membro_base_x]
   189 000000F7 8B5D02                          MOV     BX, [DI+2]
   190 000000FA 031E[0E00]                      ADD     BX, [membro_base_y]
   191 000000FE 81C70400                        ADD     DI, 4
   192 00000102 C3                              RET
   193                                  
   194                                  ;-----------------------------------------------------------------------------
   195                                  ; le_ponto (uso interno de desenha_jogador)
   196                                  ; Le um par (offX, offY) em [DI], aplica o espelho e soma a base.
   197                                  ; Saida: AX = X absoluto, BX = Y absoluto, DI avancado 4 bytes.
   198                                  ;-----------------------------------------------------------------------------
   199                                  le_ponto:
   200 00000103 8B05                            MOV     AX, [DI]
   201 00000105 803E[1000]00                    CMP     byte [espelho], 0
   202 0000010A 7402                            JE      lp_sem_espelho
   203 0000010C F7D8                            NEG     AX
   204                                  lp_sem_espelho:
   205 0000010E 0306[0000]                      ADD     AX, [base_x]
   206 00000112 8B5D02                          MOV     BX, [DI+2]
   207 00000115 031E[0200]                      ADD     BX, [base_y]
   208 00000119 81C70400                        ADD     DI, 4
   209 0000011D C3                              RET
   210                                  
   211                                  ;-----------------------------------------------------------------------------
   212                                  ;função cursor
   213                                  ; Parametros:
   214                                  ; 	DH = linha (0-29) e  DL = coluna  (0-79)
   215                                  cursor:
   216 0000011E 9C                      		PUSHf
   217 0000011F 50                      		PUSH 	AX
   218 00000120 53                      		PUSH 	BX
   219 00000121 51                      		PUSH	CX
   220 00000122 52                      		PUSH	DX
   221 00000123 56                      		PUSH	SI
   222 00000124 57                      		PUSH	DI
   223 00000125 55                      		PUSH	BP
   224 00000126 B402                    		MOV     AH,2
   225 00000128 B700                    		MOV     BH,0
   226 0000012A CD10                    		INT     10h
   227 0000012C 5D                      		POP		BP
   228 0000012D 5F                      		POP		DI
   229 0000012E 5E                      		POP		SI
   230 0000012F 5A                      		POP		DX
   231 00000130 59                      		POP		CX
   232 00000131 5B                      		POP		BX
   233 00000132 58                      		POP		AX
   234 00000133 9D                      		POPf
   235 00000134 C3                      		RET
   236                                  ;-----------------------------------------------------------------------------
   237                                  ;função caracter escrito na posição do cursor
   238                                  ; Parametros:
   239                                  ; 	AL = caracter a ser escrito
   240                                  ; 	cor definida na variavel cor
   241                                  caracter:
   242 00000135 9C                      		PUSHf
   243 00000136 50                      		PUSH 	AX
   244 00000137 53                      		PUSH 	BX
   245 00000138 51                      		PUSH	CX
   246 00000139 52                      		PUSH	DX
   247 0000013A 56                      		PUSH	SI
   248 0000013B 57                      		PUSH	DI
   249 0000013C 55                      		PUSH	BP
   250 0000013D B409                        	MOV     AH,9
   251 0000013F B700                        	MOV     BH,0
   252 00000141 B90100                      	MOV     CX,1
   253 00000144 8A1E[0000]                 		MOV     bl,[cor]
   254 00000148 CD10                        	INT     10h
   255 0000014A 5D                      		POP		BP
   256 0000014B 5F                      		POP		DI
   257 0000014C 5E                      		POP		SI
   258 0000014D 5A                      		POP		DX
   259 0000014E 59                      		POP		CX
   260 0000014F 5B                      		POP		BX
   261 00000150 58                      		POP		AX
   262 00000151 9D                      		POPf
   263 00000152 C3                      		RET
   264                                  ;-----------------------------------------------------------------------------
   265                                  ;função plot_xy
   266                                  ; Parametros:
   267                                  ;	PUSH x; PUSH y; CALL plot_xy;  (x<639, y<479)
   268                                  ; 	cor definida na variavel cor
   269                                  plot_xy:
   270 00000153 55                      		PUSH	BP
   271 00000154 89E5                    		MOV		BP,SP
   272 00000156 9C                      		PUSHf
   273 00000157 50                      		PUSH 	AX
   274 00000158 53                      		PUSH 	BX
   275 00000159 51                      		PUSH	CX
   276 0000015A 52                      		PUSH	DX
   277 0000015B 56                      		PUSH	SI
   278 0000015C 57                      		PUSH	DI
   279 0000015D B40C                    	    MOV     AH,0Ch
   280 0000015F A0[0000]                	    MOV     AL,[cor]
   281 00000162 B700                    	    MOV     BH,0
   282 00000164 BADF01                  	    MOV     DX,479
   283 00000167 2B5604                  		SUB		DX,[BP+4]
   284 0000016A 8B4E06                  	    MOV     CX,[BP+6]
   285 0000016D CD10                    	    INT     10h
   286 0000016F 5F                      		POP		DI
   287 00000170 5E                      		POP		SI
   288 00000171 5A                      		POP		DX
   289 00000172 59                      		POP		CX
   290 00000173 5B                      		POP		BX
   291 00000174 58                      		POP		AX
   292 00000175 9D                      		POPf
   293 00000176 5D                      		POP		BP
   294 00000177 C20400                  		RET		4
   295                                  ;-----------------------------------------------------------------------------
   296                                  ;função circle
   297                                  ; Parametros:
   298                                  ;	PUSH xc; PUSH yc; PUSH r; CALL circle;  (xc+r<639,yc+r<479)e(xc-r>0,yc-r>0)
   299                                  ; 	cor definida na variavel cor
   300                                  circle:
   301 0000017A 55                      	PUSH 	BP
   302 0000017B 89E5                    	MOV	 	BP,SP
   303 0000017D 9C                      	PUSHf                        	;coloca os flags na pilha
   304 0000017E 50                      	PUSH 	AX
   305 0000017F 53                      	PUSH 	BX
   306 00000180 51                      	PUSH	CX
   307 00000181 52                      	PUSH	DX
   308 00000182 56                      	PUSH	SI
   309 00000183 57                      	PUSH	DI
   310                                  	
   311 00000184 8B4608                  	MOV		AX,[BP+8]    			;resgata xc
   312 00000187 8B5E06                  	MOV		BX,[BP+6]    			;resgata yc
   313 0000018A 8B4E04                  	MOV		CX,[BP+4]    			;resgata r
   314                                  	
   315 0000018D 89DA                    	MOV 	DX,BX	
   316 0000018F 01CA                    	ADD		DX,CX       			;ponto extremo superior
   317 00000191 50                      	PUSH    AX			
   318 00000192 52                      	PUSH	DX
   319 00000193 E8BDFF                  	CALL plot_xy
   320                                  	
   321 00000196 89DA                    	MOV		DX,BX
   322 00000198 29CA                    	SUB		DX,CX       			;ponto extremo inferior
   323 0000019A 50                      	PUSH    AX			
   324 0000019B 52                      	PUSH	DX
   325 0000019C E8B4FF                  	CALL plot_xy
   326                                  	
   327 0000019F 89C2                    	MOV 	DX,AX	
   328 000001A1 01CA                    	ADD		DX,CX       			;ponto extremo DIreita
   329 000001A3 52                      	PUSH    DX			
   330 000001A4 53                      	PUSH	BX
   331 000001A5 E8ABFF                  	CALL plot_xy
   332                                  	
   333 000001A8 89C2                    	MOV		DX,AX
   334 000001AA 29CA                    	SUB		DX,CX       			;ponto extremo esquerda
   335 000001AC 52                      	PUSH    DX			
   336 000001AD 53                      	PUSH	BX
   337 000001AE E8A2FF                  	CALL plot_xy
   338                                  		
   339 000001B1 89CF                    	MOV		DI,CX
   340 000001B3 81EF0100                	SUB		DI,1	 				;DI = r-1
   341 000001B7 BA0000                  	MOV		DX,0  					;DX será a variável x. CX é a variavel y
   342                                  	
   343                                  ;Aqui em cima a lógica foi invertida, 1-r => r-1 e as comparações passaram a 
   344                                  ; ser JL => JG, assim garante valores positivos para d
   345                                  
   346                                  stay:								;LOOP
   347 000001BA 89FE                    	MOV		SI,DI
   348 000001BC 81FE0000                	CMP		SI,0
   349 000001C0 7F0E                    	JG		inf       				;caso d for menor que 0, seleciona pixel superior (não  SALta)
   350 000001C2 89D6                    	MOV		SI,DX					;o JL é importante porque trata-se de conta com sinal
   351 000001C4 D1E6                    	SAL		SI,1					;multiplica por dois (shift arithmetic left)
   352 000001C6 81C60300                	ADD		SI,3
   353 000001CA 01F7                    	ADD		DI,SI     				;nesse ponto d = d+2*DX+3
   354 000001CC 42                      	INC		DX						;Incrementa DX
   355 000001CD E90E00                  	JMP		plotar
   356                                  inf:	
   357 000001D0 89D6                    	MOV		SI,DX
   358 000001D2 29CE                    	SUB		SI,CX  					;faz x - y (DX-CX), e SALva em DI 
   359 000001D4 D1E6                    	SAL		SI,1
   360 000001D6 81C60500                	ADD		SI,5
   361 000001DA 01F7                    	ADD		DI,SI					;nesse ponto d = d+2*(DX-CX)+5
   362 000001DC 42                      	INC		DX						;Incrementa x (DX)
   363 000001DD 49                      	DEC		CX						;Decrementa y (CX)
   364                                  	
   365                                  plotar:	
   366 000001DE 89D6                    	MOV		SI,DX
   367 000001E0 01C6                    	ADD		SI,AX
   368 000001E2 56                      	PUSH    SI						;coloca a abcisa x+xc na pilha
   369 000001E3 89CE                    	MOV		SI,CX
   370 000001E5 01DE                    	ADD		SI,BX
   371 000001E7 56                      	PUSH    SI						;coloca a ordenada y+yc na pilha
   372 000001E8 E868FF                  	CALL plot_xy					;toma conta do segundo octante
   373 000001EB 89C6                    	MOV		SI,AX
   374 000001ED 01D6                    	ADD		SI,DX
   375 000001EF 56                      	PUSH    SI						;coloca a abcisa xc+x na pilha
   376 000001F0 89DE                    	MOV		SI,BX
   377 000001F2 29CE                    	SUB		SI,CX
   378 000001F4 56                      	PUSH    SI						;coloca a ordenada yc-y na pilha
   379 000001F5 E85BFF                  	CALL plot_xy					;toma conta do s�timo octante
   380 000001F8 89C6                    	MOV		SI,AX
   381 000001FA 01CE                    	ADD		SI,CX
   382 000001FC 56                      	PUSH    SI						;coloca a abcisa xc+y na pilha
   383 000001FD 89DE                    	MOV		SI,BX
   384 000001FF 01D6                    	ADD		SI,DX
   385 00000201 56                      	PUSH    SI						;coloca a ordenada yc+x na pilha
   386 00000202 E84EFF                  	CALL plot_xy					;toma conta do segundo octante
   387 00000205 89C6                    	MOV		SI,AX
   388 00000207 01CE                    	ADD		SI,CX
   389 00000209 56                      	PUSH    SI						;coloca a abcisa xc+y na pilha
   390 0000020A 89DE                    	MOV		SI,BX
   391 0000020C 29D6                    	SUB		SI,DX
   392 0000020E 56                      	PUSH    SI						;coloca a ordenada yc-x na pilha
   393 0000020F E841FF                  	CALL plot_xy					;toma conta do oitavo octante
   394 00000212 89C6                    	MOV		SI,AX
   395 00000214 29D6                    	SUB		SI,DX
   396 00000216 56                      	PUSH    SI						;coloca a abcisa xc-x na pilha
   397 00000217 89DE                    	MOV		SI,BX
   398 00000219 01CE                    	ADD		SI,CX
   399 0000021B 56                      	PUSH    SI						;coloca a ordenada yc+y na pilha
   400 0000021C E834FF                  	CALL plot_xy					;toma conta do terceiro octante
   401 0000021F 89C6                    	MOV		SI,AX
   402 00000221 29D6                    	SUB		SI,DX
   403 00000223 56                      	PUSH    SI						;coloca a abcisa xc-x na pilha
   404 00000224 89DE                    	MOV		SI,BX
   405 00000226 29CE                    	SUB		SI,CX
   406 00000228 56                      	PUSH    SI						;coloca a ordenada yc-y na pilha
   407 00000229 E827FF                  	CALL plot_xy					;toma conta do sexto octante
   408 0000022C 89C6                    	MOV		SI,AX
   409 0000022E 29CE                    	SUB		SI,CX
   410 00000230 56                      	PUSH    SI						;coloca a abcisa xc-y na pilha
   411 00000231 89DE                    	MOV		SI,BX
   412 00000233 29D6                    	SUB		SI,DX
   413 00000235 56                      	PUSH    SI						;coloca a ordenada yc-x na pilha
   414 00000236 E81AFF                  	CALL plot_xy					;toma conta do quINTo octante
   415 00000239 89C6                    	MOV		SI,AX
   416 0000023B 29CE                    	SUB		SI,CX
   417 0000023D 56                      	PUSH    SI						;coloca a abcisa xc-y na pilha
   418 0000023E 89DE                    	MOV		SI,BX
   419 00000240 01D6                    	ADD		SI,DX
   420 00000242 56                      	PUSH    SI						;coloca a ordenada yc-x na pilha
   421 00000243 E80DFF                  	CALL plot_xy					;toma conta do quarto octante
   422                                  	
   423 00000246 39D1                    	CMP		CX,DX
   424 00000248 7203                    	JB		fim_circle  			;se CX (y) está abaixo de DX (x), termina     
   425 0000024A E96DFF                  	JMP		stay					;se CX (y) está acima de DX (x), continua no LOOP
   426                                  	
   427                                  fim_circle:
   428 0000024D 5F                      	POP		DI
   429 0000024E 5E                      	POP		SI
   430 0000024F 5A                      	POP		DX
   431 00000250 59                      	POP		CX
   432 00000251 5B                      	POP		BX
   433 00000252 58                      	POP		AX
   434 00000253 9D                      	POPf
   435 00000254 5D                      	POP		BP
   436 00000255 C20600                  	RET		6
   437                                  ;-----------------------------------------------------------------------------
   438                                  ;função full_circle
   439                                  ; Parametros:
   440                                  ;	PUSH xc; PUSH yc; PUSH r; CALL full_circle;  (xc+r<639,yc+r<479)e(xc-r>0,yc-r>0)
   441                                  ; 	cor definida na variavel cor					  
