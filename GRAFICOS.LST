    17                                  segment code public class=CODE
    18                                  
    19                                  ; desenha_jogador 
    20                                  ; Entrada:
    21                                  ;   AL = cor
    22                                  ;   AH = indice do frame dentro da animacao do estado
    23                                  ;   BH = estado da animacao 
    24                                  ;   BL = espelho: 0 = direita, 1 = esquerda
    25                                  ;   CX = X base 
    26                                  ;   DX = Y base
    27                                  desenha_jogador:
    28 00000000 9C                              PUSHF
    29 00000001 50                              PUSH    AX
    30 00000002 53                              PUSH    BX
    31 00000003 51                              PUSH    CX
    32 00000004 52                              PUSH    DX
    33 00000005 56                              PUSH    SI
    34 00000006 57                              PUSH    DI
    35                                  
    36 00000007 A2[0000]                        MOV     [cor], AL
    37 0000000A 881E[1500]                      MOV     [espelho], BL
    38 0000000E 890E[0500]                      MOV     [base_x], CX
    39 00000012 8916[0700]                      MOV     [base_y], DX
    40                                          
    41 00000016 50                              PUSH    AX
    42 00000017 53                              PUSH    BX
    43                                  
    44                                          ; 1. Encontra a animacao correta
    45 00000018 88F8                            MOV     AL, BH
    46 0000001A 30E4                            XOR     AH, AH
    47 0000001C D1E0                            SHL     AX, 1
    48 0000001E 89C6                            MOV     SI, AX
    49 00000020 8B9C[1600]                      MOV     BX, [tabela_animacoes + SI]
    50                                  
    51                                          ; 2. Calcula offset do Frame
    52 00000024 5A                              POP     DX
    53 00000025 58                              POP     AX
    54                                          
    55 00000026 50                              PUSH    AX
    56 00000027 88E0                            MOV     AL, AH
    57 00000029 30E4                            XOR     AH, AH
    58 0000002B 89C7                            MOV     DI, AX
    59 0000002D D1E7                            SHL     DI, 1                  
    60 0000002F D1E7                            SHL     DI, 1                   
    61 00000031 D1E7                            SHL     DI, 1                
    62 00000033 89F9                            MOV     CX, DI
    63 00000035 D1E7                            SHL     DI, 1
    64 00000037 D1E7                            SHL     DI, 1                   
    65 00000039 01CF                            ADD     DI, CX                
    66 0000003B 01DF                            ADD     DI, BX                  
    67 0000003D 58                              POP     AX
    68                                  
    69                                          ; 3. Le o par 0: ombro
    70 0000003E E87500                          CALL    le_ponto_ombro
    71 00000041 A3[0900]                        MOV     [ombro_x], AX
    72 00000044 891E[0B00]                      MOV     [ombro_y], BX
    73                                  
    74                                          ; 4. Le o par 1: quadril
    75 00000048 E88600                          CALL    le_ponto_quadril
    76 0000004B A3[0D00]                        MOV     [quadril_x], AX
    77 0000004E 891E[0F00]                      MOV     [quadril_y], BX
    78                                  
    79                                          ; Cabeca:
    80 00000052 A1[0900]                        MOV     AX, [ombro_x]
    81 00000055 50                              PUSH    AX
    82 00000056 A1[0B00]                        MOV     AX, [ombro_y]
    83 00000059 050A00                          ADD     AX, 10
    84 0000005C 50                              PUSH    AX
    85 0000005D B80A00                          MOV     AX, 10
    86 00000060 50                              PUSH    AX
    87 00000061 E81602                          CALL    full_circle
    88                                  
    89                                          ; Tronco:
    90 00000064 A1[0900]                        MOV     AX, [ombro_x]
    91 00000067 50                              PUSH    AX
    92 00000068 A1[0B00]                        MOV     AX, [ombro_y]
    93 0000006B 50                              PUSH    AX
    94 0000006C A1[0D00]                        MOV     AX, [quadril_x]
    95 0000006F 50                              PUSH    AX
    96 00000070 A1[0F00]                        MOV     AX, [quadril_y]
    97 00000073 50                              PUSH    AX
    98 00000074 E8C002                          CALL    linha_grossa
    99                                  
   100                                          ; 4 Membros
   101 00000077 B90400                          MOV     CX, 4
   102                                  dj_membro:
   103 0000007A 81F90200                        CMP     CX, 2
   104 0000007E 770A                            JA      dj_origem_ombro
   105                                          ; Pernas
   106 00000080 A1[0D00]                        MOV     AX, [quadril_x]
   107 00000083 8B1E[0F00]                      MOV     BX, [quadril_y]
   108 00000087 E90700                          JMP     dj_origem_ok
   109                                  dj_origem_ombro:
   110                                          ; Bracos
   111 0000008A A1[0900]                        MOV     AX, [ombro_x]
   112 0000008D 8B1E[0B00]                      MOV     BX, [ombro_y]
   113                                  dj_origem_ok:
   114 00000091 A3[1100]                        MOV     [membro_base_x], AX
   115 00000094 891E[1300]                      MOV     [membro_base_y], BX
   116                                  
   117 00000098 50                              PUSH    AX                      
   118 00000099 53                              PUSH    BX                     
   119 0000009A E84F00                          CALL    le_ponto_membro         
   120 0000009D 50                              PUSH    AX                     
   121 0000009E 53                              PUSH    BX                     
   122 0000009F E89502                          CALL    linha_grossa
   123                                  
   124 000000A2 50                              PUSH    AX                     
   125 000000A3 53                              PUSH    BX                    
   126 000000A4 E84500                          CALL    le_ponto_membro         
   127 000000A7 50                              PUSH    AX                     
   128 000000A8 53                              PUSH    BX                     
   129 000000A9 E88B02                          CALL    linha_grossa
   130                                  
   131 000000AC E2CC                            LOOP    dj_membro
   132                                  
   133 000000AE 5F                              POP     DI
   134 000000AF 5E                              POP     SI
   135 000000B0 5A                              POP     DX
   136 000000B1 59                              POP     CX
   137 000000B2 5B                              POP     BX
   138 000000B3 58                              POP     AX
   139 000000B4 9D                              POPF
   140 000000B5 C3                              RET
   141                                  
   142                                  ; Auxiliares de desenha_jogador:
   143                                  le_ponto_ombro:
   144 000000B6 8B05                            MOV     AX, [DI]
   145 000000B8 803E[1500]00                    CMP     byte [espelho], 0
   146 000000BD 7402                            JE      lpo_sem
   147 000000BF F7D8                            NEG     AX
   148                                  lpo_sem:
   149 000000C1 0306[0500]                      ADD     AX, [base_x]
   150 000000C5 8B5D02                          MOV     BX, [DI+2]
   151 000000C8 031E[0700]                      ADD     BX, [base_y]
   152 000000CC 81C70400                        ADD     DI, 4
   153 000000D0 C3                              RET
   154                                  
   155                                  le_ponto_quadril:
   156 000000D1 8B05                            MOV     AX, [DI]
   157 000000D3 803E[1500]00                    CMP     byte [espelho], 0
   158 000000D8 7402                            JE      lpq_sem
   159 000000DA F7D8                            NEG     AX
   160                                  lpq_sem:
   161 000000DC 0306[0900]                      ADD     AX, [ombro_x]
   162 000000E0 8B5D02                          MOV     BX, [DI+2]
   163 000000E3 031E[0B00]                      ADD     BX, [ombro_y]
   164 000000E7 81C70400                        ADD     DI, 4
   165 000000EB C3                              RET
   166                                  
   167                                  le_ponto_membro:
   168 000000EC 8B05                            MOV     AX, [DI]
   169 000000EE 803E[1500]00                    CMP     byte [espelho], 0
   170 000000F3 7402                            JE      lpm_sem
   171 000000F5 F7D8                            NEG     AX
   172                                  lpm_sem:
   173 000000F7 0306[1100]                      ADD     AX, [membro_base_x]
   174 000000FB 8B5D02                          MOV     BX, [DI+2]
   175 000000FE 031E[1300]                      ADD     BX, [membro_base_y]
   176 00000102 81C70400                        ADD     DI, 4
   177 00000106 C3                              RET
