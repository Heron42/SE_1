   297                                  ;funcao plot_xy
   298                                  ; Parametros:
   299                                  ;	PUSH x; PUSH y; CALL plot_xy;  (x<639, y<479)
   300                                  ; 	cor definida na variavel cor
   301                                  plot_xy:
   302 00000175 55                      		PUSH	BP
   303 00000176 89E5                    		MOV		BP,SP
   304 00000178 9C                      		PUSHf
   305 00000179 50                      		PUSH 	AX
   306 0000017A 53                      		PUSH 	BX
   307 0000017B 51                      		PUSH	CX
   308 0000017C 52                      		PUSH	DX
   309 0000017D 56                      		PUSH	SI
   310 0000017E 57                      		PUSH	DI
   311 0000017F B40C                    	    MOV     AH,0Ch
   312 00000181 A0[0000]                	    MOV     AL,[cor]
   313 00000184 B700                    	    MOV     BH,0
   314 00000186 BADF01                  	    MOV     DX,479
   315 00000189 2B5604                  		SUB		DX,[BP+4]
   316 0000018C 8B4E06                  	    MOV     CX,[BP+6]
   317 0000018F CD10                    	    INT     10h
   318 00000191 5F                      		POP		DI
   319 00000192 5E                      		POP		SI
   320 00000193 5A                      		POP		DX
   321 00000194 59                      		POP		CX
   322 00000195 5B                      		POP		BX
   323 00000196 58                      		POP		AX
   324 00000197 9D                      		POPf
   325 00000198 5D                      		POP		BP
   326 00000199 C20400                  		RET		4
   327                                  ;-----------------------------------------------------------------------------
   328                                  ;funcao circle
   329                                  ; Parametros:
   330                                  ;	PUSH xc; PUSH yc; PUSH r; CALL circle;  (xc+r<639,yc+r<479)e(xc-r>0,yc-r>0)
   331                                  ; 	cor definida na variavel cor
   332                                  circle:
   333 0000019C 55                      	PUSH 	BP
   334 0000019D 89E5                    	MOV	 	BP,SP
   335 0000019F 9C                      	PUSHf                        	;coloca os flags na pilha
   336 000001A0 50                      	PUSH 	AX
   337 000001A1 53                      	PUSH 	BX
   338 000001A2 51                      	PUSH	CX
   339 000001A3 52                      	PUSH	DX
   340 000001A4 56                      	PUSH	SI
   341 000001A5 57                      	PUSH	DI
   342                                  	
   343 000001A6 8B4608                  	MOV		AX,[BP+8]    			;resgata xc
   344 000001A9 8B5E06                  	MOV		BX,[BP+6]    			;resgata yc
   345 000001AC 8B4E04                  	MOV		CX,[BP+4]    			;resgata r
   346                                  	
   347 000001AF 89DA                    	MOV 	DX,BX	
   348 000001B1 01CA                    	ADD		DX,CX       			;ponto extremo superior
   349 000001B3 50                      	PUSH    AX			
   350 000001B4 52                      	PUSH	DX
   351 000001B5 E8BDFF                  	CALL plot_xy
   352                                  	
   353 000001B8 89DA                    	MOV		DX,BX
   354 000001BA 29CA                    	SUB		DX,CX       			;ponto extremo inferior
   355 000001BC 50                      	PUSH    AX			
   356 000001BD 52                      	PUSH	DX
   357 000001BE E8B4FF                  	CALL plot_xy
   358                                  	
   359 000001C1 89C2                    	MOV 	DX,AX	
   360 000001C3 01CA                    	ADD		DX,CX       			;ponto extremo DIreita
   361 000001C5 52                      	PUSH    DX			
   362 000001C6 53                      	PUSH	BX
   363 000001C7 E8ABFF                  	CALL plot_xy
   364                                  	
   365 000001CA 89C2                    	MOV		DX,AX
   366 000001CC 29CA                    	SUB		DX,CX       			;ponto extremo esquerda
   367 000001CE 52                      	PUSH    DX			
   368 000001CF 53                      	PUSH	BX
   369 000001D0 E8A2FF                  	CALL plot_xy
   370                                  		
   371 000001D3 89CF                    	MOV		DI,CX
   372 000001D5 81EF0100                	SUB		DI,1	 				;DI = r-1
   373 000001D9 BA0000                  	MOV		DX,0  					;DX sera a variavel x. CX e a variavel y
   374                                  	
   375                                  ;Aqui em cima a logica foi invertida, 1-r => r-1 e as comparacoes passaram a 
   376                                  ; ser JL => JG, assim garante valores positivos para d
   377                                  
   378                                  stay:								;LOOP
   379 000001DC 89FE                    	MOV		SI,DI
   380 000001DE 81FE0000                	CMP		SI,0
   381 000001E2 7F0E                    	JG		inf       				;caso d for menor que 0, seleciona pixel superior (nao  SALta)
   382 000001E4 89D6                    	MOV		SI,DX					;o JL e importante porque trata-se de conta com sinal
   383 000001E6 D1E6                    	SAL		SI,1					;multiplica por dois (shift arithmetic left)
   384 000001E8 81C60300                	ADD		SI,3
   385 000001EC 01F7                    	ADD		DI,SI     				;nesse ponto d = d+2*DX+3
   386 000001EE 42                      	INC		DX						;Incrementa DX
   387 000001EF E90E00                  	JMP		plotar
   388                                  inf:	
   389 000001F2 89D6                    	MOV		SI,DX
   390 000001F4 29CE                    	SUB		SI,CX  					;faz x - y (DX-CX), e SALva em DI 
   391 000001F6 D1E6                    	SAL		SI,1
   392 000001F8 81C60500                	ADD		SI,5
   393 000001FC 01F7                    	ADD		DI,SI					;nesse ponto d = d+2*(DX-CX)+5
   394 000001FE 42                      	INC		DX						;Incrementa x (DX)
   395 000001FF 49                      	DEC		CX						;Decrementa y (CX)
   396                                  	
   397                                  plotar:	
   398 00000200 89D6                    	MOV		SI,DX
   399 00000202 01C6                    	ADD		SI,AX
   400 00000204 56                      	PUSH    SI						;coloca a abcisa x+xc na pilha
   401 00000205 89CE                    	MOV		SI,CX
   402 00000207 01DE                    	ADD		SI,BX
   403 00000209 56                      	PUSH    SI						;coloca a ordenada y+yc na pilha
   404 0000020A E868FF                  	CALL plot_xy					;toma conta do segundo octante
   405 0000020D 89C6                    	MOV		SI,AX
   406 0000020F 01D6                    	ADD		SI,DX
   407 00000211 56                      	PUSH    SI						;coloca a abcisa xc+x na pilha
   408 00000212 89DE                    	MOV		SI,BX
   409 00000214 29CE                    	SUB		SI,CX
   410 00000216 56                      	PUSH    SI						;coloca a ordenada yc-y na pilha
   411 00000217 E85BFF                  	CALL plot_xy					;toma conta do setimo octante
   412 0000021A 89C6                    	MOV		SI,AX
   413 0000021C 01CE                    	ADD		SI,CX
   414 0000021E 56                      	PUSH    SI						;coloca a abcisa xc+y na pilha
   415 0000021F 89DE                    	MOV		SI,BX
   416 00000221 01D6                    	ADD		SI,DX
   417 00000223 56                      	PUSH    SI						;coloca a ordenada yc+x na pilha
   418 00000224 E84EFF                  	CALL plot_xy					;toma conta do segundo octante
   419 00000227 89C6                    	MOV		SI,AX
   420 00000229 01CE                    	ADD		SI,CX
   421 0000022B 56                      	PUSH    SI						;coloca a abcisa xc+y na pilha
   422 0000022C 89DE                    	MOV		SI,BX
   423 0000022E 29D6                    	SUB		SI,DX
   424 00000230 56                      	PUSH    SI						;coloca a ordenada yc-x na pilha
   425 00000231 E841FF                  	CALL plot_xy					;toma conta do oitavo octante
   426 00000234 89C6                    	MOV		SI,AX
   427 00000236 29D6                    	SUB		SI,DX
   428 00000238 56                      	PUSH    SI						;coloca a abcisa xc-x na pilha
   429 00000239 89DE                    	MOV		SI,BX
   430 0000023B 01CE                    	ADD		SI,CX
   431 0000023D 56                      	PUSH    SI						;coloca a ordenada yc+y na pilha
   432 0000023E E834FF                  	CALL plot_xy					;toma conta do terceiro octante
   433 00000241 89C6                    	MOV		SI,AX
   434 00000243 29D6                    	SUB		SI,DX
   435 00000245 56                      	PUSH    SI						;coloca a abcisa xc-x na pilha
   436 00000246 89DE                    	MOV		SI,BX
   437 00000248 29CE                    	SUB		SI,CX
   438 0000024A 56                      	PUSH    SI						;coloca a ordenada yc-y na pilha
   439 0000024B E827FF                  	CALL plot_xy					;toma conta do sexto octante
   440 0000024E 89C6                    	MOV		SI,AX
   441 00000250 29CE                    	SUB		SI,CX
   442 00000252 56                      	PUSH    SI						;coloca a abcisa xc-y na pilha
   443 00000253 89DE                    	MOV		SI,BX
   444 00000255 29D6                    	SUB		SI,DX
   445 00000257 56                      	PUSH    SI						;coloca a ordenada yc-x na pilha
   446 00000258 E81AFF                  	CALL plot_xy					;toma conta do quINTo octante
   447 0000025B 89C6                    	MOV		SI,AX
   448 0000025D 29CE                    	SUB		SI,CX
   449 0000025F 56                      	PUSH    SI						;coloca a abcisa xc-y na pilha
   450 00000260 89DE                    	MOV		SI,BX
   451 00000262 01D6                    	ADD		SI,DX
   452 00000264 56                      	PUSH    SI						;coloca a ordenada yc-x na pilha
   453 00000265 E80DFF                  	CALL plot_xy					;toma conta do quarto octante
   454                                  	
   455 00000268 39D1                    	CMP		CX,DX
   456 0000026A 7203                    	JB		fim_circle  			;se CX (y) esta abaixo de DX (x), termina     
   457 0000026C E96DFF                  	JMP		stay					;se CX (y) esta acima de DX (x), continua no LOOP
   458                                  	
   459                                  fim_circle:
   460 0000026F 5F                      	POP		DI
   461 00000270 5E                      	POP		SI
   462 00000271 5A                      	POP		DX
   463 00000272 59                      	POP		CX
   464 00000273 5B                      	POP		BX
   465 00000274 58                      	POP		AX
   466 00000275 9D                      	POPf
   467 00000276 5D                      	POP		BP
   468 00000277 C20600                  	RET		6
