   491                                  ;função linha
   492                                  ; Parâmetros:
   493                                  ;	PUSH x1; PUSH y1; PUSH x2; PUSH y2; CALL line;  (x<639, y<479)
   494                                  ; Função linha_grossa
   495                                  ; Parâmetros:
   496                                  ;   PUSH x1; PUSH y1; PUSH x2; PUSH y2; CALL linha_grossa;
   497                                  linha_grossa:
   498 00000291 55                              PUSH    BP
   499 00000292 89E5                            MOV     BP,SP
   500 00000294 50                              PUSH    AX
   501 00000295 53                              PUSH    BX
   502 00000296 51                              PUSH    CX
   503 00000297 52                              PUSH    DX
   504                                  
   505                                          ; Resgata as coordenadas originais passadas para linha_grossa
   506 00000298 8B460A                          MOV     AX,[BP+10]      ; AX = x1
   507 0000029B 8B5E08                          MOV     BX,[BP+8]       ; BX = y1
   508 0000029E 8B4E06                          MOV     CX,[BP+6]       ; CX = x2
   509 000002A1 8B5604                          MOV     DX,[BP+4]       ; DX = y2
   510                                  
   511                                          ; ----------------------------------------------------
   512                                          ; 1º Traço: A linha central (coordenadas originais)
   513                                          ; ----------------------------------------------------
   514 000002A4 50                              PUSH    AX              ; x1
   515 000002A5 53                              PUSH    BX              ; y1
   516 000002A6 51                              PUSH    CX              ; x2
   517 000002A7 52                              PUSH    DX              ; y2
   518 000002A8 E81F00                          CALL    line            ; A função line consome esses 4 PUSHes
   519                                  
   520                                          ; ----------------------------------------------------
   521                                          ; 2º Traço: Linha deslocada 1 pixel para a direita (+1 no X)
   522                                          ; ----------------------------------------------------
   523 000002AB 40                              INC     AX              ; x1 + 1
   524 000002AC 41                              INC     CX              ; x2 + 1
   525                                          
   526 000002AD 50                              PUSH    AX              ; x1 + 1
   527 000002AE 53                              PUSH    BX              ; y1 (mantido)
   528 000002AF 51                              PUSH    CX              ; x2 + 1
   529 000002B0 52                              PUSH    DX              ; y2 (mantido)
   530 000002B1 E81600                          CALL    line            ; Consome os PUSHes
   531                                  
   532                                          ; ----------------------------------------------------
   533                                          ; 3º Traço: Linha deslocada 1 pixel para a esquerda (-1 do original)
   534                                          ; ----------------------------------------------------
   535 000002B4 2D0200                          SUB     AX, 2           ; (x1 + 1) - 2 = x1 - 1
   536 000002B7 81E90200                        SUB     CX, 2           ; (x2 + 1) - 2 = x2 - 1
   537                                          
   538 000002BB 50                              PUSH    AX              ; x1 - 1
   539 000002BC 53                              PUSH    BX              ; y1 (mantido)
   540 000002BD 51                              PUSH    CX              ; x2 - 1
   541 000002BE 52                              PUSH    DX              ; y2 (mantido)
   542 000002BF E80800                          CALL    line            ; Consome os PUSHes
   543                                  
   544                                          ; Restaura os registradores originais da função chamadora
   545 000002C2 5A                              POP     DX
   546 000002C3 59                              POP     CX
   547 000002C4 5B                              POP     BX
   548 000002C5 58                              POP     AX
   549 000002C6 5D                              POP     BP
   550 000002C7 C20800                          RET     8               ; Limpa os 8 bytes empilhados ao chamar linha_grossa
