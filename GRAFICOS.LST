     1                                  ; =============================================================================
     2                                  ; graficos.asm  -  Rotinas graficas do Jogo de Luta (modo 12h, 640x480x16)
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; desenha_jogador : desenha um lutador completo (generica para P1 e P2)
     5                                  ; cursor, caracter, plot_xy, circle, full_circle, line, linha_grossa
     6                                  ; escreve_texto, apaga_texto, limpa_tela
     7                                  ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
     8                                  ; A variavel publica "cor" define a cor usada por todas as primitivas.
     9                                  ; =============================================================================
    10                                  
    11                                  global  desenha_jogador
    12                                  global  cursor
    13                                  global  caracter
    14                                  global  plot_xy
    15                                  global  circle
    16                                  global  full_circle
    17                                  global  line
    18                                  global  linha_grossa
    19                                  global  escreve_texto
    20                                  global  apaga_texto
    21                                  global  limpa_tela
    22                                  global  cor
    23                                  
    24                                  segment code public class=CODE
    25                                  
    26                                  ;-----------------------------------------------------------------------------
    27                                  ; desenha_jogador  (esqueleto dinamico, 40 bytes por frame)
    28                                  ; Entrada:
    29                                  ;   AL = cor (use preto para APAGAR)
    30                                  ;   AH = indice do frame dentro da animacao do estado
    31                                  ;   BH = estado da animacao (0 = parado, 1 = andando, 2 = soco,
    32                                  ;        3 = chute/rasteira, 4 = abaixado); escolhe a tabela em
    33                                  ;        tabela_animacoes
    34                                  ;   BL = espelho: 0 = olha para a direita, 1 = olha para a esquerda
    35                                  ;        (com espelho, os offsets X do frame tem o sinal invertido)
    36                                  ;   CX = X base (centro do tronco)
    37                                  ;   DX = Y base (altura dos ombros)
    38                                  ; Preserva todos os registradores e flags.
    39                                  ;
    40                                  ; Formato de um frame: 10 pares (X,Y) de words = 40 bytes
    41                                  ;   par 0     : ombro, relativo a base (CX, DX)
    42                                  ;   par 1     : quadril, relativo ao ombro
    43                                  ;   pares 2-3 : braco esquerdo  (cotovelo, mao), relativos ao ombro
    44                                  ;   pares 4-5 : braco direito   (cotovelo, mao), relativos ao ombro
    45                                  ;   pares 6-7 : perna esquerda  (joelho, pe),    relativos ao quadril
    46                                  ;   pares 8-9 : perna direita   (joelho, pe),    relativos ao quadril
    47                                  ; A cabeca e um circulo cheio de raio 10, com centro 10 px acima do ombro.
    48                                  ;-----------------------------------------------------------------------------
    49                                  desenha_jogador:
    50 00000000 9C                              PUSHF
    51 00000001 50                              PUSH    AX
    52 00000002 53                              PUSH    BX
    53 00000003 51                              PUSH    CX
    54 00000004 52                              PUSH    DX
    55 00000005 56                              PUSH    SI
    56 00000006 57                              PUSH    DI
    57                                  
    58 00000007 A2[0000]                        MOV     [cor], AL
    59 0000000A 881E[1500]                      MOV     [espelho], BL
    60 0000000E 890E[0500]                      MOV     [base_x], CX
    61 00000012 8916[0700]                      MOV     [base_y], DX
    62                                          
    63 00000016 50                              PUSH    AX
    64 00000017 53                              PUSH    BX
    65                                  
    66                                          ; 1. Encontra a animacao correta
    67 00000018 88F8                            MOV     AL, BH
    68 0000001A 30E4                            XOR     AH, AH
    69 0000001C D1E0                            SHL     AX, 1
    70 0000001E 89C6                            MOV     SI, AX
    71 00000020 8B9C[1600]                      MOV     BX, [tabela_animacoes + SI]
    72                                  
    73                                          ; 2. Calcula offset do Frame (AH * 40 bytes = AH*8 + AH*32)
    74 00000024 5A                              POP     DX
    75 00000025 58                              POP     AX
    76                                          
    77 00000026 50                              PUSH    AX
    78 00000027 88E0                            MOV     AL, AH
    79 00000029 30E4                            XOR     AH, AH
    80 0000002B 89C7                            MOV     DI, AX
    81 0000002D D1E7                            SHL     DI, 1                   ; (deslocamentos de 1 bit:
    82 0000002F D1E7                            SHL     DI, 1                   ;  SHL reg,imm > 1 nao existe no 8086)
    83 00000031 D1E7                            SHL     DI, 1                   ; DI = frame * 8
    84 00000033 89F9                            MOV     CX, DI
    85 00000035 D1E7                            SHL     DI, 1
    86 00000037 D1E7                            SHL     DI, 1                   ; DI = frame * 32
    87 00000039 01CF                            ADD     DI, CX                  ; DI = frame * 40
    88 0000003B 01DF                            ADD     DI, BX                  ; DI aponta para o frame correto
    89 0000003D 58                              POP     AX
    90                                  
    91                                          ; 3. Le o par 0: ombro (relativo a base JX, JY)
    92 0000003E E87500                          CALL    le_ponto_ombro
    93 00000041 A3[0900]                        MOV     [ombro_x], AX
    94 00000044 891E[0B00]                      MOV     [ombro_y], BX
    95                                  
    96                                          ; 4. Le o par 1: quadril (relativo ao ombro)
    97 00000048 E88600                          CALL    le_ponto_quadril
    98 0000004B A3[0D00]                        MOV     [quadril_x], AX
    99 0000004E 891E[0F00]                      MOV     [quadril_y], BX
   100                                  
   101                                          ; ---- Cabeca: Raio 10, centro 10px acima do Ombro ----
   102 00000052 A1[0900]                        MOV     AX, [ombro_x]
   103 00000055 50                              PUSH    AX
   104 00000056 A1[0B00]                        MOV     AX, [ombro_y]
   105 00000059 050A00                          ADD     AX, 10
   106 0000005C 50                              PUSH    AX
   107 0000005D B80A00                          MOV     AX, 10
   108 00000060 50                              PUSH    AX
   109 00000061 E81602                          CALL    full_circle
   110                                  
   111                                          ; ---- Tronco: Linha do Ombro ao Quadril ----
   112 00000064 A1[0900]                        MOV     AX, [ombro_x]
   113 00000067 50                              PUSH    AX
   114 00000068 A1[0B00]                        MOV     AX, [ombro_y]
   115 0000006B 50                              PUSH    AX
   116 0000006C A1[0D00]                        MOV     AX, [quadril_x]
   117 0000006F 50                              PUSH    AX
   118 00000070 A1[0F00]                        MOV     AX, [quadril_y]
   119 00000073 50                              PUSH    AX
   120 00000074 E8C002                          CALL    linha_grossa
   121                                  
   122                                          ; ---- 4 Membros (2 Bracos saem do Ombro, 2 Pernas saem do Quadril) ----
   123 00000077 B90400                          MOV     CX, 4
   124                                  dj_membro:
   125 0000007A 81F90200                        CMP     CX, 2
   126 0000007E 770A                            JA      dj_origem_ombro
   127                                          ; Pernas (CX = 2, 1) saem do Quadril
   128 00000080 A1[0D00]                        MOV     AX, [quadril_x]
   129 00000083 8B1E[0F00]                      MOV     BX, [quadril_y]
   130 00000087 E90700                          JMP     dj_origem_ok
   131                                  dj_origem_ombro:
   132                                          ; Bracos (CX = 4, 3) saem do Ombro
   133 0000008A A1[0900]                        MOV     AX, [ombro_x]
   134 0000008D 8B1E[0B00]                      MOV     BX, [ombro_y]
   135                                  dj_origem_ok:
   136 00000091 A3[1100]                        MOV     [membro_base_x], AX
   137 00000094 891E[1300]                      MOV     [membro_base_y], BX
   138                                  
   139 00000098 50                              PUSH    AX                      ; x1 = origem
   140 00000099 53                              PUSH    BX                      ; y1
   141 0000009A E84F00                          CALL    le_ponto_membro         ; AX,BX = articulacao
   142 0000009D 50                              PUSH    AX                      ; x2
   143 0000009E 53                              PUSH    BX                      ; y2
   144 0000009F E89502                          CALL    linha_grossa
   145                                  
   146 000000A2 50                              PUSH    AX                      ; x1 = articulacao
   147 000000A3 53                              PUSH    BX                      ; y1
   148 000000A4 E84500                          CALL    le_ponto_membro         ; AX,BX = extremidade
   149 000000A7 50                              PUSH    AX                      ; x2
   150 000000A8 53                              PUSH    BX                      ; y2
   151 000000A9 E88B02                          CALL    linha_grossa
   152                                  
   153 000000AC E2CC                            LOOP    dj_membro
   154                                  
   155 000000AE 5F                              POP     DI
   156 000000AF 5E                              POP     SI
   157 000000B0 5A                              POP     DX
   158 000000B1 59                              POP     CX
   159 000000B2 5B                              POP     BX
   160 000000B3 58                              POP     AX
   161 000000B4 9D                              POPF
   162 000000B5 C3                              RET
   163                                  
   164                                  ;-----------------------------------------------------------------------------
   165                                  ; Auxiliares de desenha_jogador: leem um par (offX, offY) em [DI], aplicam o
   166                                  ; espelho (negam X) e somam a origem correspondente.
   167                                  ; Saida: AX = X absoluto, BX = Y absoluto, DI avancado 4 bytes.
   168                                  ;   le_ponto_ombro   : origem = base (base_x, base_y)
   169                                  ;   le_ponto_quadril : origem = ombro
   170                                  ;   le_ponto_membro  : origem = inicio do membro (ombro ou quadril)
   171                                  ;-----------------------------------------------------------------------------
   172                                  le_ponto_ombro:
   173 000000B6 8B05                            MOV     AX, [DI]
   174 000000B8 803E[1500]00                    CMP     byte [espelho], 0
   175 000000BD 7402                            JE      lpo_sem
   176 000000BF F7D8                            NEG     AX
   177                                  lpo_sem:
   178 000000C1 0306[0500]                      ADD     AX, [base_x]
   179 000000C5 8B5D02                          MOV     BX, [DI+2]
   180 000000C8 031E[0700]                      ADD     BX, [base_y]
   181 000000CC 81C70400                        ADD     DI, 4
   182 000000D0 C3                              RET
   183                                  
   184                                  le_ponto_quadril:
   185 000000D1 8B05                            MOV     AX, [DI]
   186 000000D3 803E[1500]00                    CMP     byte [espelho], 0
   187 000000D8 7402                            JE      lpq_sem
   188 000000DA F7D8                            NEG     AX
   189                                  lpq_sem:
   190 000000DC 0306[0900]                      ADD     AX, [ombro_x]
   191 000000E0 8B5D02                          MOV     BX, [DI+2]
   192 000000E3 031E[0B00]                      ADD     BX, [ombro_y]
   193 000000E7 81C70400                        ADD     DI, 4
   194 000000EB C3                              RET
   195                                  
   196                                  le_ponto_membro:
   197 000000EC 8B05                            MOV     AX, [DI]
   198 000000EE 803E[1500]00                    CMP     byte [espelho], 0
   199 000000F3 7402                            JE      lpm_sem
   200 000000F5 F7D8                            NEG     AX
   201                                  lpm_sem:
   202 000000F7 0306[1100]                      ADD     AX, [membro_base_x]
   203 000000FB 8B5D02                          MOV     BX, [DI+2]
   204 000000FE 031E[1300]                      ADD     BX, [membro_base_y]
   205 00000102 81C70400                        ADD     DI, 4
   206 00000106 C3                              RET
   207                                  
   208                                  ;-----------------------------------------------------------------------------
   209                                  ;funcao cursor
   210                                  ; Parametros:
   211                                  ; 	DH = linha (0-29) e  DL = coluna  (0-79)
   212                                  cursor:
   213 00000107 9C                      		PUSHf
   214 00000108 50                      		PUSH 	AX
   215 00000109 53                      		PUSH 	BX
   216 0000010A 51                      		PUSH	CX
   217 0000010B 52                      		PUSH	DX
   218 0000010C 56                      		PUSH	SI
   219 0000010D 57                      		PUSH	DI
   220 0000010E 55                      		PUSH	BP
   221 0000010F B402                    		MOV     AH,2
   222 00000111 B700                    		MOV     BH,0
   223 00000113 CD10                    		INT     10h
   224 00000115 5D                      		POP		BP
   225 00000116 5F                      		POP		DI
   226 00000117 5E                      		POP		SI
   227 00000118 5A                      		POP		DX
   228 00000119 59                      		POP		CX
   229 0000011A 5B                      		POP		BX
   230 0000011B 58                      		POP		AX
   231 0000011C 9D                      		POPf
   232 0000011D C3                      		RET
   233                                  ;-----------------------------------------------------------------------------
   234                                  ;funcao caracter escrito na posicao do cursor
   235                                  ; Parametros:
   236                                  ; 	AL = caracter a ser escrito
   237                                  ; 	cor definida na variavel cor
   238                                  caracter:
   239 0000011E 9C                      		PUSHf
   240 0000011F 50                      		PUSH 	AX
   241 00000120 53                      		PUSH 	BX
   242 00000121 51                      		PUSH	CX
   243 00000122 52                      		PUSH	DX
   244 00000123 56                      		PUSH	SI
   245 00000124 57                      		PUSH	DI
   246 00000125 55                      		PUSH	BP
   247 00000126 B409                        	MOV     AH,9
   248 00000128 B700                        	MOV     BH,0
   249 0000012A B90100                      	MOV     CX,1
   250 0000012D 8A1E[0000]                 		MOV     bl,[cor]
   251 00000131 CD10                        	INT     10h
   252 00000133 5D                      		POP		BP
   253 00000134 5F                      		POP		DI
   254 00000135 5E                      		POP		SI
   255 00000136 5A                      		POP		DX
   256 00000137 59                      		POP		CX
   257 00000138 5B                      		POP		BX
   258 00000139 58                      		POP		AX
   259 0000013A 9D                      		POPf
   260 0000013B C3                      		RET
   261                                  ;-----------------------------------------------------------------------------
   262                                  ; escreve_texto
   263                                  ; Entrada: DS:SI = texto terminado em 0, DH = linha (0-29), DL = coluna (0-79)
   264                                  ;          cor definida na variavel cor
   265                                  ; Preserva todos os registradores.
   266                                  ;-----------------------------------------------------------------------------
   267                                  escreve_texto:
   268 0000013C 9C                              PUSHF
   269 0000013D 50                              PUSH    AX
   270 0000013E 52                              PUSH    DX
   271 0000013F 56                              PUSH    SI
   272 00000140 FC                              CLD
   273                                  et_loop:
   274 00000141 AC                              LODSB
   275 00000142 3C00                            CMP     AL, 0
   276 00000144 740B                            JE      et_fim
   277 00000146 E8BEFF                          CALL    cursor
   278 00000149 E8D2FF                          CALL    caracter
   279 0000014C FEC2                            INC     DL
   280 0000014E E9F0FF                          JMP     et_loop
   281                                  et_fim:
   282 00000151 5E                              POP     SI
   283 00000152 5A                              POP     DX
   284 00000153 58                              POP     AX
   285 00000154 9D                              POPF
   286 00000155 C3                              RET
   287                                  
   288                                  ;-----------------------------------------------------------------------------
   289                                  ; apaga_texto
   290                                  ; Entrada: DH = linha, DL = coluna inicial, CX = numero de caracteres.
   291                                  ; Escreve espacos (a BIOS preenche a celula 8x16 com o fundo preto).
   292                                  ; Preserva todos os registradores.
   293                                  ;-----------------------------------------------------------------------------
   294                                  apaga_texto:
   295 00000156 9C                              PUSHF
   296 00000157 50                              PUSH    AX
   297 00000158 51                              PUSH    CX
   298 00000159 52                              PUSH    DX
   299 0000015A E30C                            JCXZ    at_fim
   300 0000015C B020                            MOV     AL, ' '
   301                                  at_loop:
   302 0000015E E8A6FF                          CALL    cursor
   303 00000161 E8BAFF                          CALL    caracter
   304 00000164 FEC2                            INC     DL
   305 00000166 E2F6                            LOOP    at_loop
   306                                  at_fim:
   307 00000168 5A                              POP     DX
   308 00000169 59                              POP     CX
   309 0000016A 58                              POP     AX
   310 0000016B 9D                              POPF
   311 0000016C C3                              RET
   312                                  
   313                                  ;-----------------------------------------------------------------------------
   314                                  ; limpa_tela
   315                                  ; Reprograma o modo 12h (VGA 640x480, 16 cores), o que tambem apaga a tela.
   316                                  ; Preserva todos os registradores.
   317                                  ;-----------------------------------------------------------------------------
   318                                  limpa_tela:
   319 0000016D 50                              PUSH    AX
   320 0000016E B81200                          MOV     AX, 0012h
   321 00000171 CD10                            INT     10h
   322 00000173 58                              POP     AX
   323 00000174 C3                              RET
   324                                  
   325                                  ;-----------------------------------------------------------------------------
   326                                  ;funcao plot_xy
   327                                  ; Parametros:
   328                                  ;	PUSH x; PUSH y; CALL plot_xy;  (x<639, y<479)
   329                                  ; 	cor definida na variavel cor
   330                                  plot_xy:
   331 00000175 55                      		PUSH	BP
   332 00000176 89E5                    		MOV		BP,SP
   333 00000178 9C                      		PUSHf
   334 00000179 50                      		PUSH 	AX
   335 0000017A 53                      		PUSH 	BX
   336 0000017B 51                      		PUSH	CX
   337 0000017C 52                      		PUSH	DX
   338 0000017D 56                      		PUSH	SI
   339 0000017E 57                      		PUSH	DI
   340 0000017F B40C                    	    MOV     AH,0Ch
   341 00000181 A0[0000]                	    MOV     AL,[cor]
   342 00000184 B700                    	    MOV     BH,0
   343 00000186 BADF01                  	    MOV     DX,479
   344 00000189 2B5604                  		SUB		DX,[BP+4]
   345 0000018C 8B4E06                  	    MOV     CX,[BP+6]
   346 0000018F CD10                    	    INT     10h
   347 00000191 5F                      		POP		DI
   348 00000192 5E                      		POP		SI
   349 00000193 5A                      		POP		DX
   350 00000194 59                      		POP		CX
   351 00000195 5B                      		POP		BX
   352 00000196 58                      		POP		AX
   353 00000197 9D                      		POPf
   354 00000198 5D                      		POP		BP
   355 00000199 C20400                  		RET		4
   356                                  ;-----------------------------------------------------------------------------
   357                                  ;funcao circle
   358                                  ; Parametros:
   359                                  ;	PUSH xc; PUSH yc; PUSH r; CALL circle;  (xc+r<639,yc+r<479)e(xc-r>0,yc-r>0)
   360                                  ; 	cor definida na variavel cor
   361                                  circle:
   362 0000019C 55                      	PUSH 	BP
   363 0000019D 89E5                    	MOV	 	BP,SP
   364 0000019F 9C                      	PUSHf                        	;coloca os flags na pilha
   365 000001A0 50                      	PUSH 	AX
   366 000001A1 53                      	PUSH 	BX
   367 000001A2 51                      	PUSH	CX
   368 000001A3 52                      	PUSH	DX
   369 000001A4 56                      	PUSH	SI
   370 000001A5 57                      	PUSH	DI
   371                                  	
   372 000001A6 8B4608                  	MOV		AX,[BP+8]    			;resgata xc
   373 000001A9 8B5E06                  	MOV		BX,[BP+6]    			;resgata yc
   374 000001AC 8B4E04                  	MOV		CX,[BP+4]    			;resgata r
   375                                  	
   376 000001AF 89DA                    	MOV 	DX,BX	
   377 000001B1 01CA                    	ADD		DX,CX       			;ponto extremo superior
   378 000001B3 50                      	PUSH    AX			
   379 000001B4 52                      	PUSH	DX
   380 000001B5 E8BDFF                  	CALL plot_xy
   381                                  	
   382 000001B8 89DA                    	MOV		DX,BX
   383 000001BA 29CA                    	SUB		DX,CX       			;ponto extremo inferior
   384 000001BC 50                      	PUSH    AX			
   385 000001BD 52                      	PUSH	DX
   386 000001BE E8B4FF                  	CALL plot_xy
   387                                  	
   388 000001C1 89C2                    	MOV 	DX,AX	
   389 000001C3 01CA                    	ADD		DX,CX       			;ponto extremo DIreita
   390 000001C5 52                      	PUSH    DX			
   391 000001C6 53                      	PUSH	BX
   392 000001C7 E8ABFF                  	CALL plot_xy
   393                                  	
   394 000001CA 89C2                    	MOV		DX,AX
   395 000001CC 29CA                    	SUB		DX,CX       			;ponto extremo esquerda
   396 000001CE 52                      	PUSH    DX			
   397 000001CF 53                      	PUSH	BX
   398 000001D0 E8A2FF                  	CALL plot_xy
   399                                  		
   400 000001D3 89CF                    	MOV		DI,CX
   401 000001D5 81EF0100                	SUB		DI,1	 				;DI = r-1
   402 000001D9 BA0000                  	MOV		DX,0  					;DX sera a variavel x. CX e a variavel y
   403                                  	
   404                                  ;Aqui em cima a logica foi invertida, 1-r => r-1 e as comparacoes passaram a 
   405                                  ; ser JL => JG, assim garante valores positivos para d
   406                                  
   407                                  stay:								;LOOP
   408 000001DC 89FE                    	MOV		SI,DI
   409 000001DE 81FE0000                	CMP		SI,0
   410 000001E2 7F0E                    	JG		inf       				;caso d for menor que 0, seleciona pixel superior (nao  SALta)
   411 000001E4 89D6                    	MOV		SI,DX					;o JL e importante porque trata-se de conta com sinal
   412 000001E6 D1E6                    	SAL		SI,1					;multiplica por dois (shift arithmetic left)
   413 000001E8 81C60300                	ADD		SI,3
   414 000001EC 01F7                    	ADD		DI,SI     				;nesse ponto d = d+2*DX+3
   415 000001EE 42                      	INC		DX						;Incrementa DX
   416 000001EF E90E00                  	JMP		plotar
   417                                  inf:	
   418 000001F2 89D6                    	MOV		SI,DX
   419 000001F4 29CE                    	SUB		SI,CX  					;faz x - y (DX-CX), e SALva em DI 
   420 000001F6 D1E6                    	SAL		SI,1
   421 000001F8 81C60500                	ADD		SI,5
   422 000001FC 01F7                    	ADD		DI,SI					;nesse ponto d = d+2*(DX-CX)+5
   423 000001FE 42                      	INC		DX						;Incrementa x (DX)
   424 000001FF 49                      	DEC		CX						;Decrementa y (CX)
   425                                  	
   426                                  plotar:	
   427 00000200 89D6                    	MOV		SI,DX
   428 00000202 01C6                    	ADD		SI,AX
   429 00000204 56                      	PUSH    SI						;coloca a abcisa x+xc na pilha
   430 00000205 89CE                    	MOV		SI,CX
   431 00000207 01DE                    	ADD		SI,BX
   432 00000209 56                      	PUSH    SI						;coloca a ordenada y+yc na pilha
   433 0000020A E868FF                  	CALL plot_xy					;toma conta do segundo octante
   434 0000020D 89C6                    	MOV		SI,AX
   435 0000020F 01D6                    	ADD		SI,DX
   436 00000211 56                      	PUSH    SI						;coloca a abcisa xc+x na pilha
   437 00000212 89DE                    	MOV		SI,BX
   438 00000214 29CE                    	SUB		SI,CX
   439 00000216 56                      	PUSH    SI						;coloca a ordenada yc-y na pilha
   440 00000217 E85BFF                  	CALL plot_xy					;toma conta do setimo octante
   441 0000021A 89C6                    	MOV		SI,AX
   442 0000021C 01CE                    	ADD		SI,CX
   443 0000021E 56                      	PUSH    SI						;coloca a abcisa xc+y na pilha
   444 0000021F 89DE                    	MOV		SI,BX
   445 00000221 01D6                    	ADD		SI,DX
   446 00000223 56                      	PUSH    SI						;coloca a ordenada yc+x na pilha
   447 00000224 E84EFF                  	CALL plot_xy					;toma conta do segundo octante
   448 00000227 89C6                    	MOV		SI,AX
   449 00000229 01CE                    	ADD		SI,CX
   450 0000022B 56                      	PUSH    SI						;coloca a abcisa xc+y na pilha
   451 0000022C 89DE                    	MOV		SI,BX
   452 0000022E 29D6                    	SUB		SI,DX
