   180                                  ;funcao cursor
   181                                  ; Parametros:
   182                                  ; 	DH = linha (0-29) e  DL = coluna  (0-79)
   183                                  cursor:
   184 00000107 9C                      		PUSHf
   185 00000108 50                      		PUSH 	AX
   186 00000109 53                      		PUSH 	BX
   187 0000010A 51                      		PUSH	CX
   188 0000010B 52                      		PUSH	DX
   189 0000010C 56                      		PUSH	SI
   190 0000010D 57                      		PUSH	DI
   191 0000010E 55                      		PUSH	BP
   192 0000010F B402                    		MOV     AH,2
   193 00000111 B700                    		MOV     BH,0
   194 00000113 CD10                    		INT     10h
   195 00000115 5D                      		POP		BP
   196 00000116 5F                      		POP		DI
   197 00000117 5E                      		POP		SI
   198 00000118 5A                      		POP		DX
   199 00000119 59                      		POP		CX
   200 0000011A 5B                      		POP		BX
   201 0000011B 58                      		POP		AX
   202 0000011C 9D                      		POPf
   203 0000011D C3                      		RET
   204                                  ;-----------------------------------------------------------------------------
   205                                  ;funcao caracter escrito na posicao do cursor
   206                                  ; Parametros:
   207                                  ; 	AL = caracter a ser escrito
   208                                  ; 	cor definida na variavel cor
   209                                  caracter:
   210 0000011E 9C                      		PUSHf
   211 0000011F 50                      		PUSH 	AX
   212 00000120 53                      		PUSH 	BX
   213 00000121 51                      		PUSH	CX
   214 00000122 52                      		PUSH	DX
   215 00000123 56                      		PUSH	SI
   216 00000124 57                      		PUSH	DI
   217 00000125 55                      		PUSH	BP
   218 00000126 B409                        	MOV     AH,9
   219 00000128 B700                        	MOV     BH,0
   220 0000012A B90100                      	MOV     CX,1
   221 0000012D 8A1E[0000]                 		MOV     bl,[cor]
   222 00000131 CD10                        	INT     10h
   223 00000133 5D                      		POP		BP
   224 00000134 5F                      		POP		DI
   225 00000135 5E                      		POP		SI
   226 00000136 5A                      		POP		DX
   227 00000137 59                      		POP		CX
   228 00000138 5B                      		POP		BX
   229 00000139 58                      		POP		AX
   230 0000013A 9D                      		POPf
   231 0000013B C3                      		RET
   232                                  ;-----------------------------------------------------------------------------
   233                                  ; escreve_texto
   234                                  ; Entrada: DS:SI = texto terminado em 0, DH = linha (0-29), DL = coluna (0-79)
   235                                  ;          cor definida na variavel cor
   236                                  ; Preserva todos os registradores.
   237                                  ;-----------------------------------------------------------------------------
   238                                  escreve_texto:
   239 0000013C 9C                              PUSHF
   240 0000013D 50                              PUSH    AX
   241 0000013E 52                              PUSH    DX
   242 0000013F 56                              PUSH    SI
   243 00000140 FC                              CLD
   244                                  et_loop:
   245 00000141 AC                              LODSB
   246 00000142 3C00                            CMP     AL, 0
   247 00000144 740B                            JE      et_fim
   248 00000146 E8BEFF                          CALL    cursor
   249 00000149 E8D2FF                          CALL    caracter
   250 0000014C FEC2                            INC     DL
   251 0000014E E9F0FF                          JMP     et_loop
   252                                  et_fim:
   253 00000151 5E                              POP     SI
   254 00000152 5A                              POP     DX
   255 00000153 58                              POP     AX
   256 00000154 9D                              POPF
   257 00000155 C3                              RET
   258                                  
   259                                  ;-----------------------------------------------------------------------------
   260                                  ; apaga_texto
   261                                  ; Entrada: DH = linha, DL = coluna inicial, CX = numero de caracteres.
   262                                  ; Escreve espacos (a BIOS preenche a celula 8x16 com o fundo preto).
   263                                  ; Preserva todos os registradores.
   264                                  ;-----------------------------------------------------------------------------
   265                                  apaga_texto:
   266 00000156 9C                              PUSHF
   267 00000157 50                              PUSH    AX
   268 00000158 51                              PUSH    CX
   269 00000159 52                              PUSH    DX
   270 0000015A E30C                            JCXZ    at_fim
   271 0000015C B020                            MOV     AL, ' '
   272                                  at_loop:
   273 0000015E E8A6FF                          CALL    cursor
   274 00000161 E8BAFF                          CALL    caracter
   275 00000164 FEC2                            INC     DL
   276 00000166 E2F6                            LOOP    at_loop
   277                                  at_fim:
   278 00000168 5A                              POP     DX
   279 00000169 59                              POP     CX
   280 0000016A 58                              POP     AX
   281 0000016B 9D                              POPF
   282 0000016C C3                              RET
   283                                  
   284                                  ;-----------------------------------------------------------------------------
   285                                  ; limpa_tela
   286                                  ; Reprograma o modo 12h (VGA 640x480, 16 cores), o que tambem apaga a tela.
   287                                  ; Preserva todos os registradores.
   288                                  ;-----------------------------------------------------------------------------
   289                                  limpa_tela:
   290 0000016D 50                              PUSH    AX
   291 0000016E B81200                          MOV     AX, 0012h
   292 00000171 CD10                            INT     10h
   293 00000173 58                              POP     AX
   294 00000174 C3                              RET
