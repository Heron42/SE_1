   580                                          ; Resgata as coordenadas originais passadas para linha_grossa
   581 0000031C 8B460A                          MOV     AX,[BP+10]      ; AX = x1
   582 0000031F 8B5E08                          MOV     BX,[BP+8]       ; BX = y1
   583 00000322 8B4E06                          MOV     CX,[BP+6]       ; CX = x2
   584 00000325 8B5604                          MOV     DX,[BP+4]       ; DX = y2
   585                                  
   586                                          ; ----------------------------------------------------
   587                                          ; 1º Traço: A linha central (coordenadas originais)
   588                                          ; ----------------------------------------------------
   589 00000328 50                              PUSH    AX              ; x1
   590 00000329 53                              PUSH    BX              ; y1
   591 0000032A 51                              PUSH    CX              ; x2
   592 0000032B 52                              PUSH    DX              ; y2
   593 0000032C E81F00                          CALL    line            ; A função line consome esses 4 PUSHes
   594                                  
   595                                          ; ----------------------------------------------------
   596                                          ; 2º Traço: Linha deslocada 1 pixel para a direita (+1 no X)
   597                                          ; ----------------------------------------------------
   598 0000032F 40                              INC     AX              ; x1 + 1
   599 00000330 41                              INC     CX              ; x2 + 1
   600                                          
   601 00000331 50                              PUSH    AX              ; x1 + 1
   602 00000332 53                              PUSH    BX              ; y1 (mantido)
   603 00000333 51                              PUSH    CX              ; x2 + 1
   604 00000334 52                              PUSH    DX              ; y2 (mantido)
   605 00000335 E81600                          CALL    line            ; Consome os PUSHes
   606                                  
   607                                          ; ----------------------------------------------------
   608                                          ; 3º Traço: Linha deslocada 1 pixel para a esquerda (-1 do original)
   609                                          ; ----------------------------------------------------
   610 00000338 2D0200                          SUB     AX, 2           ; (x1 + 1) - 2 = x1 - 1
   611 0000033B 81E90200                        SUB     CX, 2           ; (x2 + 1) - 2 = x2 - 1
   612                                          
   613 0000033F 50                              PUSH    AX              ; x1 - 1
   614 00000340 53                              PUSH    BX              ; y1 (mantido)
   615 00000341 51                              PUSH    CX              ; x2 - 1
   616 00000342 52                              PUSH    DX              ; y2 (mantido)
   617 00000343 E80800                          CALL    line            ; Consome os PUSHes
   618                                  
   619                                          ; Restaura os registradores originais da função chamadora
   620 00000346 5A                              POP     DX
   621 00000347 59                              POP     CX
   622 00000348 5B                              POP     BX
   623 00000349 58                              POP     AX
   624 0000034A 5D                              POP     BP
   625 0000034B C20800                          RET     8               ; Limpa os 8 bytes empilhados ao chamar linha_grossa
