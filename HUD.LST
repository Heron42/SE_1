   466                                  ; =============================================================================
   467                                  ; msg_centro
   468                                  ; Entrada: DS:SI = texto terminado em 0, DH = linha, cor em [cor].
   469                                  ; Escreve o texto centralizado horizontalmente (80 colunas).
   470                                  ; =============================================================================
   471                                  msg_centro:
   472 000001AD 50                              PUSH    AX
   473 000001AE 51                              PUSH    CX
   474 000001AF 52                              PUSH    DX
   475 000001B0 56                              PUSH    SI
   476                                  
   477 000001B1 31C9                            XOR     CX, CX                      ; CX = comprimento do texto
   478                                  mc_conta:
   479 000001B3 803C00                          CMP     byte [SI], 0
   480 000001B6 7405                            JE      mc_posiciona
   481 000001B8 41                              INC     CX
   482 000001B9 46                              INC     SI
   483 000001BA E9F6FF                          JMP     mc_conta
   484                                  mc_posiciona:
   485 000001BD 5E                              POP     SI
   486 000001BE 56                              PUSH    SI
   487 000001BF B85000                          MOV     AX, 80
   488 000001C2 29C8                            SUB     AX, CX
   489 000001C4 D1E8                            SHR     AX, 1                       ; coluna = (80 - comprimento) / 2
   490 000001C6 88C2                            MOV     DL, AL
   491 000001C8 E8(0000)                        CALL    escreve_texto
   492                                  
   493 000001CB 5E                              POP     SI
   494 000001CC 5A                              POP     DX
   495 000001CD 59                              POP     CX
   496 000001CE 58                              POP     AX
   497 000001CF C3                              RET
   498                                  
   499                                  ; =============================================================================
   500                                  ; apaga_linha
