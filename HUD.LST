   506 000001D1 52                              PUSH    DX
   507 000001D2 B202                            MOV     DL, 2
   508 000001D4 B94C00                          MOV     CX, 76
   509 000001D7 E8(0000)                        CALL    apaga_texto
   510 000001DA 5A                              POP     DX
   511 000001DB 59                              POP     CX
   512 000001DC C3                              RET
