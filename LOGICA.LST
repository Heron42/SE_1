   451                                  segment data public class=DATA
   452                                  
   453 00000000 00                      rounds_p1       DB      0           ; rounds vencidos pelo Jogador 1
   454 00000001 00                      rounds_p2       DB      0           ; rounds vencidos pelo Jogador 2
   455 00000002 00                      round_acabou    DB      0           ; 1 = o round atual terminou
   456 00000003 00                      vencedor        DB      0           ; 0 = partida em andamento, 1/2 = campeao
   457 00000004 00                      vencedor_round  DB      0           ; quem venceu o ultimo round (1/2)
   458 00000005 00                      motivo_fim      DB      0           ; MOTIVO_KO ou MOTIVO_TEMPO
   459 00000006 00                      ultimo_golpe    DB      0           ; quem acertou o ultimo golpe (0 = ninguem)
   460 00000007 00                      sair_flag       DB      0           ; 1 = usuario confirmou a saida
   461                                  
   462 00000008 504155534500            str_pausado     DB      'PAUSE', 0
   463 0000000E 00                      str_continuar   DB      '', 0
   464 0000000F 536169723F2028592F-     str_sair        DB      'Sair? (Y/N)', 0
   465 00000018 4E2900             
