     1                                  ; =============================================================================
     2                                  ; teclado.asm  -  Tratamento do teclado pela interrupcao de hardware INT 9h
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; Baseado no programa Tecbuf da disciplina. A ISR le o scan code direto da
     5                                  ; porta 60h e mantem DUAS estruturas:
     6                                  ;   teclas[128] : tabela de estado, 1 = tecla pressionada, 0 = solta.
     7                                  ;                 Usada para o movimento continuo dos lutadores (os dois
     8                                  ;                 jogadores podem segurar teclas ao mesmo tempo).
     9                                  ;   buffer[16]  : fila circular de scan codes, usada para comandos pontuais
    10                                  ;                 (P, Q, Y, N, Enter, selecao de cores).
    11                                  ; Nenhuma leitura de tecla usa a INT 21h.
    12                                  ;
    13                                  ; Rotinas publicas:
    14                                  ;   instala_teclado  : salva o vetor original da INT 9h e instala keyINT
    15                                  ;   restaura_teclado : devolve o vetor original
    16                                  ;   le_evento        : retira o proximo codigo MAKE da fila (CF=1 se vazia)
    17                                  ;   espera_evento    : bloqueia (com HLT) ate chegar um codigo MAKE
    18                                  ;   limpa_eventos    : descarta tudo o que estiver na fila
    19                                  ; =============================================================================
    20                                  
    21                                  %include "const.inc"
    22                              <1> ; =============================================================================
    23                              <1> ; const.inc  -  Constantes compartilhadas por todos os modulos do jogo
    24                              <1> ; -----------------------------------------------------------------------------
    25                              <1> ; Contem apenas EQUs (nao gera codigo nem dados). Incluido com
    26                              <1> ;   %include "const.inc"
    27                              <1> ; em cada modulo .asm. Qualquer alteracao aqui exige remontar todos os
    28                              <1> ; modulos (o Makefile ja declara essa dependencia).
    29                              <1> ; =============================================================================
    30                              <1> 
    31                              <1> ; ------------------------------- Hardware -------------------------------------
    32                              <1> KB_DATA         EQU     60h         ; porta de dados do teclado (8042)
    33                              <1> KB_CTL          EQU     61h         ; porta de controle do teclado (8255 PB)
    34                              <1> PICTRL          EQU     20h         ; porta de comando do PIC 8259
    35                              <1> EOI             EQU     20h         ; comando End Of Interrupt
    36                              <1> INT_TEC         EQU     09h         ; interrupcao de hardware do teclado (IRQ1)
    37                              <1> INT_CLK         EQU     08h         ; interrupcao de hardware do 8253 (IRQ0)
    38                              <1> 
    39                              <1> ; ------------------------------- Scan codes (make) ----------------------------
    40                              <1> TEC_ESC         EQU     01h
    41                              <1> TEC_Q           EQU     10h
    42                              <1> TEC_W           EQU     11h
    43                              <1> TEC_R           EQU     13h
    44                              <1> TEC_T           EQU     14h
    45                              <1> TEC_Y           EQU     15h
    46                              <1> TEC_P           EQU     19h
    47                              <1> TEC_ENTER       EQU     1Ch
    48                              <1> TEC_A           EQU     1Eh
    49                              <1> TEC_S           EQU     1Fh
    50                              <1> TEC_D           EQU     20h
    51                              <1> TEC_N           EQU     31h
    52                              <1> TEC_M           EQU     32h
    53                              <1> TEC_CIMA        EQU     48h         ; seta para cima   (chega apos o prefixo E0h)
    54                              <1> TEC_ESQ         EQU     4Bh         ; seta esquerda    (apos E0h)
    55                              <1> TEC_DIR         EQU     4Dh         ; seta direita     (apos E0h)
    56                              <1> TEC_BAIXO       EQU     50h         ; seta para baixo  (apos E0h)
    57                              <1> 
    58                              <1> ; ------------------------------- Cores (paleta padrao VGA) --------------------
    59                              <1>                                     ; I R G B
    60                              <1> preto           EQU     0           ; 0 0 0 0
    61                              <1> azul            EQU     1           ; 0 0 0 1
    62                              <1> verde           EQU     2           ; 0 0 1 0
    63                              <1> cyan            EQU     3           ; 0 0 1 1
    64                              <1> vermelho        EQU     4           ; 0 1 0 0
    65                              <1> magenta         EQU     5           ; 0 1 0 1
    66                              <1> marrom          EQU     6           ; 0 1 1 0
    67                              <1> branco          EQU     7           ; 0 1 1 1
    68                              <1> cinza           EQU     8           ; 1 0 0 0
    69                              <1> azul_claro      EQU     9           ; 1 0 0 1
    70                              <1> verde_claro     EQU     10          ; 1 0 1 0
    71                              <1> cyan_claro      EQU     11          ; 1 0 1 1
    72                              <1> rosa            EQU     12          ; 1 1 0 0
    73                              <1> magenta_claro   EQU     13          ; 1 1 0 1
    74                              <1> amarelo         EQU     14          ; 1 1 1 0
    75                              <1> branco_intenso  EQU     15          ; 1 1 1 1
    76                              <1> 
    77                              <1> ; ------------------------------- Arena e HUD ----------------------------------
    78                              <1> ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
    79                              <1> ARENA_ESQ       EQU     10
    80                              <1> ARENA_DIR       EQU     629
    81                              <1> ARENA_BAIXO     EQU     70          ; chao
    82                              <1> ARENA_TOPO      EQU     420         ; acima disso fica o HUD
    83                              <1> 
    84                              <1> BARRA_Y_BAIXO   EQU     440         ; barras de energia
    85                              <1> BARRA_Y_TOPO    EQU     460
    86                              <1> BARRA_P1_X      EQU     20          ; J1: X = 20..219
    87                              <1> BARRA_P2_X      EQU     420         ; J2: X = 420..619
    88                              <1> LARG_BLOCO      EQU     20          ; 1 ponto de energia = 20 px de barra
    89                              <1> 
    90                              <1> ; Linhas de texto (modo 12h: 30 linhas x 80 colunas, celula 8x16)
    91                              <1> LIN_TEMPO       EQU     1           ; cronometro (centro do HUD)
    92                              <1> COL_TEMPO       EQU     38
    93                              <1> LIN_MSG         EQU     6           ; mensagens no centro da arena (acima do pulo)
    94                              <1> LIN_CONFIRMA    EQU     27          ; confirmacao de saida (abaixo do chao)
    95                              <1> 
    96                              <1> ; ------------------------------- Regras do jogo -------------------------------
    97                              <1> ENERGIA_INICIAL EQU     10          ; golpes validos para perder o round
    98                              <1> ROUNDS_VITORIA  EQU     2           ; melhor de tres
    99                              <1> TEMPO_ROUND     EQU     180         ; 3 minutos, em segundos
   100                              <1> MOTIVO_KO       EQU     1           ; round terminou por falta de energia
   101                              <1> MOTIVO_TEMPO    EQU     2           ; round terminou por tempo esgotado
   102                              <1> 
   103                              <1> ; ------------------------------- Fisica dos lutadores -------------------------
   104                              <1> VELOCIDADE      EQU     4           ; pixels por tique (~73 px/s)
   105                              <1> LIM_ESQ         EQU     40          ; menor X permitido para o centro do boneco
   106                              <1> LIM_DIR         EQU     598         ; maior X permitido (braco vai ate +27)
   107                              <1> DIST_MIN        EQU     50          ; distancia minima entre os dois lutadores
   108                              <1> Y_CHAO          EQU     156         ; Y dos ombros com o lutador no chao
   109                              <1> VEL_PULO        EQU     22          ; velocidade vertical inicial do pulo (px/tique)
   110                              <1> GRAVIDADE       EQU     2           ; reducao de VY a cada tique
   111                              <1> X_INICIAL_J1    EQU     150
   112                              <1> X_INICIAL_J2    EQU     490
   113                              <1> 
   114                              <1> ; ------------------------------- Colisao --------------------------------------
   115                              <1> ALCANCE_SOCO    EQU     68          ; distancia maxima em X para o soco acertar
   116                              <1> ALCANCE_CHUTE   EQU     74          ; distancia maxima em X para o chute acertar
   117                              <1> TOLERANCIA_Y    EQU     25          ; diferenca de altura maxima para o soco
   118                              <1> FRAME_IMPACTO_SOCO  EQU 2           ; frame da animacao em que o soco "pega"
   119                              <1> FRAME_IMPACTO_CHUTE EQU 3           ; frame da animacao em que o chute "pega"
   120                              <1> 
   121                              <1> ; ------------------------------- Estados de animacao --------------------------
   122                              <1> EST_IDLE        EQU     0
   123                              <1> EST_ANDA        EQU     1
   124                              <1> EST_SOCO        EQU     2
   125                              <1> EST_CHUTE       EQU     3
   126                              <1> EST_ABAIXA      EQU     4
   127                              <1> 
   128                              <1> ; ------------------------------- Estrutura de um jogador (20 bytes) -----------
   129                              <1> ; Acesse sempre como [SI+campo] ou [jogadorN+campo].
   130                              <1> JX              EQU     0           ; dw  posicao X atual (centro do tronco)
   131                              <1> JY              EQU     2           ; dw  posicao Y atual (ombros)
   132                              <1> JXANT           EQU     4           ; dw  X onde foi desenhado por ultimo
   133                              <1> JYANT           EQU     6           ; dw  Y onde foi desenhado por ultimo
   134                              <1> JFRAME          EQU     8           ; db  frame atual da animacao
   135                              <1> JFRAMEANT       EQU     9           ; db  frame desenhado por ultimo
   136                              <1> JDIR            EQU     10          ; db  0 = olha p/ direita, 1 = p/ esquerda
   137                              <1> JDIRANT         EQU     11          ; db  direcao desenhada por ultimo
   138                              <1> JCOR            EQU     12          ; db  cor do lutador (escolhida na selecao)
   139                              <1> JENERGIA        EQU     13          ; db  energia (comeca em ENERGIA_INICIAL)
   140                              <1> JESTADO         EQU     14          ; db  estado de animacao (EST_*)
   141                              <1> JESTADOANT      EQU     15          ; db  estado desenhado por ultimo
   142                              <1> JVY             EQU     16          ; dw  velocidade vertical (positiva = sobe)
   143                              <1> JPULO           EQU     18          ; db  1 = no ar, 0 = no chao
   144                              <1>                                     ; byte 19: reserva (alinhamento)
   145                              <1> TAM_JOGADOR     EQU     20
   146                                  
   147                                  global  instala_teclado
   148                                  global  restaura_teclado
   149                                  global  le_evento
   150                                  global  espera_evento
   151                                  global  limpa_eventos
   152                                  global  teclas
   153                                  
   154                                  TAM_BUFFER      EQU     16          ; potencia de 2 (indice mascarado)
   155                                  MASCARA_BUFFER  EQU     TAM_BUFFER - 1
   156                                  
   157                                  segment code public class=CODE
   158                                  
   159                                  ; -----------------------------------------------------------------------------
   160                                  ; instala_teclado: salva o vetor da INT 9h e aponta-o para keyINT.
   161                                  ; -----------------------------------------------------------------------------
   162                                  instala_teclado:
   163 00000000 50                              PUSH    AX
   164 00000001 06                              PUSH    ES
   165 00000002 FA                              CLI                                 ; ninguem interrompe durante a troca
   166 00000003 31C0                            XOR     AX, AX
   167 00000005 8EC0                            MOV     ES, AX                      ; ES = 0000h -> tabela de vetores
   168 00000007 26A12400                        MOV     AX, [ES:INT_TEC*4]          ; IP original
   169 0000000B A3[0200]                        MOV     [offset_tec], AX
   170 0000000E 26A12600                        MOV     AX, [ES:INT_TEC*4+2]        ; CS original
   171 00000012 A3[0000]                        MOV     [cs_tec], AX
   172 00000015 268C0E2600                      MOV     [ES:INT_TEC*4+2], CS        ; instala a nossa ISR
   173 0000001A 26C7062400[7500]                MOV     WORD [ES:INT_TEC*4], keyINT
   174 00000021 FB                              STI
   175 00000022 07                              POP     ES
   176 00000023 58                              POP     AX
   177 00000024 C3                              RET
   178                                  
   179                                  ; -----------------------------------------------------------------------------
   180                                  ; restaura_teclado: devolve o vetor original da INT 9h (retorno seguro ao DOS).
   181                                  ; -----------------------------------------------------------------------------
   182                                  restaura_teclado:
   183 00000025 50                              PUSH    AX
   184 00000026 06                              PUSH    ES
   185 00000027 FA                              CLI
   186 00000028 31C0                            XOR     AX, AX
   187 0000002A 8EC0                            MOV     ES, AX
   188 0000002C A1[0000]                        MOV     AX, [cs_tec]
   189 0000002F 26A32600                        MOV     [ES:INT_TEC*4+2], AX
   190 00000033 A1[0200]                        MOV     AX, [offset_tec]
   191 00000036 26A32400                        MOV     [ES:INT_TEC*4], AX
   192 0000003A FB                              STI
   193 0000003B 07                              POP     ES
   194 0000003C 58                              POP     AX
   195 0000003D C3                              RET
   196                                  
   197                                  ; -----------------------------------------------------------------------------
   198                                  ; le_evento
   199                                  ; Saida: CF = 0 e AL = scan code MAKE da proxima tecla pressionada, ou
   200                                  ;        CF = 1 se a fila nao tiver nenhum codigo MAKE pendente.
   201                                  ; Os codigos BREAK (bit 7 = 1) sao descartados: so interessam ao movimento,
   202                                  ; que e tratado pela tabela de estado.
   203                                  ; -----------------------------------------------------------------------------
   204                                  le_evento:
   205 0000003E 53                              PUSH    BX
   206                                  le_prox:
   207 0000003F 8B1E[1600]                      MOV     BX, [p_t]
   208 00000043 3B1E[1400]                      CMP     BX, [p_i]
   209 00000047 7414                            JE      le_vazio                    ; fila vazia
   210 00000049 43                              INC     BX
   211 0000004A 81E30F00                        AND     BX, MASCARA_BUFFER
   212 0000004E 891E[1600]                      MOV     [p_t], BX
   213 00000052 8A87[0400]                      MOV     AL, [buffer+BX]
   214 00000056 A880                            TEST    AL, 80h
   215 00000058 75E5                            JNZ     le_prox                     ; BREAK: ignora e tenta o proximo
   216 0000005A F8                              CLC
   217 0000005B 5B                              POP     BX
   218 0000005C C3                              RET
   219                                  le_vazio:
   220 0000005D F9                              STC
   221 0000005E 5B                              POP     BX
   222 0000005F C3                              RET
   223                                  
   224                                  ; -----------------------------------------------------------------------------
   225                                  ; espera_evento
   226                                  ; Saida: AL = scan code MAKE. Enquanto a fila estiver vazia o processador
   227                                  ; fica em HLT ate a proxima interrupcao (teclado ou relogio), sem laco de
   228                                  ; atraso por software.
   229                                  ; -----------------------------------------------------------------------------
   230                                  espera_evento:
   231 00000060 E8DBFF                          CALL    le_evento
   232 00000063 7304                            JNC     ee_fim
   233 00000065 F4                              HLT
   234 00000066 E9F7FF                          JMP     espera_evento
   235                                  ee_fim:
   236 00000069 C3                              RET
   237                                  
   238                                  ; -----------------------------------------------------------------------------
   239                                  ; limpa_eventos: descarta os codigos pendentes (usado ao trocar de tela).
   240                                  ; -----------------------------------------------------------------------------
   241                                  limpa_eventos:
   242 0000006A 50                              PUSH    AX
   243 0000006B FA                              CLI
   244 0000006C A1[1400]                        MOV     AX, [p_i]
   245 0000006F A3[1600]                        MOV     [p_t], AX
   246 00000072 FB                              STI
   247 00000073 58                              POP     AX
   248 00000074 C3                              RET
   249                                  
   250                                  ; =============================================================================
   251                                  ; keyINT  -  ISR do teclado (INT 9h)
   252                                  ; As setas chegam como E0h + codigo; o prefixo E0h e ignorado, de modo que
   253                                  ; seta esquerda = 4Bh, seta direita = 4Dh etc.
   254                                  ; =============================================================================
   255                                  keyINT:
   256 00000075 50                              PUSH    AX
   257 00000076 53                              PUSH    BX
   258 00000077 1E                              PUSH    DS
   259 00000078 B8[0000]                        MOV     AX, data                    ; garante DS correto dentro da ISR
   260 0000007B 8ED8                            MOV     DS, AX
   261                                  
   262 0000007D E460                            IN      AL, KB_DATA                 ; le o codigo make/break (porta 60h)
   263 0000007F 3CE0                            CMP     AL, 0E0h                    ; prefixo de tecla estendida
   264 00000081 7432                            JE      ki_ack
   265 00000083 3CE1                            CMP     AL, 0E1h                    ; prefixo da tecla Pause
   266 00000085 742E                            JE      ki_ack
   267                                  
   268                                          ; ---- grava na fila circular (comandos)
   269 00000087 8B1E[1400]                      MOV     BX, [p_i]
   270 0000008B 43                              INC     BX
   271 0000008C 81E30F00                        AND     BX, MASCARA_BUFFER
   272 00000090 3B1E[1600]                      CMP     BX, [p_t]                   ; fila cheia? descarta o codigo
   273 00000094 7408                            JE      ki_estado                   ; (em vez de sobrescrever os antigos)
   274 00000096 891E[1400]                      MOV     [p_i], BX
   275 0000009A 8887[0400]                      MOV     [buffer+BX], AL
   276                                  
   277                                  ki_estado:
   278                                          ; ---- atualiza a tabela de estado (movimento)
   279 0000009E 88C3                            MOV     BL, AL
   280 000000A0 81E37F00                        AND     BX, 007Fh                   ; BX = codigo sem o bit 7 (e BH = 0)
   281 000000A4 A880                            TEST    AL, 80h                     ; bit 7 = 1 -> break (soltou)
   282 000000A6 7508                            JNZ     ki_solta
   283 000000A8 C687[1800]01                    MOV     byte [teclas+BX], 1
   284 000000AD E90500                          JMP     ki_ack
   285                                  ki_solta:
   286 000000B0 C687[1800]00                    MOV     byte [teclas+BX], 0
   287                                  
   288                                  ki_ack:
   289 000000B5 E461                            IN      AL, KB_CTL                  ; reconhece o dado (pulso no bit 7
   290 000000B7 0C80                            OR      AL, 80h                     ;  da porta 61h, como no Tecbuf)
   291 000000B9 E661                            OUT     KB_CTL, AL
   292 000000BB 247F                            AND     AL, 7Fh
   293 000000BD E661                            OUT     KB_CTL, AL
   294 000000BF B020                            MOV     AL, EOI                     ; fim de interrupcao para o PIC
   295 000000C1 E620                            OUT     PICTRL, AL
   296                                  
   297 000000C3 1F                              POP     DS
   298 000000C4 5B                              POP     BX
   299 000000C5 58                              POP     AX
   300 000000C6 CF                              IRET
   301                                  
   302                                  ; =============================================================================
   303                                  segment data public class=DATA
   304                                  
   305 00000000 0000                    cs_tec          DW      0                   ; CS original da INT 9h
   306 00000002 0000                    offset_tec      DW      0                   ; IP original da INT 9h
   307 00000004 00<rept>                buffer          TIMES TAM_BUFFER DB 0       ; fila circular de scan codes
   308 00000014 0000                    p_i             DW      0                   ; indice de escrita (ISR)
   309 00000016 0000                    p_t             DW      0                   ; indice de leitura (programa)
   310 00000018 00<rept>                teclas          TIMES 128 DB 0              ; tabela de estado: 1 = pressionada
