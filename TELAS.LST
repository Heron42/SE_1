     1                                  ; telas.asm - Telas do jogo: selecao de lutadores, avisos de round e Game Over
     2                                  
     3                                  ; Scan codes (make)
     4                                  TEC_ESC         EQU     01h
     5                                  TEC_Q           EQU     10h
     6                                  TEC_W           EQU     11h
     7                                  TEC_Y           EQU     15h
     8                                  TEC_ENTER       EQU     1Ch
     9                                  TEC_S           EQU     1Fh
    10                                  TEC_N           EQU     31h
    11                                  TEC_CIMA        EQU     48h         ; seta para cima  
    12                                  TEC_BAIXO       EQU     50h         ; seta para baixo 
    13                                  
    14                                  ; Cores (paleta padrao VGA)
    15                                  vermelho        EQU     4           ; 0 1 0 0
    16                                  branco          EQU     7           ; 0 1 1 1
    17                                  cinza           EQU     8           ; 1 0 0 0
    18                                  azul_claro      EQU     9           ; 1 0 0 1
    19                                  verde_claro     EQU     10          ; 1 0 1 0
    20                                  amarelo         EQU     14          ; 1 1 1 0
    21                                  branco_intenso  EQU     15          ; 1 1 1 1
    22                                  
    23                                  ; Arena e HUD
    24                                  LIN_MSG         EQU     6      
    25                                  
    26                                  ; Regras do jogo
    27                                  MOTIVO_TEMPO    EQU     2        
    28                                  
    29                                  ; Colisao
    30                                  FRAME_IMPACTO_SOCO  EQU 2           ; frame da animacao em que o soco "pega"
    31                                  
    32                                  ; Estados de animacao
    33                                  EST_IDLE        EQU     0
    34                                  EST_SOCO        EQU     2
    35                                  
    36                                  ; Estrutura de um jogador
    37                                  JCOR            EQU     12          ; db  cor do lutador
    38                                  
    39                                  global  tela_selecao
    40                                  global  anuncia_round
    41                                  global  anuncia_fim_round
    42                                  global  tela_game_over
    43                                  
    44                                  extern  espera_evento               ; teclado.asm
    45                                  extern  limpa_eventos
    46                                  extern  desenha_jogador             ; graficos.asm
    47                                  extern  escreve_texto
    48                                  extern  limpa_tela
    49                                  extern  line
    50                                  extern  cor
    51                                  extern  msg_centro                  ; hud.asm
    52                                  extern  apaga_linha
    53                                  extern  jogador1                    ; jogador.asm
    54                                  extern  jogador2
    55                                  extern  confirma_saida              ; logica.asm
    56                                  extern  aguarda
    57                                  extern  sair_flag
    58                                  extern  rounds_p1
    59                                  extern  rounds_p2
    60                                  extern  vencedor
    61                                  extern  vencedor_round
    62                                  extern  motivo_fim
    63                                  
    64                                  NUM_CORES       EQU     4           ; potencia de 2 (o AND com NUM_CORES-1
    65                                                                      ; faz a lista dar a volta)
    66                                  LIN_TITULO      EQU     2
    67                                  LIN_CABECALHO   EQU     5
    68                                  LIN_LISTA       EQU     7           ; primeira linha da lista de cores
    69                                  COL_MARCA_J1    EQU     5
    70                                  COL_MARCA_J2    EQU     59
    71                                  X_PREVIA_J1     EQU     260
    72                                  X_PREVIA_J2     EQU     380
    73                                  Y_PREVIA        EQU     225         ; ombros do boneco de previa
    74                                  LIN_CTRL        EQU     23
    75                                  
    76                                  TIQUES_ROUND    EQU     27          ; 1,5 s mostrando "ROUND n"
    77                                  TIQUES_LUTEM    EQU     11          ; 0,5 s mostrando "LUTEM!"
    78                                  TIQUES_FIM      EQU     45          ; 2,5 s mostrando o vencedor do round
    79                                  
    80                                  segment code public class=CODE
    81                                  
    82                                  ; tela_selecao
    83                                  ; Saida: sair_flag = 1 se o usuario confirmou a saida pela tecla Q/ESC.
    84                                  ;        Caso contrario, [jogador1+JCOR] e [jogador2+JCOR] recebem as cores
    85                                  ;        escolhidas.
    86                                  tela_selecao:
    87 00000000 50                              PUSH    AX
    88 00000001 53                              PUSH    BX
    89 00000002 52                              PUSH    DX
    90 00000003 56                              PUSH    SI
    91 00000004 57                              PUSH    DI
    92                                  
    93 00000005 E8(0000)                        CALL    limpa_tela
    94 00000008 E8(0000)                        CALL    limpa_eventos
    95                                  
    96                                          ; textos fixos
    97 0000000B C606[0000]0E                    MOV     byte [cor], amarelo
    98 00000010 BE[3600]                        MOV     SI, str_titulo
    99 00000013 B602                            MOV     DH, LIN_TITULO
   100 00000015 E8(0000)                        CALL    msg_centro
   101                                  
   102 00000018 C606[0000]0F                    MOV     byte [cor], branco_intenso
   103 0000001D BE[4B00]                        MOV     SI, str_cab_j1
   104 00000020 B605                            MOV     DH, LIN_CABECALHO
   105 00000022 B204                            MOV     DL, COL_MARCA_J1 - 1
   106 00000024 E8(0000)                        CALL    escreve_texto
   107 00000027 BE[5500]                        MOV     SI, str_cab_j2
   108 0000002A B23A                            MOV     DL, COL_MARCA_J2 - 1
   109 0000002C E8(0000)                        CALL    escreve_texto
   110                                  
   111 0000002F C606[0000]07                    MOV     byte [cor], branco
   112 00000034 BE[5F00]                        MOV     SI, str_ctrl_j1
   113 00000037 B617                            MOV     DH, LIN_CTRL
   114 00000039 E8(0000)                        CALL    msg_centro
   115 0000003C BE[6000]                        MOV     SI, str_ctrl_j2
   116 0000003F B618                            MOV     DH, LIN_CTRL + 1
   117 00000041 E8(0000)                        CALL    msg_centro
   118 00000044 C606[0000]0E                    MOV     byte [cor], amarelo
   119 00000049 BE[6100]                        MOV     SI, str_iniciar
   120 0000004C B619                            MOV     DH, LIN_CTRL + 2
   121 0000004E E8(0000)                        CALL    msg_centro
   122                                  
   123                                          ; chao sob as previas
   124 00000051 C606[0000]08                    MOV     byte [cor], cinza
   125 00000056 B8C800                          MOV     AX, X_PREVIA_J1 - 60
   126 00000059 50                              PUSH    AX
   127 0000005A B88900                          MOV     AX, Y_PREVIA - 88
   128 0000005D 50                              PUSH    AX
   129 0000005E B8B801                          MOV     AX, X_PREVIA_J2 + 60
   130 00000061 50                              PUSH    AX
   131 00000062 B88900                          MOV     AX, Y_PREVIA - 88
   132 00000065 50                              PUSH    AX
   133 00000066 E8(0000)                        CALL    line
   134                                  
   135 00000069 E88E00                          CALL    redesenha_j1
   136 0000006C E8B500                          CALL    redesenha_j2
   137                                  
   138                                          ; laco de selecao
   139                                  ts_espera:
   140 0000006F E8(0000)                        CALL    espera_evento               ; AL = scan code MAKE
   141 00000072 3C11                            CMP     AL, TEC_W
   142 00000074 741B                            JE      ts_j1_sobe
   143 00000076 3C1F                            CMP     AL, TEC_S
   144 00000078 741C                            JE      ts_j1_desce
   145 0000007A 3C48                            CMP     AL, TEC_CIMA
   146 0000007C 7429                            JE      ts_j2_sobe
   147 0000007E 3C50                            CMP     AL, TEC_BAIXO
   148 00000080 742A                            JE      ts_j2_desce
   149 00000082 3C1C                            CMP     AL, TEC_ENTER
   150 00000084 7446                            JE      ts_inicia
   151 00000086 3C10                            CMP     AL, TEC_Q
   152 00000088 7433                            JE      ts_sair
   153 0000008A 3C01                            CMP     AL, TEC_ESC
   154 0000008C 742F                            JE      ts_sair
   155 0000008E E9DEFF                          JMP     ts_espera
   156                                  
   157                                  ts_j1_sobe:
   158 00000091 B0FF                            MOV     AL, -1
   159 00000093 E90200                          JMP     ts_muda_j1
   160                                  ts_j1_desce:
   161 00000096 B001                            MOV     AL, 1
   162                                  ts_muda_j1:
   163 00000098 BE[0000]                        MOV     SI, idx_j1
   164 0000009B BF[0100]                        MOV     DI, idx_j2
   165 0000009E E84900                          CALL    muda_cor
   166 000000A1 E85600                          CALL    redesenha_j1
   167 000000A4 E9C8FF                          JMP     ts_espera
   168                                  
   169                                  ts_j2_sobe:
   170 000000A7 B0FF                            MOV     AL, -1
   171 000000A9 E90200                          JMP     ts_muda_j2
   172                                  ts_j2_desce:
   173 000000AC B001                            MOV     AL, 1
   174                                  ts_muda_j2:
   175 000000AE BE[0100]                        MOV     SI, idx_j2
   176 000000B1 BF[0000]                        MOV     DI, idx_j1
   177 000000B4 E83300                          CALL    muda_cor
   178 000000B7 E86A00                          CALL    redesenha_j2
   179 000000BA E9B2FF                          JMP     ts_espera
   180                                  
   181                                  ts_sair:
   182 000000BD E8(0000)                        CALL    confirma_saida
   183 000000C0 3C01                            CMP     AL, 1
   184 000000C2 75AB                            JNE     ts_espera
   185 000000C4 C606[0000]01                    MOV     byte [sair_flag], 1
   186 000000C9 E91800                          JMP     ts_fim
   187                                  
   188                                  ts_inicia:
   189 000000CC 8A1E[0000]                      MOV     BL, [idx_j1]                ; grava as cores escolhidas
   190 000000D0 30FF                            XOR     BH, BH
   191 000000D2 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   192 000000D6 A2[0C00]                        MOV     [jogador1+JCOR], AL
   193 000000D9 8A1E[0100]                      MOV     BL, [idx_j2]
   194 000000DD 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   195 000000E1 A2[0C00]                        MOV     [jogador2+JCOR], AL
   196                                  
   197                                  ts_fim:
   198 000000E4 5F                              POP     DI
   199 000000E5 5E                              POP     SI
   200 000000E6 5A                              POP     DX
   201 000000E7 5B                              POP     BX
   202 000000E8 58                              POP     AX
   203 000000E9 C3                              RET
   204                                  
   205                                  ; muda_cor
   206                                  ; Entrada: SI -> indice da cor do jogador, DI -> indice da cor do adversario,
   207                                  ;          AL = +1 (desce na lista) ou -1 (sobe na lista).
   208                                  muda_cor:
   209 000000EA 53                              PUSH    BX
   210 000000EB 8A1C                            MOV     BL, [SI]
   211                                  mc_avanca:
   212 000000ED 00C3                            ADD     BL, AL
   213 000000EF 80E303                          AND     BL, NUM_CORES - 1           ; volta ao inicio/fim da lista
   214 000000F2 3A1D                            CMP     BL, [DI]
   215 000000F4 74F7                            JE      mc_avanca                   ; cor do adversario: pula
   216 000000F6 881C                            MOV     [SI], BL
   217 000000F8 5B                              POP     BX
   218 000000F9 C3                              RET
   219                                  
   220                                  ; redesenha_j1 / redesenha_j2: lista de cores com marcador + boneco de previa.
   221                                  redesenha_j1:
   222 000000FA 50                              PUSH    AX
   223 000000FB 53                              PUSH    BX
   224 000000FC 51                              PUSH    CX
   225 000000FD 52                              PUSH    DX
   226 000000FE A0[0000]                        MOV     AL, [idx_j1]
   227 00000101 B205                            MOV     DL, COL_MARCA_J1
   228 00000103 E84800                          CALL    desenha_lista
   229 00000106 8A1E[0000]                      MOV     BL, [idx_j1]
   230 0000010A 30FF                            XOR     BH, BH
   231 0000010C 8A87[0200]                      MOV     AL, [tabela_cores+BX]       ; cor
   232 00000110 B400                            MOV     AH, 0                       ; frame 0
   233 00000112 B300                            MOV     BL, 0                       ; olhando para a direita
   234 00000114 B700                            MOV     BH, EST_IDLE
   235 00000116 B90401                          MOV     CX, X_PREVIA_J1
   236 00000119 BAE100                          MOV     DX, Y_PREVIA
   237 0000011C E8(0000)                        CALL    desenha_jogador
   238 0000011F 5A                              POP     DX
   239 00000120 59                              POP     CX
   240 00000121 5B                              POP     BX
   241 00000122 58                              POP     AX
   242 00000123 C3                              RET
   243                                  
   244                                  redesenha_j2:
   245 00000124 50                              PUSH    AX
   246 00000125 53                              PUSH    BX
   247 00000126 51                              PUSH    CX
   248 00000127 52                              PUSH    DX
   249 00000128 A0[0100]                        MOV     AL, [idx_j2]
   250 0000012B B23B                            MOV     DL, COL_MARCA_J2
   251 0000012D E81E00                          CALL    desenha_lista
   252 00000130 8A1E[0100]                      MOV     BL, [idx_j2]
   253 00000134 30FF                            XOR     BH, BH
   254 00000136 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   255 0000013A B400                            MOV     AH, 0
   256 0000013C B301                            MOV     BL, 1                       ; olhando para a esquerda
   257 0000013E B700                            MOV     BH, EST_IDLE
   258 00000140 B97C01                          MOV     CX, X_PREVIA_J2
   259 00000143 BAE100                          MOV     DX, Y_PREVIA
   260 00000146 E8(0000)                        CALL    desenha_jogador
   261 00000149 5A                              POP     DX
   262 0000014A 59                              POP     CX
   263 0000014B 5B                              POP     BX
   264 0000014C 58                              POP     AX
   265 0000014D C3                              RET
   266                                  
   267                                  ; desenha_lista
   268                                  ; Entrada: AL = indice selecionado, DL = coluna do marcador.
   269                                  desenha_lista:
   270 0000014E 50                              PUSH    AX
   271 0000014F 53                              PUSH    BX
   272 00000150 51                              PUSH    CX
   273 00000151 52                              PUSH    DX
   274 00000152 56                              PUSH    SI
   275                                  
   276 00000153 88C4                            MOV     AH, AL                      ; AH = indice selecionado
   277 00000155 B607                            MOV     DH, LIN_LISTA
   278 00000157 31C9                            XOR     CX, CX                      ; CX = indice da opcao
   279                                  dl_loop:
   280                                          ; marcador
   281 00000159 C606[0000]0F                    MOV     byte [cor], branco_intenso
   282 0000015E BE[3400]                        MOV     SI, str_marca_off
   283 00000161 38E1                            CMP     CL, AH
   284 00000163 7503                            JNE     dl_marca
   285 00000165 BE[3200]                        MOV     SI, str_marca_on
   286                                  dl_marca:
   287 00000168 E8(0000)                        CALL    escreve_texto
   288                                  
   289                                          ; nome da cor, escrito na propria cor
   290 0000016B 89CB                            MOV     BX, CX
   291 0000016D 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   292 00000171 A2[0000]                        MOV     [cor], AL
   293 00000174 D1E3                            SHL     BX, 1
   294 00000176 8BB7[0600]                      MOV     SI, [tabela_nomes+BX]
   295 0000017A 52                              PUSH    DX
   296 0000017B 80C202                          ADD     DL, 2
   297 0000017E E8(0000)                        CALL    escreve_texto
   298 00000181 5A                              POP     DX
   299                                  
   300 00000182 FEC6                            INC     DH
   301 00000184 41                              INC     CX
   302 00000185 81F90400                        CMP     CX, NUM_CORES
   303 00000189 72CE                            JB      dl_loop
   304                                  
   305 0000018B 5E                              POP     SI
   306 0000018C 5A                              POP     DX
   307 0000018D 59                              POP     CX
   308 0000018E 5B                              POP     BX
   309 0000018F 58                              POP     AX
   310 00000190 C3                              RET
   311                                  
   312                                  ; anuncia_round
   313                                  anuncia_round:
   314 00000191 50                              PUSH    AX
   315 00000192 51                              PUSH    CX
   316 00000193 52                              PUSH    DX
   317 00000194 56                              PUSH    SI
   318                                  
   319 00000195 A0[0000]                        MOV     AL, [rounds_p1]
   320 00000198 0206[0000]                      ADD     AL, [rounds_p2]
   321 0000019C 0431                            ADD     AL, '1'                     ; numero do round atual
   322 0000019E A2[6800]                        MOV     [str_round+6], AL
   323                                  
   324 000001A1 C606[0000]0E                    MOV     byte [cor], amarelo
   325 000001A6 BE[6200]                        MOV     SI, str_round
   326 000001A9 B606                            MOV     DH, LIN_MSG
   327 000001AB E8(0000)                        CALL    msg_centro
   328 000001AE B91B00                          MOV     CX, TIQUES_ROUND
   329 000001B1 E8(0000)                        CALL    aguarda
   330 000001B4 803E[0000]00                    CMP     byte [sair_flag], 0
   331 000001B9 7514                            JNE     ar_fim
   332                                  
   333 000001BB E8(0000)                        CALL    apaga_linha                 ; DH = LIN_MSG
   334 000001BE C606[0000]0E                    MOV     byte [cor], amarelo
   335 000001C3 BE[6A00]                        MOV     SI, str_lutem
   336 000001C6 E8(0000)                        CALL    msg_centro
   337 000001C9 B90B00                          MOV     CX, TIQUES_LUTEM
   338 000001CC E8(0000)                        CALL    aguarda
   339                                  ar_fim:
   340 000001CF E8(0000)                        CALL    apaga_linha
   341 000001D2 5E                              POP     SI
   342 000001D3 5A                              POP     DX
   343 000001D4 59                              POP     CX
   344 000001D5 58                              POP     AX
   345 000001D6 C3                              RET
   346                                  
   347                                  ; anuncia_fim_round
   348                                  anuncia_fim_round:
   349 000001D7 50                              PUSH    AX
   350 000001D8 53                              PUSH    BX
   351 000001D9 51                              PUSH    CX
   352 000001DA 52                              PUSH    DX
   353 000001DB 56                              PUSH    SI
   354                                  
   355 000001DC C606[0000]0E                    MOV     byte [cor], amarelo
   356 000001E1 BE[7100]                        MOV     SI, str_nocaute
   357 000001E4 803E[0000]02                    CMP     byte [motivo_fim], MOTIVO_TEMPO
   358 000001E9 7503                            JNE     afr_motivo
   359 000001EB BE[7400]                        MOV     SI, str_tempo
   360                                  afr_motivo:
   361 000001EE B606                            MOV     DH, LIN_MSG
   362 000001F0 E8(0000)                        CALL    msg_centro
   363                                  
   364 000001F3 A0[0000]                        MOV     AL, [vencedor_round]
   365 000001F6 E81900                          CALL    cor_do_jogador              ; [cor] = cor do vencedor
   366 000001F9 0430                            ADD     AL, '0'
   367 000001FB A2[8C00]                        MOV     [str_vence_round+8], AL
   368 000001FE BE[8400]                        MOV     SI, str_vence_round
   369 00000201 B607                            MOV     DH, LIN_MSG + 1
   370 00000203 E8(0000)                        CALL    msg_centro
   371                                  
   372 00000206 B92D00                          MOV     CX, TIQUES_FIM
   373 00000209 E8(0000)                        CALL    aguarda
   374                                  
   375 0000020C 5E                              POP     SI
   376 0000020D 5A                              POP     DX
   377 0000020E 59                              POP     CX
   378 0000020F 5B                              POP     BX
   379 00000210 58                              POP     AX
   380 00000211 C3                              RET
   381                                  
   382                                  ; cor_do_jogador
   383                                  ; Entrada: AL = 1 ou 2. Saida: [cor] = cor escolhida por esse jogador.
   384                                  cor_do_jogador:
   385 00000212 53                              PUSH    BX
   386 00000213 8A1E[0C00]                      MOV     BL, [jogador1+JCOR]
   387 00000217 3C01                            CMP     AL, 1
   388 00000219 7404                            JE      cdj_grava
   389 0000021B 8A1E[0C00]                      MOV     BL, [jogador2+JCOR]
   390                                  cdj_grava:
   391 0000021F 881E[0000]                      MOV     [cor], BL
   392 00000223 5B                              POP     BX
   393 00000224 C3                              RET
   394                                  
   395                                  ; tela_game_over
   396                                  ; Saida: AL = 1 -> Y (nova partida), AL = 0 -> N ou saida confirmada (Q).
   397                                  tela_game_over:
   398 00000225 53                              PUSH    BX
   399 00000226 51                              PUSH    CX
   400 00000227 52                              PUSH    DX
   401 00000228 56                              PUSH    SI
   402                                  
   403 00000229 E8(0000)                        CALL    limpa_tela
   404 0000022C E8(0000)                        CALL    limpa_eventos
   405                                  
   406 0000022F C606[0000]0E                    MOV     byte [cor], amarelo
   407 00000234 BE[9D00]                        MOV     SI, str_game_over
   408 00000237 B604                            MOV     DH, 4
   409 00000239 E8(0000)                        CALL    msg_centro
   410                                  
   411 0000023C A0[0000]                        MOV     AL, [vencedor]
   412 0000023F E8D0FF                          CALL    cor_do_jogador
   413 00000242 0430                            ADD     AL, '0'
   414 00000244 A2[AF00]                        MOV     [str_campeao+8], AL
   415 00000247 BE[A700]                        MOV     SI, str_campeao
   416 0000024A B607                            MOV     DH, 7
   417 0000024C E8(0000)                        CALL    msg_centro
   418                                  
   419 0000024F A0[0000]                        MOV     AL, [rounds_p1]             ; "Placar final: J1 x - y J2"
   420 00000252 0430                            ADD     AL, '0'
   421 00000254 A2[D400]                        MOV     [str_placar+17], AL
   422 00000257 A0[0000]                        MOV     AL, [rounds_p2]
   423 0000025A 0430                            ADD     AL, '0'
   424 0000025C A2[D800]                        MOV     [str_placar+21], AL
   425 0000025F C606[0000]0F                    MOV     byte [cor], branco_intenso
   426 00000264 BE[C300]                        MOV     SI, str_placar
   427 00000267 B609                            MOV     DH, 9
   428 00000269 E8(0000)                        CALL    msg_centro
   429                                  
   430 0000026C BE[0000]                        MOV     SI, jogador1
   431 0000026F 803E[0000]01                    CMP     byte [vencedor], 1
   432 00000274 7403                            JE      go_boneco
   433 00000276 BE[0000]                        MOV     SI, jogador2
   434                                  go_boneco:
   435 00000279 8A440C                          MOV     AL, [SI+JCOR]
   436 0000027C B402                            MOV     AH, FRAME_IMPACTO_SOCO
   437 0000027E B300                            MOV     BL, 0
   438 00000280 B702                            MOV     BH, EST_SOCO
   439 00000282 B94001                          MOV     CX, 320
   440 00000285 BAE100                          MOV     DX, Y_PREVIA
   441 00000288 E8(0000)                        CALL    desenha_jogador
   442                                  
   443 0000028B C606[0000]0E                    MOV     byte [cor], amarelo
   444 00000290 BE[DD00]                        MOV     SI, str_nova
   445 00000293 B618                            MOV     DH, 24
   446 00000295 E8(0000)                        CALL    msg_centro
   447                                  
   448                                  go_espera:
   449 00000298 E8(0000)                        CALL    espera_evento
   450 0000029B 3C15                            CMP     AL, TEC_Y
   451 0000029D 7418                            JE      go_sim
   452 0000029F 3C31                            CMP     AL, TEC_N
   453 000002A1 740F                            JE      go_nao
   454 000002A3 3C10                            CMP     AL, TEC_Q
   455 000002A5 7404                            JE      go_sair
   456 000002A7 3C01                            CMP     AL, TEC_ESC
   457 000002A9 75ED                            JNE     go_espera
   458                                  go_sair:
   459 000002AB E8(0000)                        CALL    confirma_saida
   460 000002AE 3C01                            CMP     AL, 1
   461 000002B0 75E6                            JNE     go_espera
