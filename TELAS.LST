     1                                  ; =============================================================================
     2                                  ; telas.asm  -  Telas do jogo: selecao de lutadores, avisos de round e Game Over
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; tela_selecao      : cada jogador escolhe a cor do seu lutador
     5                                  ;                     (J1: W/S, J2: setas cima/baixo, ENTER inicia a luta).
     6                                  ;                     Os dois nao podem ficar com a mesma cor: a cor ja
     7                                  ;                     escolhida pelo adversario e pulada automaticamente.
     8                                  ; anuncia_round     : "ROUND n" / "LUTEM!" antes de cada round
     9                                  ; anuncia_fim_round : motivo do fim (nocaute ou tempo) e vencedor do round
    10                                  ; tela_game_over    : "GAME OVER", vencedor, placar e menu Y/N
    11                                  ;
    12                                  ; Em todas as telas, Q/ESC pede confirmacao de saida (Y/N).
    13                                  ; =============================================================================
    14                                  
    15                                  %include "const.inc"
    16                              <1> ; =============================================================================
    17                              <1> ; const.inc  -  Constantes compartilhadas por todos os modulos do jogo
    18                              <1> ; -----------------------------------------------------------------------------
    19                              <1> ; Contem apenas EQUs (nao gera codigo nem dados). Incluido com
    20                              <1> ;   %include "const.inc"
    21                              <1> ; em cada modulo .asm. Qualquer alteracao aqui exige remontar todos os
    22                              <1> ; modulos (o Makefile ja declara essa dependencia).
    23                              <1> ; =============================================================================
    24                              <1> 
    25                              <1> ; ------------------------------- Hardware -------------------------------------
    26                              <1> KB_DATA         EQU     60h         ; porta de dados do teclado (8042)
    27                              <1> KB_CTL          EQU     61h         ; porta de controle do teclado (8255 PB)
    28                              <1> PICTRL          EQU     20h         ; porta de comando do PIC 8259
    29                              <1> EOI             EQU     20h         ; comando End Of Interrupt
    30                              <1> INT_TEC         EQU     09h         ; interrupcao de hardware do teclado (IRQ1)
    31                              <1> INT_CLK         EQU     08h         ; interrupcao de hardware do 8253 (IRQ0)
    32                              <1> 
    33                              <1> ; ------------------------------- Scan codes (make) ----------------------------
    34                              <1> TEC_ESC         EQU     01h
    35                              <1> TEC_Q           EQU     10h
    36                              <1> TEC_W           EQU     11h
    37                              <1> TEC_R           EQU     13h
    38                              <1> TEC_T           EQU     14h
    39                              <1> TEC_Y           EQU     15h
    40                              <1> TEC_P           EQU     19h
    41                              <1> TEC_ENTER       EQU     1Ch
    42                              <1> TEC_A           EQU     1Eh
    43                              <1> TEC_S           EQU     1Fh
    44                              <1> TEC_D           EQU     20h
    45                              <1> TEC_N           EQU     31h
    46                              <1> TEC_M           EQU     32h
    47                              <1> TEC_CIMA        EQU     48h         ; seta para cima   (chega apos o prefixo E0h)
    48                              <1> TEC_ESQ         EQU     4Bh         ; seta esquerda    (apos E0h)
    49                              <1> TEC_DIR         EQU     4Dh         ; seta direita     (apos E0h)
    50                              <1> TEC_BAIXO       EQU     50h         ; seta para baixo  (apos E0h)
    51                              <1> 
    52                              <1> ; ------------------------------- Cores (paleta padrao VGA) --------------------
    53                              <1>                                     ; I R G B
    54                              <1> preto           EQU     0           ; 0 0 0 0
    55                              <1> azul            EQU     1           ; 0 0 0 1
    56                              <1> verde           EQU     2           ; 0 0 1 0
    57                              <1> cyan            EQU     3           ; 0 0 1 1
    58                              <1> vermelho        EQU     4           ; 0 1 0 0
    59                              <1> magenta         EQU     5           ; 0 1 0 1
    60                              <1> marrom          EQU     6           ; 0 1 1 0
    61                              <1> branco          EQU     7           ; 0 1 1 1
    62                              <1> cinza           EQU     8           ; 1 0 0 0
    63                              <1> azul_claro      EQU     9           ; 1 0 0 1
    64                              <1> verde_claro     EQU     10          ; 1 0 1 0
    65                              <1> cyan_claro      EQU     11          ; 1 0 1 1
    66                              <1> rosa            EQU     12          ; 1 1 0 0
    67                              <1> magenta_claro   EQU     13          ; 1 1 0 1
    68                              <1> amarelo         EQU     14          ; 1 1 1 0
    69                              <1> branco_intenso  EQU     15          ; 1 1 1 1
    70                              <1> 
    71                              <1> ; ------------------------------- Arena e HUD ----------------------------------
    72                              <1> ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
    73                              <1> ARENA_ESQ       EQU     10
    74                              <1> ARENA_DIR       EQU     629
    75                              <1> ARENA_BAIXO     EQU     70          ; chao
    76                              <1> ARENA_TOPO      EQU     420         ; acima disso fica o HUD
    77                              <1> 
    78                              <1> BARRA_Y_BAIXO   EQU     440         ; barras de energia
    79                              <1> BARRA_Y_TOPO    EQU     460
    80                              <1> BARRA_P1_X      EQU     20          ; J1: X = 20..219
    81                              <1> BARRA_P2_X      EQU     420         ; J2: X = 420..619
    82                              <1> LARG_BLOCO      EQU     20          ; 1 ponto de energia = 20 px de barra
    83                              <1> 
    84                              <1> ; Linhas de texto (modo 12h: 30 linhas x 80 colunas, celula 8x16)
    85                              <1> LIN_TEMPO       EQU     1           ; cronometro (centro do HUD)
    86                              <1> COL_TEMPO       EQU     38
    87                              <1> LIN_MSG         EQU     6           ; mensagens no centro da arena (acima do pulo)
    88                              <1> LIN_CONFIRMA    EQU     27          ; confirmacao de saida (abaixo do chao)
    89                              <1> 
    90                              <1> ; ------------------------------- Regras do jogo -------------------------------
    91                              <1> ENERGIA_INICIAL EQU     10          ; golpes validos para perder o round
    92                              <1> ROUNDS_VITORIA  EQU     2           ; melhor de tres
    93                              <1> TEMPO_ROUND     EQU     180         ; 3 minutos, em segundos
    94                              <1> MOTIVO_KO       EQU     1           ; round terminou por falta de energia
    95                              <1> MOTIVO_TEMPO    EQU     2           ; round terminou por tempo esgotado
    96                              <1> 
    97                              <1> ; ------------------------------- Fisica dos lutadores -------------------------
    98                              <1> VELOCIDADE      EQU     4           ; pixels por tique (~73 px/s)
    99                              <1> LIM_ESQ         EQU     40          ; menor X permitido para o centro do boneco
   100                              <1> LIM_DIR         EQU     598         ; maior X permitido (braco vai ate +27)
   101                              <1> DIST_MIN        EQU     50          ; distancia minima entre os dois lutadores
   102                              <1> Y_CHAO          EQU     156         ; Y dos ombros com o lutador no chao
   103                              <1> VEL_PULO        EQU     22          ; velocidade vertical inicial do pulo (px/tique)
   104                              <1> GRAVIDADE       EQU     2           ; reducao de VY a cada tique
   105                              <1> X_INICIAL_J1    EQU     150
   106                              <1> X_INICIAL_J2    EQU     490
   107                              <1> 
   108                              <1> ; ------------------------------- Colisao --------------------------------------
   109                              <1> ALCANCE_SOCO    EQU     68          ; distancia maxima em X para o soco acertar
   110                              <1> ALCANCE_CHUTE   EQU     74          ; distancia maxima em X para o chute acertar
   111                              <1> TOLERANCIA_Y    EQU     25          ; diferenca de altura maxima para o soco
   112                              <1> FRAME_IMPACTO_SOCO  EQU 2           ; frame da animacao em que o soco "pega"
   113                              <1> FRAME_IMPACTO_CHUTE EQU 3           ; frame da animacao em que o chute "pega"
   114                              <1> 
   115                              <1> ; ------------------------------- Estados de animacao --------------------------
   116                              <1> EST_IDLE        EQU     0
   117                              <1> EST_ANDA        EQU     1
   118                              <1> EST_SOCO        EQU     2
   119                              <1> EST_CHUTE       EQU     3
   120                              <1> EST_ABAIXA      EQU     4
   121                              <1> 
   122                              <1> ; ------------------------------- Estrutura de um jogador (20 bytes) -----------
   123                              <1> ; Acesse sempre como [SI+campo] ou [jogadorN+campo].
   124                              <1> JX              EQU     0           ; dw  posicao X atual (centro do tronco)
   125                              <1> JY              EQU     2           ; dw  posicao Y atual (ombros)
   126                              <1> JXANT           EQU     4           ; dw  X onde foi desenhado por ultimo
   127                              <1> JYANT           EQU     6           ; dw  Y onde foi desenhado por ultimo
   128                              <1> JFRAME          EQU     8           ; db  frame atual da animacao
   129                              <1> JFRAMEANT       EQU     9           ; db  frame desenhado por ultimo
   130                              <1> JDIR            EQU     10          ; db  0 = olha p/ direita, 1 = p/ esquerda
   131                              <1> JDIRANT         EQU     11          ; db  direcao desenhada por ultimo
   132                              <1> JCOR            EQU     12          ; db  cor do lutador (escolhida na selecao)
   133                              <1> JENERGIA        EQU     13          ; db  energia (comeca em ENERGIA_INICIAL)
   134                              <1> JESTADO         EQU     14          ; db  estado de animacao (EST_*)
   135                              <1> JESTADOANT      EQU     15          ; db  estado desenhado por ultimo
   136                              <1> JVY             EQU     16          ; dw  velocidade vertical (positiva = sobe)
   137                              <1> JPULO           EQU     18          ; db  1 = no ar, 0 = no chao
   138                              <1>                                     ; byte 19: reserva (alinhamento)
   139                              <1> TAM_JOGADOR     EQU     20
   140                                  
   141                                  global  tela_selecao
   142                                  global  anuncia_round
   143                                  global  anuncia_fim_round
   144                                  global  tela_game_over
   145                                  
   146                                  extern  espera_evento               ; teclado.asm
   147                                  extern  limpa_eventos
   148                                  extern  desenha_jogador             ; graficos.asm
   149                                  extern  escreve_texto
   150                                  extern  limpa_tela
   151                                  extern  line
   152                                  extern  cor
   153                                  extern  msg_centro                  ; hud.asm
   154                                  extern  apaga_linha
   155                                  extern  jogador1                    ; jogador.asm
   156                                  extern  jogador2
   157                                  extern  confirma_saida              ; logica.asm
   158                                  extern  aguarda
   159                                  extern  sair_flag
   160                                  extern  rounds_p1
   161                                  extern  rounds_p2
   162                                  extern  vencedor
   163                                  extern  vencedor_round
   164                                  extern  motivo_fim
   165                                  
   166                                  NUM_CORES       EQU     8           ; potencia de 2 (indice mascarado)
   167                                  LIN_TITULO      EQU     2
   168                                  LIN_CABECALHO   EQU     5
   169                                  LIN_LISTA       EQU     7           ; primeira linha da lista de cores
   170                                  COL_MARCA_J1    EQU     5
   171                                  COL_MARCA_J2    EQU     59
   172                                  X_PREVIA_J1     EQU     260
   173                                  X_PREVIA_J2     EQU     380
   174                                  Y_PREVIA        EQU     225         ; ombros do boneco de previa
   175                                  LIN_CTRL        EQU     23
   176                                  
   177                                  TIQUES_ROUND    EQU     27          ; ~1,5 s mostrando "ROUND n"
   178                                  TIQUES_LUTEM    EQU     11          ; ~0,6 s mostrando "LUTEM!"
   179                                  TIQUES_FIM      EQU     45          ; ~2,5 s mostrando o vencedor do round
   180                                  
   181                                  segment code public class=CODE
   182                                  
   183                                  ; =============================================================================
   184                                  ; tela_selecao
   185                                  ; Saida: sair_flag = 1 se o usuario confirmou a saida pela tecla Q/ESC.
   186                                  ;        Caso contrario, [jogador1+JCOR] e [jogador2+JCOR] recebem as cores
   187                                  ;        escolhidas.
   188                                  ; =============================================================================
   189                                  tela_selecao:
   190 00000000 50                              PUSH    AX
   191 00000001 53                              PUSH    BX
   192 00000002 52                              PUSH    DX
   193 00000003 56                              PUSH    SI
   194 00000004 57                              PUSH    DI
   195                                  
   196 00000005 E8(0000)                        CALL    limpa_tela
   197 00000008 E8(0000)                        CALL    limpa_eventos
   198                                  
   199                                          ; ---- textos fixos
   200 0000000B C606[0000]0E                    MOV     byte [cor], amarelo
   201 00000010 BE[6600]                        MOV     SI, str_titulo
   202 00000013 B602                            MOV     DH, LIN_TITULO
   203 00000015 E8(0000)                        CALL    msg_centro
   204                                  
   205 00000018 C606[0000]0F                    MOV     byte [cor], branco_intenso
   206 0000001D BE[7B00]                        MOV     SI, str_cab_j1
   207 00000020 B605                            MOV     DH, LIN_CABECALHO
   208 00000022 B204                            MOV     DL, COL_MARCA_J1 - 1
   209 00000024 E8(0000)                        CALL    escreve_texto
   210 00000027 BE[8500]                        MOV     SI, str_cab_j2
   211 0000002A B23A                            MOV     DL, COL_MARCA_J2 - 1
   212 0000002C E8(0000)                        CALL    escreve_texto
   213                                  
   214 0000002F C606[0000]07                    MOV     byte [cor], branco
   215 00000034 BE[8F00]                        MOV     SI, str_ctrl_j1
   216 00000037 B617                            MOV     DH, LIN_CTRL
   217 00000039 E8(0000)                        CALL    msg_centro
   218 0000003C BE[9000]                        MOV     SI, str_ctrl_j2
   219 0000003F B618                            MOV     DH, LIN_CTRL + 1
   220 00000041 E8(0000)                        CALL    msg_centro
   221 00000044 C606[0000]0E                    MOV     byte [cor], amarelo
   222 00000049 BE[9100]                        MOV     SI, str_iniciar
   223 0000004C B619                            MOV     DH, LIN_CTRL + 2
   224 0000004E E8(0000)                        CALL    msg_centro
   225                                  
   226                                          ; ---- "chao" sob as previas
   227 00000051 C606[0000]08                    MOV     byte [cor], cinza
   228 00000056 B8C800                          MOV     AX, X_PREVIA_J1 - 60
   229 00000059 50                              PUSH    AX
   230 0000005A B88900                          MOV     AX, Y_PREVIA - 88
   231 0000005D 50                              PUSH    AX
   232 0000005E B8B801                          MOV     AX, X_PREVIA_J2 + 60
   233 00000061 50                              PUSH    AX
   234 00000062 B88900                          MOV     AX, Y_PREVIA - 88
   235 00000065 50                              PUSH    AX
   236 00000066 E8(0000)                        CALL    line
   237                                  
   238 00000069 E88E00                          CALL    redesenha_j1
   239 0000006C E8B500                          CALL    redesenha_j2
   240                                  
   241                                          ; ---- laco de selecao
   242                                  ts_espera:
   243 0000006F E8(0000)                        CALL    espera_evento               ; AL = scan code MAKE
   244 00000072 3C11                            CMP     AL, TEC_W
   245 00000074 741B                            JE      ts_j1_sobe
   246 00000076 3C1F                            CMP     AL, TEC_S
   247 00000078 741C                            JE      ts_j1_desce
   248 0000007A 3C48                            CMP     AL, TEC_CIMA
   249 0000007C 7429                            JE      ts_j2_sobe
   250 0000007E 3C50                            CMP     AL, TEC_BAIXO
   251 00000080 742A                            JE      ts_j2_desce
   252 00000082 3C1C                            CMP     AL, TEC_ENTER
   253 00000084 7446                            JE      ts_inicia
   254 00000086 3C10                            CMP     AL, TEC_Q
   255 00000088 7433                            JE      ts_sair
   256 0000008A 3C01                            CMP     AL, TEC_ESC
   257 0000008C 742F                            JE      ts_sair
   258 0000008E E9DEFF                          JMP     ts_espera
   259                                  
   260                                  ts_j1_sobe:
   261 00000091 B0FF                            MOV     AL, -1
   262 00000093 E90200                          JMP     ts_muda_j1
   263                                  ts_j1_desce:
   264 00000096 B001                            MOV     AL, 1
   265                                  ts_muda_j1:
   266 00000098 BE[0000]                        MOV     SI, idx_j1
   267 0000009B BF[0100]                        MOV     DI, idx_j2
   268 0000009E E84900                          CALL    muda_cor
   269 000000A1 E85600                          CALL    redesenha_j1
   270 000000A4 E9C8FF                          JMP     ts_espera
   271                                  
   272                                  ts_j2_sobe:
   273 000000A7 B0FF                            MOV     AL, -1
   274 000000A9 E90200                          JMP     ts_muda_j2
   275                                  ts_j2_desce:
   276 000000AC B001                            MOV     AL, 1
   277                                  ts_muda_j2:
   278 000000AE BE[0100]                        MOV     SI, idx_j2
   279 000000B1 BF[0000]                        MOV     DI, idx_j1
   280 000000B4 E83300                          CALL    muda_cor
   281 000000B7 E86A00                          CALL    redesenha_j2
   282 000000BA E9B2FF                          JMP     ts_espera
   283                                  
   284                                  ts_sair:
   285 000000BD E8(0000)                        CALL    confirma_saida
   286 000000C0 3C01                            CMP     AL, 1
   287 000000C2 75AB                            JNE     ts_espera
   288 000000C4 C606[0000]01                    MOV     byte [sair_flag], 1
   289 000000C9 E91800                          JMP     ts_fim
   290                                  
   291                                  ts_inicia:
   292 000000CC 8A1E[0000]                      MOV     BL, [idx_j1]                ; grava as cores escolhidas
   293 000000D0 30FF                            XOR     BH, BH
   294 000000D2 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   295 000000D6 A2[0C00]                        MOV     [jogador1+JCOR], AL
   296 000000D9 8A1E[0100]                      MOV     BL, [idx_j2]
   297 000000DD 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   298 000000E1 A2[0C00]                        MOV     [jogador2+JCOR], AL
   299                                  
   300                                  ts_fim:
   301 000000E4 5F                              POP     DI
   302 000000E5 5E                              POP     SI
   303 000000E6 5A                              POP     DX
   304 000000E7 5B                              POP     BX
   305 000000E8 58                              POP     AX
   306 000000E9 C3                              RET
   307                                  
   308                                  ; -----------------------------------------------------------------------------
   309                                  ; muda_cor
   310                                  ; Entrada: SI -> indice da cor do jogador, DI -> indice da cor do adversario,
   311                                  ;          AL = +1 (desce na lista) ou -1 (sobe na lista).
   312                                  ; Avanca circularmente e pula a cor ja escolhida pelo adversario.
   313                                  ; -----------------------------------------------------------------------------
   314                                  muda_cor:
   315 000000EA 53                              PUSH    BX
   316 000000EB 8A1C                            MOV     BL, [SI]
   317                                  mc_avanca:
   318 000000ED 00C3                            ADD     BL, AL
   319 000000EF 80E307                          AND     BL, NUM_CORES - 1           ; volta ao inicio/fim da lista
   320 000000F2 3A1D                            CMP     BL, [DI]
   321 000000F4 74F7                            JE      mc_avanca                   ; cor do adversario: pula
   322 000000F6 881C                            MOV     [SI], BL
   323 000000F8 5B                              POP     BX
   324 000000F9 C3                              RET
   325                                  
   326                                  ; -----------------------------------------------------------------------------
   327                                  ; redesenha_j1 / redesenha_j2: lista de cores com marcador + boneco de previa.
   328                                  ; -----------------------------------------------------------------------------
   329                                  redesenha_j1:
   330 000000FA 50                              PUSH    AX
   331 000000FB 53                              PUSH    BX
   332 000000FC 51                              PUSH    CX
   333 000000FD 52                              PUSH    DX
   334 000000FE A0[0000]                        MOV     AL, [idx_j1]
   335 00000101 B205                            MOV     DL, COL_MARCA_J1
   336 00000103 E84800                          CALL    desenha_lista
   337 00000106 8A1E[0000]                      MOV     BL, [idx_j1]
   338 0000010A 30FF                            XOR     BH, BH
   339 0000010C 8A87[0200]                      MOV     AL, [tabela_cores+BX]       ; cor
   340 00000110 B400                            MOV     AH, 0                       ; frame 0
   341 00000112 B300                            MOV     BL, 0                       ; olhando para a direita
   342 00000114 B700                            MOV     BH, EST_IDLE
   343 00000116 B90401                          MOV     CX, X_PREVIA_J1
   344 00000119 BAE100                          MOV     DX, Y_PREVIA
   345 0000011C E8(0000)                        CALL    desenha_jogador
   346 0000011F 5A                              POP     DX
   347 00000120 59                              POP     CX
   348 00000121 5B                              POP     BX
   349 00000122 58                              POP     AX
   350 00000123 C3                              RET
   351                                  
   352                                  redesenha_j2:
   353 00000124 50                              PUSH    AX
   354 00000125 53                              PUSH    BX
   355 00000126 51                              PUSH    CX
   356 00000127 52                              PUSH    DX
   357 00000128 A0[0100]                        MOV     AL, [idx_j2]
   358 0000012B B23B                            MOV     DL, COL_MARCA_J2
   359 0000012D E81E00                          CALL    desenha_lista
   360 00000130 8A1E[0100]                      MOV     BL, [idx_j2]
   361 00000134 30FF                            XOR     BH, BH
   362 00000136 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   363 0000013A B400                            MOV     AH, 0
   364 0000013C B301                            MOV     BL, 1                       ; olhando para a esquerda
   365 0000013E B700                            MOV     BH, EST_IDLE
   366 00000140 B97C01                          MOV     CX, X_PREVIA_J2
   367 00000143 BAE100                          MOV     DX, Y_PREVIA
   368 00000146 E8(0000)                        CALL    desenha_jogador
   369 00000149 5A                              POP     DX
   370 0000014A 59                              POP     CX
   371 0000014B 5B                              POP     BX
   372 0000014C 58                              POP     AX
   373 0000014D C3                              RET
   374                                  
   375                                  ; -----------------------------------------------------------------------------
   376                                  ; desenha_lista
   377                                  ; Entrada: AL = indice selecionado, DL = coluna do marcador.
   378                                  ; Escreve as NUM_CORES opcoes (cada nome na propria cor), com ">" na
   379                                  ; selecionada e " " nas demais.
   380                                  ; -----------------------------------------------------------------------------
   381                                  desenha_lista:
   382 0000014E 50                              PUSH    AX
   383 0000014F 53                              PUSH    BX
   384 00000150 51                              PUSH    CX
   385 00000151 52                              PUSH    DX
   386 00000152 56                              PUSH    SI
   387                                  
   388 00000153 88C4                            MOV     AH, AL                      ; AH = indice selecionado
   389 00000155 B607                            MOV     DH, LIN_LISTA
   390 00000157 31C9                            XOR     CX, CX                      ; CX = indice da opcao
   391                                  dl_loop:
   392                                          ; ---- marcador
   393 00000159 C606[0000]0F                    MOV     byte [cor], branco_intenso
   394 0000015E BE[6400]                        MOV     SI, str_marca_off
   395 00000161 38E1                            CMP     CL, AH
   396 00000163 7503                            JNE     dl_marca
   397 00000165 BE[6200]                        MOV     SI, str_marca_on
   398                                  dl_marca:
   399 00000168 E8(0000)                        CALL    escreve_texto
   400                                  
   401                                          ; ---- nome da cor, escrito na propria cor
   402 0000016B 89CB                            MOV     BX, CX
   403 0000016D 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   404 00000171 A2[0000]                        MOV     [cor], AL
   405 00000174 D1E3                            SHL     BX, 1
   406 00000176 8BB7[0A00]                      MOV     SI, [tabela_nomes+BX]
   407 0000017A 52                              PUSH    DX
   408 0000017B 80C202                          ADD     DL, 2
   409 0000017E E8(0000)                        CALL    escreve_texto
   410 00000181 5A                              POP     DX
   411                                  
