   424                                  ; =============================================================================
   425                                  ; anuncia_round
   426                                  ; Mostra "ROUND n" e "LUTEM!" no centro da arena antes do round comecar
   427                                  ; (com o cronometro ainda parado). Respeita Q/ESC via aguarda.
   428                                  ; =============================================================================
   429                                  anuncia_round:
   430 00000191 50                              PUSH    AX
   431 00000192 51                              PUSH    CX
   432 00000193 52                              PUSH    DX
   433 00000194 56                              PUSH    SI
   434                                  
   435 00000195 A0[0000]                        MOV     AL, [rounds_p1]
   436 00000198 0206[0000]                      ADD     AL, [rounds_p2]
   437 0000019C 0431                            ADD     AL, '1'                     ; numero do round atual
   438 0000019E A2[9800]                        MOV     [str_round+6], AL
   439                                  
   440 000001A1 C606[0000]0E                    MOV     byte [cor], amarelo
   441 000001A6 BE[9200]                        MOV     SI, str_round
   442 000001A9 B606                            MOV     DH, LIN_MSG
   443 000001AB E8(0000)                        CALL    msg_centro
   444 000001AE B91B00                          MOV     CX, TIQUES_ROUND
   445 000001B1 E8(0000)                        CALL    aguarda
   446 000001B4 803E[0000]00                    CMP     byte [sair_flag], 0
   447 000001B9 7514                            JNE     ar_fim
   448                                  
   449 000001BB E8(0000)                        CALL    apaga_linha                 ; DH = LIN_MSG
   450 000001BE C606[0000]0E                    MOV     byte [cor], amarelo
   451 000001C3 BE[9A00]                        MOV     SI, str_lutem
   452 000001C6 E8(0000)                        CALL    msg_centro
   453 000001C9 B90B00                          MOV     CX, TIQUES_LUTEM
   454 000001CC E8(0000)                        CALL    aguarda
   455                                  ar_fim:
   456 000001CF E8(0000)                        CALL    apaga_linha
   457 000001D2 5E                              POP     SI
   458 000001D3 5A                              POP     DX
   459 000001D4 59                              POP     CX
   460 000001D5 58                              POP     AX
   461 000001D6 C3                              RET
   462                                  
   463                                  ; =============================================================================
   464                                  ; anuncia_fim_round
   465                                  ; Mostra o motivo do fim do round e quem venceu, por ~2,5 s.
   466                                  ; =============================================================================
   467                                  anuncia_fim_round:
   468 000001D7 50                              PUSH    AX
   469 000001D8 53                              PUSH    BX
   470 000001D9 51                              PUSH    CX
   471 000001DA 52                              PUSH    DX
   472 000001DB 56                              PUSH    SI
   473                                  
   474 000001DC C606[0000]0E                    MOV     byte [cor], amarelo
   475 000001E1 BE[A100]                        MOV     SI, str_nocaute
   476 000001E4 803E[0000]02                    CMP     byte [motivo_fim], MOTIVO_TEMPO
   477 000001E9 7503                            JNE     afr_motivo
   478 000001EB BE[AA00]                        MOV     SI, str_tempo
   479                                  afr_motivo:
   480 000001EE B606                            MOV     DH, LIN_MSG
   481 000001F0 E8(0000)                        CALL    msg_centro
   482                                  
   483 000001F3 A0[0000]                        MOV     AL, [vencedor_round]
   484 000001F6 E81900                          CALL    cor_do_jogador              ; [cor] = cor do vencedor
   485 000001F9 0430                            ADD     AL, '0'
   486 000001FB A2[C200]                        MOV     [str_vence_round+8], AL
   487 000001FE BE[BA00]                        MOV     SI, str_vence_round
   488 00000201 B607                            MOV     DH, LIN_MSG + 1
   489 00000203 E8(0000)                        CALL    msg_centro
   490                                  
   491 00000206 B92D00                          MOV     CX, TIQUES_FIM
   492 00000209 E8(0000)                        CALL    aguarda
   493                                  
   494 0000020C 5E                              POP     SI
   495 0000020D 5A                              POP     DX
   496 0000020E 59                              POP     CX
   497 0000020F 5B                              POP     BX
   498 00000210 58                              POP     AX
   499 00000211 C3                              RET
   500                                  
   501                                  ; -----------------------------------------------------------------------------
   502                                  ; cor_do_jogador
   503                                  ; Entrada: AL = 1 ou 2. Saida: [cor] = cor escolhida por esse jogador.
   504                                  ; Preserva AL.
   505                                  ; -----------------------------------------------------------------------------
   506                                  cor_do_jogador:
   507 00000212 53                              PUSH    BX
   508 00000213 8A1E[0C00]                      MOV     BL, [jogador1+JCOR]
   509 00000217 3C01                            CMP     AL, 1
   510 00000219 7404                            JE      cdj_grava
   511 0000021B 8A1E[0C00]                      MOV     BL, [jogador2+JCOR]
   512                                  cdj_grava:
   513 0000021F 881E[0000]                      MOV     [cor], BL
   514 00000223 5B                              POP     BX
   515 00000224 C3                              RET
   516                                  
   517                                  ; =============================================================================
   518                                  ; tela_game_over
   519                                  ; Mostra "GAME OVER", o vencedor da partida, o placar e pergunta se os
   520                                  ; jogadores querem uma nova partida.
   521                                  ; Saida: AL = 1 -> Y (nova partida), AL = 0 -> N ou saida confirmada (Q).
   522                                  ; =============================================================================
   523                                  tela_game_over:
   524 00000225 53                              PUSH    BX
   525 00000226 51                              PUSH    CX
   526 00000227 52                              PUSH    DX
   527 00000228 56                              PUSH    SI
   528                                  
   529 00000229 E8(0000)                        CALL    limpa_tela
   530 0000022C E8(0000)                        CALL    limpa_eventos
   531                                  
   532 0000022F C606[0000]0E                    MOV     byte [cor], amarelo
   533 00000234 BE[D300]                        MOV     SI, str_game_over
   534 00000237 B604                            MOV     DH, 4
   535 00000239 E8(0000)                        CALL    msg_centro
   536                                  
   537 0000023C A0[0000]                        MOV     AL, [vencedor]
   538 0000023F E8D0FF                          CALL    cor_do_jogador
   539 00000242 0430                            ADD     AL, '0'
   540 00000244 A2[E500]                        MOV     [str_campeao+8], AL
   541 00000247 BE[DD00]                        MOV     SI, str_campeao
   542 0000024A B607                            MOV     DH, 7
   543 0000024C E8(0000)                        CALL    msg_centro
   544                                  
   545 0000024F A0[0000]                        MOV     AL, [rounds_p1]             ; "Placar final: J1 x - y J2"
   546 00000252 0430                            ADD     AL, '0'
   547 00000254 A2[0A01]                        MOV     [str_placar+17], AL
   548 00000257 A0[0000]                        MOV     AL, [rounds_p2]
   549 0000025A 0430                            ADD     AL, '0'
   550 0000025C A2[0E01]                        MOV     [str_placar+21], AL
   551 0000025F C606[0000]0F                    MOV     byte [cor], branco_intenso
   552 00000264 BE[F900]                        MOV     SI, str_placar
   553 00000267 B609                            MOV     DH, 9
   554 00000269 E8(0000)                        CALL    msg_centro
   555                                  
   556                                          ; ---- o campeao, em pose de soco
   557 0000026C BE[0000]                        MOV     SI, jogador1
   558 0000026F 803E[0000]01                    CMP     byte [vencedor], 1
   559 00000274 7403                            JE      go_boneco
   560 00000276 BE[0000]                        MOV     SI, jogador2
   561                                  go_boneco:
   562 00000279 8A440C                          MOV     AL, [SI+JCOR]
   563 0000027C B402                            MOV     AH, FRAME_IMPACTO_SOCO
   564 0000027E B300                            MOV     BL, 0
   565 00000280 B702                            MOV     BH, EST_SOCO
   566 00000282 B94001                          MOV     CX, 320
   567 00000285 BAE100                          MOV     DX, Y_PREVIA
   568 00000288 E8(0000)                        CALL    desenha_jogador
   569                                  
   570 0000028B C606[0000]0E                    MOV     byte [cor], amarelo
   571 00000290 BE[1301]                        MOV     SI, str_nova
   572 00000293 B618                            MOV     DH, 24
   573 00000295 E8(0000)                        CALL    msg_centro
   574                                  
   575                                  go_espera:
   576 00000298 E8(0000)                        CALL    espera_evento
   577 0000029B 3C15                            CMP     AL, TEC_Y
   578 0000029D 7418                            JE      go_sim
   579 0000029F 3C31                            CMP     AL, TEC_N
   580 000002A1 740F                            JE      go_nao
   581 000002A3 3C10                            CMP     AL, TEC_Q
   582 000002A5 7404                            JE      go_sair
   583 000002A7 3C01                            CMP     AL, TEC_ESC
   584 000002A9 75ED                            JNE     go_espera
   585                                  go_sair:
   586 000002AB E8(0000)                        CALL    confirma_saida
   587 000002AE 3C01                            CMP     AL, 1
   588 000002B0 75E6                            JNE     go_espera
   589                                  go_nao:
   590 000002B2 B000                            MOV     AL, 0
   591 000002B4 E90200                          JMP     go_fim
   592                                  go_sim:
   593 000002B7 B001                            MOV     AL, 1
   594                                  go_fim:
   595 000002B9 5E                              POP     SI
   596 000002BA 5A                              POP     DX
   597 000002BB 59                              POP     CX
   598 000002BC 5B                              POP     BX
   599 000002BD C3                              RET
