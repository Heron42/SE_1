     1                                  ; =============================================================================
     2                                  ; telas.asm  -  Telas do jogo: selecao de lutadores, avisos de round e Game Over
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; tela_selecao      : cada jogador escolhe a cor do seu lutador
     5                                  ;                     (J1: W/S, J2: setas cima/baixo, ENTER inicia a luta).
     6                                  ;                     Os dois nao podem ficar com a mesma cor: a cor ja
     7                                  ;                     escolhida pelo adversario e pulada automaticamente.
     8                                  ; anuncia_round     : "ROUND n" / "LUTEM!" antes de cada round
     9                                  ; anuncia_fim_round : motivo do fim (nocaute ou tempo) e vencedor do round
    10                                  ; tela_game_over    : "GAME OVER", vencedor, placar e menu Y/N
    11                                  ;
    12                                  ; Em todas as telas, Q/ESC pede confirmacao de saida (Y/N).
    13                                  ; =============================================================================
    14                                  
    15                                  ; ------------------------------- Constantes (EQU) -----------------------------
    16                                  ; Constantes usadas por este modulo. Um EQU nao ocupa memoria: o montador
    17                                  ; troca o nome pelo valor. As que aparecem em mais de um modulo (estrutura do
    18                                  ; jogador, cores, scan codes, regras) precisam ter o MESMO valor em todos.
    19                                  
    20                                  ; ------------------------------- Scan codes (make) ----------------------------
    21                                  TEC_ESC         EQU     01h
    22                                  TEC_Q           EQU     10h
    23                                  TEC_W           EQU     11h
    24                                  TEC_Y           EQU     15h
    25                                  TEC_ENTER       EQU     1Ch
    26                                  TEC_S           EQU     1Fh
    27                                  TEC_N           EQU     31h
    28                                  TEC_CIMA        EQU     48h         ; seta para cima   (chega apos o prefixo E0h)
    29                                  TEC_BAIXO       EQU     50h         ; seta para baixo  (apos E0h)
    30                                  
    31                                  ; ------------------------------- Cores (paleta padrao VGA) --------------------
    32                                  vermelho        EQU     4           ; 0 1 0 0
    33                                  marrom          EQU     6           ; 0 1 1 0
    34                                  branco          EQU     7           ; 0 1 1 1
    35                                  cinza           EQU     8           ; 1 0 0 0
    36                                  azul_claro      EQU     9           ; 1 0 0 1
    37                                  verde_claro     EQU     10          ; 1 0 1 0
    38                                  cyan_claro      EQU     11          ; 1 0 1 1
    39                                  magenta_claro   EQU     13          ; 1 1 0 1
    40                                  amarelo         EQU     14          ; 1 1 1 0
    41                                  branco_intenso  EQU     15          ; 1 1 1 1
    42                                  
    43                                  ; ------------------------------- Arena e HUD ----------------------------------
    44                                  LIN_MSG         EQU     6           ; mensagens no centro da arena (acima do pulo)
    45                                  
    46                                  ; ------------------------------- Regras do jogo -------------------------------
    47                                  MOTIVO_TEMPO    EQU     2           ; round terminou por tempo esgotado
    48                                  
    49                                  ; ------------------------------- Colisao --------------------------------------
    50                                  FRAME_IMPACTO_SOCO  EQU 2           ; frame da animacao em que o soco "pega"
    51                                  
    52                                  ; ------------------------------- Estados de animacao --------------------------
    53                                  EST_IDLE        EQU     0
    54                                  EST_SOCO        EQU     2
    55                                  
    56                                  ; ------------------------------- Estrutura de um jogador (20 bytes) -----------
    57                                  JCOR            EQU     12          ; db  cor do lutador (escolhida na selecao)
    58                                  
    59                                  global  tela_selecao
    60                                  global  anuncia_round
    61                                  global  anuncia_fim_round
    62                                  global  tela_game_over
    63                                  
    64                                  extern  espera_evento               ; teclado.asm
    65                                  extern  limpa_eventos
    66                                  extern  desenha_jogador             ; graficos.asm
    67                                  extern  escreve_texto
    68                                  extern  limpa_tela
    69                                  extern  line
    70                                  extern  cor
    71                                  extern  msg_centro                  ; hud.asm
    72                                  extern  apaga_linha
    73                                  extern  jogador1                    ; jogador.asm
    74                                  extern  jogador2
    75                                  extern  confirma_saida              ; logica.asm
    76                                  extern  aguarda
    77                                  extern  sair_flag
    78                                  extern  rounds_p1
    79                                  extern  rounds_p2
    80                                  extern  vencedor
    81                                  extern  vencedor_round
    82                                  extern  motivo_fim
    83                                  
    84                                  NUM_CORES       EQU     8           ; potencia de 2 (indice mascarado)
    85                                  LIN_TITULO      EQU     2
    86                                  LIN_CABECALHO   EQU     5
    87                                  LIN_LISTA       EQU     7           ; primeira linha da lista de cores
    88                                  COL_MARCA_J1    EQU     5
    89                                  COL_MARCA_J2    EQU     59
    90                                  X_PREVIA_J1     EQU     260
    91                                  X_PREVIA_J2     EQU     380
    92                                  Y_PREVIA        EQU     225         ; ombros do boneco de previa
    93                                  LIN_CTRL        EQU     23
    94                                  
    95                                  TIQUES_ROUND    EQU     27          ; ~1,5 s mostrando "ROUND n"
    96                                  TIQUES_LUTEM    EQU     11          ; ~0,6 s mostrando "LUTEM!"
    97                                  TIQUES_FIM      EQU     45          ; ~2,5 s mostrando o vencedor do round
    98                                  
    99                                  segment code public class=CODE
   100                                  
   101                                  ; =============================================================================
   102                                  ; tela_selecao
   103                                  ; Saida: sair_flag = 1 se o usuario confirmou a saida pela tecla Q/ESC.
   104                                  ;        Caso contrario, [jogador1+JCOR] e [jogador2+JCOR] recebem as cores
   105                                  ;        escolhidas.
   106                                  ; =============================================================================
   107                                  tela_selecao:
   108 00000000 50                              PUSH    AX
   109 00000001 53                              PUSH    BX
   110 00000002 52                              PUSH    DX
   111 00000003 56                              PUSH    SI
   112 00000004 57                              PUSH    DI
   113                                  
   114 00000005 E8(0000)                        CALL    limpa_tela
   115 00000008 E8(0000)                        CALL    limpa_eventos
   116                                  
   117                                          ; ---- textos fixos
   118 0000000B C606[0000]0E                    MOV     byte [cor], amarelo
   119 00000010 BE[6600]                        MOV     SI, str_titulo
   120 00000013 B602                            MOV     DH, LIN_TITULO
   121 00000015 E8(0000)                        CALL    msg_centro
   122                                  
   123 00000018 C606[0000]0F                    MOV     byte [cor], branco_intenso
   124 0000001D BE[7B00]                        MOV     SI, str_cab_j1
   125 00000020 B605                            MOV     DH, LIN_CABECALHO
   126 00000022 B204                            MOV     DL, COL_MARCA_J1 - 1
   127 00000024 E8(0000)                        CALL    escreve_texto
   128 00000027 BE[8500]                        MOV     SI, str_cab_j2
   129 0000002A B23A                            MOV     DL, COL_MARCA_J2 - 1
   130 0000002C E8(0000)                        CALL    escreve_texto
   131                                  
   132 0000002F C606[0000]07                    MOV     byte [cor], branco
   133 00000034 BE[8F00]                        MOV     SI, str_ctrl_j1
   134 00000037 B617                            MOV     DH, LIN_CTRL
   135 00000039 E8(0000)                        CALL    msg_centro
   136 0000003C BE[9000]                        MOV     SI, str_ctrl_j2
   137 0000003F B618                            MOV     DH, LIN_CTRL + 1
   138 00000041 E8(0000)                        CALL    msg_centro
   139 00000044 C606[0000]0E                    MOV     byte [cor], amarelo
   140 00000049 BE[9100]                        MOV     SI, str_iniciar
   141 0000004C B619                            MOV     DH, LIN_CTRL + 2
   142 0000004E E8(0000)                        CALL    msg_centro
   143                                  
   144                                          ; ---- "chao" sob as previas
   145 00000051 C606[0000]08                    MOV     byte [cor], cinza
   146 00000056 B8C800                          MOV     AX, X_PREVIA_J1 - 60
   147 00000059 50                              PUSH    AX
   148 0000005A B88900                          MOV     AX, Y_PREVIA - 88
   149 0000005D 50                              PUSH    AX
   150 0000005E B8B801                          MOV     AX, X_PREVIA_J2 + 60
   151 00000061 50                              PUSH    AX
   152 00000062 B88900                          MOV     AX, Y_PREVIA - 88
   153 00000065 50                              PUSH    AX
   154 00000066 E8(0000)                        CALL    line
   155                                  
   156 00000069 E88E00                          CALL    redesenha_j1
   157 0000006C E8B500                          CALL    redesenha_j2
   158                                  
   159                                          ; ---- laco de selecao
   160                                  ts_espera:
   161 0000006F E8(0000)                        CALL    espera_evento               ; AL = scan code MAKE
   162 00000072 3C11                            CMP     AL, TEC_W
   163 00000074 741B                            JE      ts_j1_sobe
   164 00000076 3C1F                            CMP     AL, TEC_S
   165 00000078 741C                            JE      ts_j1_desce
   166 0000007A 3C48                            CMP     AL, TEC_CIMA
   167 0000007C 7429                            JE      ts_j2_sobe
   168 0000007E 3C50                            CMP     AL, TEC_BAIXO
   169 00000080 742A                            JE      ts_j2_desce
   170 00000082 3C1C                            CMP     AL, TEC_ENTER
   171 00000084 7446                            JE      ts_inicia
   172 00000086 3C10                            CMP     AL, TEC_Q
   173 00000088 7433                            JE      ts_sair
   174 0000008A 3C01                            CMP     AL, TEC_ESC
   175 0000008C 742F                            JE      ts_sair
   176 0000008E E9DEFF                          JMP     ts_espera
   177                                  
   178                                  ts_j1_sobe:
   179 00000091 B0FF                            MOV     AL, -1
   180 00000093 E90200                          JMP     ts_muda_j1
   181                                  ts_j1_desce:
   182 00000096 B001                            MOV     AL, 1
   183                                  ts_muda_j1:
   184 00000098 BE[0000]                        MOV     SI, idx_j1
   185 0000009B BF[0100]                        MOV     DI, idx_j2
   186 0000009E E84900                          CALL    muda_cor
   187 000000A1 E85600                          CALL    redesenha_j1
   188 000000A4 E9C8FF                          JMP     ts_espera
   189                                  
   190                                  ts_j2_sobe:
   191 000000A7 B0FF                            MOV     AL, -1
   192 000000A9 E90200                          JMP     ts_muda_j2
   193                                  ts_j2_desce:
   194 000000AC B001                            MOV     AL, 1
   195                                  ts_muda_j2:
   196 000000AE BE[0100]                        MOV     SI, idx_j2
   197 000000B1 BF[0000]                        MOV     DI, idx_j1
   198 000000B4 E83300                          CALL    muda_cor
   199 000000B7 E86A00                          CALL    redesenha_j2
   200 000000BA E9B2FF                          JMP     ts_espera
   201                                  
   202                                  ts_sair:
   203 000000BD E8(0000)                        CALL    confirma_saida
   204 000000C0 3C01                            CMP     AL, 1
   205 000000C2 75AB                            JNE     ts_espera
   206 000000C4 C606[0000]01                    MOV     byte [sair_flag], 1
   207 000000C9 E91800                          JMP     ts_fim
   208                                  
   209                                  ts_inicia:
   210 000000CC 8A1E[0000]                      MOV     BL, [idx_j1]                ; grava as cores escolhidas
   211 000000D0 30FF                            XOR     BH, BH
   212 000000D2 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   213 000000D6 A2[0C00]                        MOV     [jogador1+JCOR], AL
   214 000000D9 8A1E[0100]                      MOV     BL, [idx_j2]
   215 000000DD 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   216 000000E1 A2[0C00]                        MOV     [jogador2+JCOR], AL
   217                                  
   218                                  ts_fim:
   219 000000E4 5F                              POP     DI
   220 000000E5 5E                              POP     SI
   221 000000E6 5A                              POP     DX
   222 000000E7 5B                              POP     BX
   223 000000E8 58                              POP     AX
   224 000000E9 C3                              RET
   225                                  
   226                                  ; -----------------------------------------------------------------------------
   227                                  ; muda_cor
   228                                  ; Entrada: SI -> indice da cor do jogador, DI -> indice da cor do adversario,
   229                                  ;          AL = +1 (desce na lista) ou -1 (sobe na lista).
   230                                  ; Avanca circularmente e pula a cor ja escolhida pelo adversario.
   231                                  ; -----------------------------------------------------------------------------
   232                                  muda_cor:
   233 000000EA 53                              PUSH    BX
   234 000000EB 8A1C                            MOV     BL, [SI]
   235                                  mc_avanca:
   236 000000ED 00C3                            ADD     BL, AL
   237 000000EF 80E307                          AND     BL, NUM_CORES - 1           ; volta ao inicio/fim da lista
   238 000000F2 3A1D                            CMP     BL, [DI]
   239 000000F4 74F7                            JE      mc_avanca                   ; cor do adversario: pula
   240 000000F6 881C                            MOV     [SI], BL
   241 000000F8 5B                              POP     BX
   242 000000F9 C3                              RET
   243                                  
   244                                  ; -----------------------------------------------------------------------------
   245                                  ; redesenha_j1 / redesenha_j2: lista de cores com marcador + boneco de previa.
   246                                  ; -----------------------------------------------------------------------------
   247                                  redesenha_j1:
   248 000000FA 50                              PUSH    AX
   249 000000FB 53                              PUSH    BX
   250 000000FC 51                              PUSH    CX
   251 000000FD 52                              PUSH    DX
   252 000000FE A0[0000]                        MOV     AL, [idx_j1]
   253 00000101 B205                            MOV     DL, COL_MARCA_J1
   254 00000103 E84800                          CALL    desenha_lista
   255 00000106 8A1E[0000]                      MOV     BL, [idx_j1]
   256 0000010A 30FF                            XOR     BH, BH
   257 0000010C 8A87[0200]                      MOV     AL, [tabela_cores+BX]       ; cor
   258 00000110 B400                            MOV     AH, 0                       ; frame 0
   259 00000112 B300                            MOV     BL, 0                       ; olhando para a direita
   260 00000114 B700                            MOV     BH, EST_IDLE
   261 00000116 B90401                          MOV     CX, X_PREVIA_J1
   262 00000119 BAE100                          MOV     DX, Y_PREVIA
   263 0000011C E8(0000)                        CALL    desenha_jogador
   264 0000011F 5A                              POP     DX
   265 00000120 59                              POP     CX
   266 00000121 5B                              POP     BX
   267 00000122 58                              POP     AX
   268 00000123 C3                              RET
   269                                  
   270                                  redesenha_j2:
   271 00000124 50                              PUSH    AX
   272 00000125 53                              PUSH    BX
   273 00000126 51                              PUSH    CX
   274 00000127 52                              PUSH    DX
   275 00000128 A0[0100]                        MOV     AL, [idx_j2]
   276 0000012B B23B                            MOV     DL, COL_MARCA_J2
   277 0000012D E81E00                          CALL    desenha_lista
   278 00000130 8A1E[0100]                      MOV     BL, [idx_j2]
   279 00000134 30FF                            XOR     BH, BH
   280 00000136 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   281 0000013A B400                            MOV     AH, 0
   282 0000013C B301                            MOV     BL, 1                       ; olhando para a esquerda
   283 0000013E B700                            MOV     BH, EST_IDLE
   284 00000140 B97C01                          MOV     CX, X_PREVIA_J2
   285 00000143 BAE100                          MOV     DX, Y_PREVIA
   286 00000146 E8(0000)                        CALL    desenha_jogador
   287 00000149 5A                              POP     DX
   288 0000014A 59                              POP     CX
   289 0000014B 5B                              POP     BX
   290 0000014C 58                              POP     AX
   291 0000014D C3                              RET
   292                                  
   293                                  ; -----------------------------------------------------------------------------
   294                                  ; desenha_lista
   295                                  ; Entrada: AL = indice selecionado, DL = coluna do marcador.
   296                                  ; Escreve as NUM_CORES opcoes (cada nome na propria cor), com ">" na
   297                                  ; selecionada e " " nas demais.
   298                                  ; -----------------------------------------------------------------------------
   299                                  desenha_lista:
   300 0000014E 50                              PUSH    AX
   301 0000014F 53                              PUSH    BX
   302 00000150 51                              PUSH    CX
   303 00000151 52                              PUSH    DX
   304 00000152 56                              PUSH    SI
   305                                  
   306 00000153 88C4                            MOV     AH, AL                      ; AH = indice selecionado
   307 00000155 B607                            MOV     DH, LIN_LISTA
   308 00000157 31C9                            XOR     CX, CX                      ; CX = indice da opcao
   309                                  dl_loop:
   310                                          ; ---- marcador
   311 00000159 C606[0000]0F                    MOV     byte [cor], branco_intenso
   312 0000015E BE[6400]                        MOV     SI, str_marca_off
   313 00000161 38E1                            CMP     CL, AH
   314 00000163 7503                            JNE     dl_marca
   315 00000165 BE[6200]                        MOV     SI, str_marca_on
   316                                  dl_marca:
   317 00000168 E8(0000)                        CALL    escreve_texto
   318                                  
   319                                          ; ---- nome da cor, escrito na propria cor
   320 0000016B 89CB                            MOV     BX, CX
   321 0000016D 8A87[0200]                      MOV     AL, [tabela_cores+BX]
   322 00000171 A2[0000]                        MOV     [cor], AL
   323 00000174 D1E3                            SHL     BX, 1
   324 00000176 8BB7[0A00]                      MOV     SI, [tabela_nomes+BX]
   325 0000017A 52                              PUSH    DX
   326 0000017B 80C202                          ADD     DL, 2
   327 0000017E E8(0000)                        CALL    escreve_texto
   328 00000181 5A                              POP     DX
   329                                  
   330 00000182 FEC6                            INC     DH
   331 00000184 41                              INC     CX
   332 00000185 81F90800                        CMP     CX, NUM_CORES
   333 00000189 72CE                            JB      dl_loop
   334                                  
   335 0000018B 5E                              POP     SI
   336 0000018C 5A                              POP     DX
   337 0000018D 59                              POP     CX
   338 0000018E 5B                              POP     BX
   339 0000018F 58                              POP     AX
   340 00000190 C3                              RET
   341                                  
   342                                  ; =============================================================================
   343                                  ; anuncia_round
   344                                  ; Mostra "ROUND n" e "LUTEM!" no centro da arena antes do round comecar
   345                                  ; (com o cronometro ainda parado). Respeita Q/ESC via aguarda.
   346                                  ; =============================================================================
   347                                  anuncia_round:
   348 00000191 50                              PUSH    AX
   349 00000192 51                              PUSH    CX
   350 00000193 52                              PUSH    DX
   351 00000194 56                              PUSH    SI
   352                                  
   353 00000195 A0[0000]                        MOV     AL, [rounds_p1]
   354 00000198 0206[0000]                      ADD     AL, [rounds_p2]
   355 0000019C 0431                            ADD     AL, '1'                     ; numero do round atual
   356 0000019E A2[9800]                        MOV     [str_round+6], AL
   357                                  
   358 000001A1 C606[0000]0E                    MOV     byte [cor], amarelo
   359 000001A6 BE[9200]                        MOV     SI, str_round
   360 000001A9 B606                            MOV     DH, LIN_MSG
   361 000001AB E8(0000)                        CALL    msg_centro
   362 000001AE B91B00                          MOV     CX, TIQUES_ROUND
   363 000001B1 E8(0000)                        CALL    aguarda
   364 000001B4 803E[0000]00                    CMP     byte [sair_flag], 0
   365 000001B9 7514                            JNE     ar_fim
   366                                  
   367 000001BB E8(0000)                        CALL    apaga_linha                 ; DH = LIN_MSG
   368 000001BE C606[0000]0E                    MOV     byte [cor], amarelo
   369 000001C3 BE[9A00]                        MOV     SI, str_lutem
   370 000001C6 E8(0000)                        CALL    msg_centro
   371 000001C9 B90B00                          MOV     CX, TIQUES_LUTEM
   372 000001CC E8(0000)                        CALL    aguarda
   373                                  ar_fim:
   374 000001CF E8(0000)                        CALL    apaga_linha
   375 000001D2 5E                              POP     SI
   376 000001D3 5A                              POP     DX
   377 000001D4 59                              POP     CX
   378 000001D5 58                              POP     AX
   379 000001D6 C3                              RET
   380                                  
   381                                  ; =============================================================================
   382                                  ; anuncia_fim_round
   383                                  ; Mostra o motivo do fim do round e quem venceu, por ~2,5 s.
   384                                  ; =============================================================================
   385                                  anuncia_fim_round:
   386 000001D7 50                              PUSH    AX
   387 000001D8 53                              PUSH    BX
   388 000001D9 51                              PUSH    CX
   389 000001DA 52                              PUSH    DX
   390 000001DB 56                              PUSH    SI
   391                                  
   392 000001DC C606[0000]0E                    MOV     byte [cor], amarelo
   393 000001E1 BE[A100]                        MOV     SI, str_nocaute
   394 000001E4 803E[0000]02                    CMP     byte [motivo_fim], MOTIVO_TEMPO
   395 000001E9 7503                            JNE     afr_motivo
   396 000001EB BE[A400]                        MOV     SI, str_tempo
   397                                  afr_motivo:
   398 000001EE B606                            MOV     DH, LIN_MSG
   399 000001F0 E8(0000)                        CALL    msg_centro
   400                                  
   401 000001F3 A0[0000]                        MOV     AL, [vencedor_round]
   402 000001F6 E81900                          CALL    cor_do_jogador              ; [cor] = cor do vencedor
   403 000001F9 0430                            ADD     AL, '0'
   404 000001FB A2[BC00]                        MOV     [str_vence_round+8], AL
   405 000001FE BE[B400]                        MOV     SI, str_vence_round
   406 00000201 B607                            MOV     DH, LIN_MSG + 1
   407 00000203 E8(0000)                        CALL    msg_centro
   408                                  
   409 00000206 B92D00                          MOV     CX, TIQUES_FIM
   410 00000209 E8(0000)                        CALL    aguarda
   411                                  
   412 0000020C 5E                              POP     SI
   413 0000020D 5A                              POP     DX
   414 0000020E 59                              POP     CX
   415 0000020F 5B                              POP     BX
   416 00000210 58                              POP     AX
   417 00000211 C3                              RET
   418                                  
   419                                  ; -----------------------------------------------------------------------------
   420                                  ; cor_do_jogador
   421                                  ; Entrada: AL = 1 ou 2. Saida: [cor] = cor escolhida por esse jogador.
   422                                  ; Preserva AL.
   423                                  ; -----------------------------------------------------------------------------
   424                                  cor_do_jogador:
   425 00000212 53                              PUSH    BX
   426 00000213 8A1E[0C00]                      MOV     BL, [jogador1+JCOR]
   427 00000217 3C01                            CMP     AL, 1
   428 00000219 7404                            JE      cdj_grava
   429 0000021B 8A1E[0C00]                      MOV     BL, [jogador2+JCOR]
   430                                  cdj_grava:
   431 0000021F 881E[0000]                      MOV     [cor], BL
   432 00000223 5B                              POP     BX
   433 00000224 C3                              RET
   434                                  
   435                                  ; =============================================================================
   436                                  ; tela_game_over
   437                                  ; Mostra "GAME OVER", o vencedor da partida, o placar e pergunta se os
   438                                  ; jogadores querem uma nova partida.
   439                                  ; Saida: AL = 1 -> Y (nova partida), AL = 0 -> N ou saida confirmada (Q).
   440                                  ; =============================================================================
   441                                  tela_game_over:
   442 00000225 53                              PUSH    BX
   443 00000226 51                              PUSH    CX
   444 00000227 52                              PUSH    DX
   445 00000228 56                              PUSH    SI
   446                                  
   447 00000229 E8(0000)                        CALL    limpa_tela
   448 0000022C E8(0000)                        CALL    limpa_eventos
   449                                  
   450 0000022F C606[0000]0E                    MOV     byte [cor], amarelo
   451 00000234 BE[CD00]                        MOV     SI, str_game_over
   452 00000237 B604                            MOV     DH, 4
   453 00000239 E8(0000)                        CALL    msg_centro
   454                                  
   455 0000023C A0[0000]                        MOV     AL, [vencedor]
   456 0000023F E8D0FF                          CALL    cor_do_jogador
   457 00000242 0430                            ADD     AL, '0'
   458 00000244 A2[DF00]                        MOV     [str_campeao+8], AL
   459 00000247 BE[D700]                        MOV     SI, str_campeao
