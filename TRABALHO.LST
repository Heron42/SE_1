   519                                  ; =============================================================================
   520                                  ; ISR de teclado (INT 9h)
   521                                  ; Mantem duas estruturas:
   522                                  ;   teclas[128] : 1 = tecla pressionada, 0 = solta (para movimento continuo)
   523                                  ;   tecla[8]    : buffer circular de codigos (para comandos pontuais)
   524                                  ; As setas chegam como E0h + codigo; o prefixo E0h e simplesmente ignorado,
   525                                  ; de modo que seta esquerda = 4Bh, seta direita = 4Dh etc.
   526                                  ; =============================================================================
   527                                  keyINT:
   528 0000034B 50                              PUSH    AX
   529 0000034C 53                              PUSH    BX
   530 0000034D 1E                              PUSH    DS
   531 0000034E B8[0000]                        MOV     AX, data                    ; garante DS correto dentro da ISR
   532 00000351 8ED8                            MOV     DS, AX
   533                                  
   534 00000353 E460                            IN      AL, kb_data                 ; le o codigo make/break (porta 60h)
   535 00000355 3CE0                            CMP     AL, 0E0h                    ; prefixo de tecla estendida
   536 00000357 742D                            JE      ki_ack
   537 00000359 3CE1                            CMP     AL, 0E1h                    ; prefixo da tecla Pause
   538 0000035B 7429                            JE      ki_ack
   539                                  
   540                                          ; ---- grava no buffer circular (comandos)
   541 0000035D FF06[0D00]                      INC     WORD [p_i]
   542 00000361 8126[0D00]0700                  AND     WORD [p_i], 7
   543 00000367 8B1E[0D00]                      MOV     BX, [p_i]
   544 0000036B 8887[0500]                      MOV     [BX+tecla], AL
   545                                  
   546                                          ; ---- atualiza a tabela de estado (movimento)
   547 0000036F 88C3                            MOV     BL, AL
   548 00000371 81E37F00                        AND     BX, 007Fh                   ; BX = codigo sem o bit 7 (e BH = 0)
   549 00000375 A880                            TEST    AL, 80h                     ; bit 7 = 1 -> break (soltou)
   550 00000377 7508                            JNZ     ki_solta
   551 00000379 C687[1100]01                    MOV     byte [teclas+BX], 1
   552 0000037E E90500                          JMP     ki_ack
   553                                  ki_solta:
   554 00000381 C687[1100]00                    MOV     byte [teclas+BX], 0
   555                                  
   556                                  ki_ack:
   557 00000386 E461                            IN      AL, kb_ctl                  ; reconhece o dado na porta 61h
   558 00000388 0C80                            OR      AL, 80h
   559 0000038A E661                            OUT     kb_ctl, AL
   560 0000038C 247F                            AND     AL, 7Fh
   561 0000038E E661                            OUT     kb_ctl, AL
   562 00000390 B020                            MOV     AL, eoi                     ; fim de interrupcao para o PIC
   563 00000392 E620                            OUT     pictrl, AL
   564                                  
   565 00000394 1F                              POP     DS
   566 00000395 5B                              POP     BX
   567 00000396 58                              POP     AX
   568 00000397 CF                              IRET
   569                                  
   570                                  ; =============================================================================
   571                                  ; ISR de relogio (INT 8h) - 18,2 Hz
   572                                  ; Incrementa tique_jogo (ritmo do loop) e conta segundos (base para o
   573                                  ; cronometro de 3 minutos do round). Ao final ENCADEIA a ISR original do
   574                                  ; BIOS, que mantem o relogio do sistema e envia o EOI ao PIC.
   575                                  ; =============================================================================
   576                                  ClockINT:
   577 00000398 50                              PUSH    AX
   578 00000399 1E                              PUSH    DS
   579 0000039A B8[0000]                        MOV     AX, data
   580 0000039D 8ED8                            MOV     DS, AX
   581                                  
   582 0000039F FF06[9800]                      INC     WORD [tique_jogo]           ; um "frame" do jogo
   583                                  
   584 000003A3 FE06[9500]                      INC     byte [tique]                ; contagem de segundos
   585 000003A7 803E[9500]12                    CMP     byte [tique], 18
   586 000003AC 7209                            JB      ck_chain
   587 000003AE C606[9500]00                    MOV     byte [tique], 0
   588 000003B3 FF06[9600]                      INC     WORD [segundos]
   589                                  
   590                                  ck_chain:
   591 000003B7 9C                              PUSHF                               ; simula um INT para a ISR original
   592 000003B8 FF1E[9100]                      CALL    FAR [offset_clk]            ; (ela faz o EOI e termina em IRET)
   593                                  
   594 000003BC 1F                              POP     DS
   595 000003BD 58                              POP     AX
   596 000003BE CF                              IRET
   597                                  
   598                                  ; =============================================================================
   599                                  segment data public class=DATA
   600                                  
   601                                  ; ------------------------------- Teclado --------------------------------------
   602                                  kb_data         EQU     60h         ; porta de dados do teclado
   603                                  kb_ctl          EQU     61h         ; porta de controle do teclado
   604                                  pictrl          EQU     20h         ; porta de comando do PIC
   605                                  eoi             EQU     20h         ; comando End Of Interrupt
   606                                  INT9            EQU     09h         ; interrupcao de hardware do teclado
   607                                  
   608                                  ; Scan codes (make)
   609                                  TEC_ESC         EQU     01h
   610                                  TEC_Q           EQU     10h
   611                                  TEC_W           EQU     11h
   612                                  TEC_R           EQU     13h
   613                                  TEC_T           EQU     14h
   614                                  TEC_Y           EQU     15h
   615                                  TEC_P           EQU     19h
   616                                  TEC_ENTER       EQU     1Ch
   617                                  TEC_A           EQU     1Eh
   618                                  TEC_S           EQU     1Fh
   619                                  TEC_D           EQU     20h
   620                                  TEC_N           EQU     31h
   621                                  TEC_M           EQU     32h
   622                                  TEC_CIMA        EQU     48h         ; seta para cima   (apos E0h)
   623                                  TEC_ESQ         EQU     4Bh         ; seta esquerda    (apos E0h)
   624                                  TEC_DIR         EQU     4Dh         ; seta direita     (apos E0h)
   625                                  TEC_BAIXO       EQU     50h         ; seta para baixo  (apos E0h)
   626                                  
   627 00000000 0000                    cs_tec          DW      0           ; CS original da INT 9
   628 00000002 0000                    offset_tec      DW      0           ; IP original da INT 9
   629 00000004 00                      tecla_u         DB      0           ; ultimo codigo retirado do buffer
   630 00000005 00<rept>                tecla           TIMES 8 DB 0        ; buffer circular de codigos
   631 0000000D 0000                    p_i             DW      0           ; indice de escrita (ISR)
   632 0000000F 0000                    p_t             DW      0           ; indice de leitura (programa)
   633 00000011 00<rept>                teclas          TIMES 128 DB 0      ; tabela de estado: 1 = pressionada
   634                                  
   635                                  ; ------------------------------- Relogio --------------------------------------
   636                                  INTr            EQU     08h         ; interrupcao de hardware do temporizador
   637 00000091 0000                    offset_clk      DW      0           ; IP original da INT 8  (offset ANTES do
   638 00000093 0000                    cs_clk          DW      0           ; CS original da INT 8   segmento: far ptr)
   639 00000095 00                      tique           DB      0           ; tiques dentro do segundo atual
   640 00000096 0000                    segundos        DW      0           ; segundos decorridos
   641 00000098 0000                    tique_jogo      DW      0           ; incrementado a cada tique (~55 ms)
   642 0000009A 0000                    ultimo_tique    DW      0           ; ultimo tique processado pelo loop
   643                                  
   644                                  ; ------------------------------- Video ----------------------------------------
   645 0000009C 0F                      cor             DB      branco_intenso
   646                                                                      ; I R G B
   647                                  preto           EQU     0           ; 0 0 0 0
   648                                  azul            EQU     1           ; 0 0 0 1
   649                                  verde           EQU     2           ; 0 0 1 0
   650                                  cyan            EQU     3           ; 0 0 1 1
   651                                  vermelho        EQU     4           ; 0 1 0 0
   652                                  magenta         EQU     5           ; 0 1 0 1
   653                                  marrom          EQU     6           ; 0 1 1 0
   654                                  branco          EQU     7           ; 0 1 1 1
   655                                  cinza           EQU     8           ; 1 0 0 0
   656                                  azul_claro      EQU     9           ; 1 0 0 1
   657                                  verde_claro     EQU     10          ; 1 0 1 0
   658                                  cyan_claro      EQU     11          ; 1 0 1 1
   659                                  rosa            EQU     12          ; 1 1 0 0
   660                                  magenta_claro   EQU     13          ; 1 1 0 1
   661                                  amarelo         EQU     14          ; 1 1 1 0
   662                                  branco_intenso  EQU     15          ; 1 1 1 1
   663                                  
   664 0000009D 00                      modo_anterior   DB      0
   665 0000009E 0000                    deltAX          DW      0           ; variaveis de trabalho da rotina line
   666 000000A0 0000                    deltay          DW      0
   667                                  
   668                                  ; ------------------------------- Arena ----------------------------------------
   669                                  ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
   670                                  ARENA_ESQ       EQU     10
   671                                  ARENA_DIR       EQU     629
   672                                  ARENA_BAIXO     EQU     70          ; chao
   673                                  ARENA_TOPO      EQU     420         ; acima disso fica o HUD
   674                                  
   675                                  ; ------------------------------- Jogo -----------------------------------------
   676                                  VELOCIDADE      EQU     4           ; pixels por tique (~73 px/s)
   677                                  LIM_ESQ         EQU     40          ; menor X permitido para o centro do boneco
   678                                  LIM_DIR         EQU     598         ; maior X permitido (braco vai ate +27)
   679                                  DIST_MIN        EQU     50          ; distancia minima entre os dois lutadores
   680                                  Y_CHAO          EQU     156         ; Y dos ombros com o lutador no chao
   681                                  VEL_PULO        EQU     22          ; velocidade vertical inicial do pulo (px/tique)
   682                                  GRAVIDADE       EQU     2           ; reducao de VY a cada tique
   683 000000A2 00                      sair_flag       DB      0
   684                                  
   685 000000A3 2E00                    tam_corpo       DW      46
   686 000000A5 1C00                    tam_braco       DW      28
   687 000000A7 1E00                    tam_perna       DW      30
   688                                  
   689                                  ; ----------------------------------------------------------------------------
   690                                  ; Estrutura de um jogador (20 bytes). Acesse sempre como [SI+campo].
   691                                  ; ----------------------------------------------------------------------------
   692                                  JX              EQU     0           ; dw  posicao X atual (centro do tronco)
   693                                  JY              EQU     2           ; dw  posicao Y atual (ombros)
   694                                  JXANT           EQU     4           ; dw  X onde foi desenhado por ultimo
   695                                  JYANT           EQU     6           ; dw  Y onde foi desenhado por ultimo
   696                                  JFRAME          EQU     8           ; db  frame atual da animacao
   697                                  JFRAMEANT       EQU     9           ; db  frame desenhado por ultimo
   698                                  JDIR            EQU     10          ; db  0 = olha p/ direita, 1 = p/ esquerda
   699                                  JDIRANT         EQU     11          ; db  direcao desenhada por ultimo
   700                                  JCOR            EQU     12          ; db  cor do lutador
   701                                  JENERGIA        EQU     13          ; db  energia (comeca em 10)
   702                                  JESTADO         EQU     14          ; db  0 idle, 1 dir, 2 esq, 3 soco, 4 chute...
   703                                                                      ; byte 15: reserva (alinhamento)
   704                                  JVY             EQU     16          ; dw  velocidade vertical (positiva = sobe)
   705                                  JPULO           EQU     18          ; db  1 = no ar, 0 = no chao
   706                                                                      ; byte 19: reserva (alinhamento)
   707                                  
   708                                  ; Y_CHAO = 156 deixa os pes (offset -84 do frame) logo acima do chao (Y = 70)
   709                                  jogador1:
   710 000000A9 96009C00                        DW      150, Y_CHAO         ; JX, JY
   711 000000AD 96009C00                        DW      150, Y_CHAO         ; JXANT, JYANT
   712 000000B1 0000                            DB      0, 0                ; JFRAME, JFRAMEANT
   713 000000B3 0000                            DB      0, 0                ; JDIR, JDIRANT   (olha para a direita)
   714 000000B5 09                              DB      azul_claro          ; JCOR
   715 000000B6 0A                              DB      10                  ; JENERGIA
   716 000000B7 00                              DB      0                   ; JESTADO
   717 000000B8 00                              DB      0                   ; reserva
   718 000000B9 0000                            DW      0                   ; JVY
   719 000000BB 00                              DB      0                   ; JPULO
   720 000000BC 00                              DB      0                   ; reserva
   721                                  
   722                                  jogador2:
   723 000000BD EA019C00                        DW      490, Y_CHAO         ; JX, JY
   724 000000C1 EA019C00                        DW      490, Y_CHAO         ; JXANT, JYANT
   725 000000C5 0000                            DB      0, 0                ; JFRAME, JFRAMEANT
   726 000000C7 0101                            DB      1, 1                ; JDIR, JDIRANT   (olha para a esquerda)
   727 000000C9 04                              DB      vermelho            ; JCOR
   728 000000CA 0A                              DB      10                  ; JENERGIA
   729 000000CB 00                              DB      0                   ; JESTADO
   730 000000CC 00                              DB      0                   ; reserva
   731 000000CD 0000                            DW      0                   ; JVY
   732 000000CF 00                              DB      0                   ; JPULO
   733 000000D0 00                              DB      0                   ; reserva
   734                                  
   735                                  ; =============================================================================
   736                                  segment stack stack
   737 00000000 <res 00000400>                  resb    1024
   738                                  stacktop:
