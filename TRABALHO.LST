  1095                                  ; =============================================================================
  1096                                  ; ISR de teclado (INT 9h)
  1097                                  ; Mantem duas estruturas:
  1098                                  ;   teclas[128] : 1 = tecla pressionada, 0 = solta (para movimento continuo)
  1099                                  ;   tecla[8]    : buffer circular de codigos (para comandos pontuais)
  1100                                  ; As setas chegam como E0h + codigo; o prefixo E0h e simplesmente ignorado,
  1101                                  ; de modo que seta esquerda = 4Bh, seta direita = 4Dh etc.
  1102                                  ; =============================================================================
  1103                                  keyINT:
  1104 000007E1 50                              PUSH    AX
  1105 000007E2 53                              PUSH    BX
  1106 000007E3 1E                              PUSH    DS
  1107 000007E4 B8[0000]                        MOV     AX, data                    ; garante DS correto dentro da ISR
  1108 000007E7 8ED8                            MOV     DS, AX
  1109                                  
  1110 000007E9 E460                            IN      AL, kb_data                 ; le o codigo make/break (porta 60h)
  1111 000007EB 3CE0                            CMP     AL, 0E0h                    ; prefixo de tecla estendida
  1112 000007ED 742D                            JE      ki_ack
  1113 000007EF 3CE1                            CMP     AL, 0E1h                    ; prefixo da tecla Pause
  1114 000007F1 7429                            JE      ki_ack
  1115                                  
  1116                                          ; ---- grava no buffer circular (comandos)
  1117 000007F3 FF06[0D00]                      INC     WORD [p_i]
  1118 000007F7 8126[0D00]0700                  AND     WORD [p_i], 7
  1119 000007FD 8B1E[0D00]                      MOV     BX, [p_i]
  1120 00000801 8887[0500]                      MOV     [BX+tecla], AL
  1121                                  
  1122                                          ; ---- atualiza a tabela de estado (movimento)
  1123 00000805 88C3                            MOV     BL, AL
  1124 00000807 81E37F00                        AND     BX, 007Fh                   ; BX = codigo sem o bit 7 (e BH = 0)
  1125 0000080B A880                            TEST    AL, 80h                     ; bit 7 = 1 -> break (soltou)
  1126 0000080D 7508                            JNZ     ki_solta
  1127 0000080F C687[1100]01                    MOV     byte [teclas+BX], 1
  1128 00000814 E90500                          JMP     ki_ack
  1129                                  ki_solta:
  1130 00000817 C687[1100]00                    MOV     byte [teclas+BX], 0
  1131                                  
  1132                                  ki_ack:
  1133 0000081C E461                            IN      AL, kb_ctl                  ; reconhece o dado na porta 61h
  1134 0000081E 0C80                            OR      AL, 80h
  1135 00000820 E661                            OUT     kb_ctl, AL
  1136 00000822 247F                            AND     AL, 7Fh
  1137 00000824 E661                            OUT     kb_ctl, AL
  1138 00000826 B020                            MOV     AL, eoi                     ; fim de interrupcao para o PIC
  1139 00000828 E620                            OUT     pictrl, AL
  1140                                  
  1141 0000082A 1F                              POP     DS
  1142 0000082B 5B                              POP     BX
  1143 0000082C 58                              POP     AX
  1144 0000082D CF                              IRET
  1145                                  
  1146                                  ; =============================================================================
  1147                                  ; ISR de relogio (INT 8h) - 18,2 Hz
  1148                                  ; Incrementa tique_jogo (ritmo do loop) e conta segundos (base para o
  1149                                  ; cronometro de 3 minutos do round). Ao final ENCADEIA a ISR original do
  1150                                  ; BIOS, que mantem o relogio do sistema e envia o EOI ao PIC.
  1151                                  ; =============================================================================
  1152                                  ClockINT:
  1153 0000082E 50                              PUSH    AX
  1154 0000082F 1E                              PUSH    DS
  1155 00000830 B8[0000]                        MOV     AX, data
  1156 00000833 8ED8                            MOV     DS, AX
  1157                                  
  1158 00000835 FF06[9800]                      INC     WORD [tique_jogo]           ; um "frame" do jogo
  1159                                  
  1160 00000839 FE06[9500]                      INC     byte [tique]                ; contagem de segundos
  1161 0000083D 803E[9500]12                    CMP     byte [tique], 18
  1162 00000842 7209                            JB      ck_chain
  1163 00000844 C606[9500]00                    MOV     byte [tique], 0
  1164 00000849 FF06[9600]                      INC     WORD [segundos]
  1165                                  
  1166                                  ck_chain:
  1167 0000084D 9C                              PUSHF                               ; simula um INT para a ISR original
  1168 0000084E FF1E[9100]                      CALL    FAR [offset_clk]            ; (ela faz o EOI e termina em IRET)
  1169                                  
  1170 00000852 1F                              POP     DS
  1171 00000853 58                              POP     AX
  1172 00000854 CF                              IRET
  1173                                  
  1174                                  ; =============================================================================
  1175                                  segment data public class=DATA
  1176                                  
  1177                                  ; ------------------------------- Teclado --------------------------------------
  1178                                  kb_data         EQU     60h         ; porta de dados do teclado
  1179                                  kb_ctl          EQU     61h         ; porta de controle do teclado
  1180                                  pictrl          EQU     20h         ; porta de comando do PIC
  1181                                  eoi             EQU     20h         ; comando End Of Interrupt
  1182                                  INT9            EQU     09h         ; interrupcao de hardware do teclado
  1183                                  
  1184                                  ; Scan codes (make)
  1185                                  TEC_ESC         EQU     01h
  1186                                  TEC_Q           EQU     10h
  1187                                  TEC_W           EQU     11h
  1188                                  TEC_R           EQU     13h
  1189                                  TEC_T           EQU     14h
  1190                                  TEC_Y           EQU     15h
  1191                                  TEC_P           EQU     19h
  1192                                  TEC_ENTER       EQU     1Ch
  1193                                  TEC_A           EQU     1Eh
  1194                                  TEC_S           EQU     1Fh
  1195                                  TEC_D           EQU     20h
  1196                                  TEC_N           EQU     31h
  1197                                  TEC_M           EQU     32h
  1198                                  TEC_CIMA        EQU     48h         ; seta para cima   (apos E0h)
  1199                                  TEC_ESQ         EQU     4Bh         ; seta esquerda    (apos E0h)
  1200                                  TEC_DIR         EQU     4Dh         ; seta direita     (apos E0h)
  1201                                  TEC_BAIXO       EQU     50h         ; seta para baixo  (apos E0h)
  1202                                  
  1203 00000000 0000                    cs_tec          DW      0           ; CS original da INT 9
  1204 00000002 0000                    offset_tec      DW      0           ; IP original da INT 9
  1205 00000004 00                      tecla_u         DB      0           ; ultimo codigo retirado do buffer
  1206 00000005 00<rept>                tecla           TIMES 8 DB 0        ; buffer circular de codigos
  1207 0000000D 0000                    p_i             DW      0           ; indice de escrita (ISR)
  1208 0000000F 0000                    p_t             DW      0           ; indice de leitura (programa)
  1209 00000011 00<rept>                teclas          TIMES 128 DB 0      ; tabela de estado: 1 = pressionada
  1210                                  
  1211                                  ; ------------------------------- Relogio --------------------------------------
  1212                                  INTr            EQU     08h         ; interrupcao de hardware do temporizador
  1213 00000091 0000                    offset_clk      DW      0           ; IP original da INT 8  (offset ANTES do
  1214 00000093 0000                    cs_clk          DW      0           ; CS original da INT 8   segmento: far ptr)
  1215 00000095 00                      tique           DB      0           ; tiques dentro do segundo atual
  1216 00000096 0000                    segundos        DW      0           ; segundos decorridos
  1217 00000098 0000                    tique_jogo      DW      0           ; incrementado a cada tique (~55 ms)
  1218 0000009A 0000                    ultimo_tique    DW      0           ; ultimo tique processado pelo loop
  1219                                  
  1220                                  ; ------------------------------- Video ----------------------------------------
  1221 0000009C 0F                      cor             DB      branco_intenso
  1222                                                                      ; I R G B
  1223                                  preto           EQU     0           ; 0 0 0 0
  1224                                  azul            EQU     1           ; 0 0 0 1
  1225                                  verde           EQU     2           ; 0 0 1 0
  1226                                  cyan            EQU     3           ; 0 0 1 1
  1227                                  vermelho        EQU     4           ; 0 1 0 0
  1228                                  magenta         EQU     5           ; 0 1 0 1
  1229                                  marrom          EQU     6           ; 0 1 1 0
  1230                                  branco          EQU     7           ; 0 1 1 1
  1231                                  cinza           EQU     8           ; 1 0 0 0
  1232                                  azul_claro      EQU     9           ; 1 0 0 1
  1233                                  verde_claro     EQU     10          ; 1 0 1 0
  1234                                  cyan_claro      EQU     11          ; 1 0 1 1
  1235                                  rosa            EQU     12          ; 1 1 0 0
  1236                                  magenta_claro   EQU     13          ; 1 1 0 1
  1237                                  amarelo         EQU     14          ; 1 1 1 0
  1238                                  branco_intenso  EQU     15          ; 1 1 1 1
  1239                                  
  1240 0000009D 00                      modo_anterior   DB      0
  1241 0000009E 0000                    deltAX          DW      0           ; variaveis de trabalho da rotina line
  1242 000000A0 0000                    deltay          DW      0
  1243                                  
  1244                                  ; ------------------------------- Arena ----------------------------------------
  1245                                  ; Coordenadas no sistema de plot_xy: Y = 0 embaixo, Y = 479 em cima.
  1246                                  ARENA_ESQ       EQU     10
  1247                                  ARENA_DIR       EQU     629
  1248                                  ARENA_BAIXO     EQU     70          ; chao
  1249                                  ARENA_TOPO      EQU     420         ; acima disso fica o HUD
  1250                                  
  1251                                  ; barra de energia
  1252                                  BARRA_Y_BAIXO   EQU     440         
  1253                                  BARRA_Y_TOPO    EQU     460         
  1254                                  BARRA_P1_X      EQU     20          
  1255                                  BARRA_P2_X      EQU     420         
  1256                                  LARG_BLOCO      EQU     20          
  1257                                  
  1258                                  ; ------------------------------- Jogo -----------------------------------------
  1259                                  VELOCIDADE      EQU     4           ; pixels por tique (~73 px/s)
  1260                                  LIM_ESQ         EQU     40          ; menor X permitido para o centro do boneco
  1261                                  LIM_DIR         EQU     598         ; maior X permitido (braco vai ate +27)
  1262                                  DIST_MIN        EQU     50          ; distancia minima entre os dois lutadores
  1263                                  Y_CHAO          EQU     156         ; Y dos ombros com o lutador no chao
  1264                                  VEL_PULO        EQU     22          ; velocidade vertical inicial do pulo (px/tique)
  1265                                  GRAVIDADE       EQU     2           ; reducao de VY a cada tique
  1266 000000A2 00                      sair_flag       DB      0
  1267                                  
  1268 000000A3 2E00                    tam_corpo       DW      46
  1269 000000A5 1C00                    tam_braco       DW      28
  1270 000000A7 1E00                    tam_perna       DW      30
  1271                                  
  1272                                  ; ----------------------------------------------------------------------------
  1273                                  ; Estrutura de um jogador (20 bytes). Acesse sempre como [SI+campo].
  1274                                  ; ----------------------------------------------------------------------------
  1275                                  JX              EQU     0           ; dw  posicao X atual (centro do tronco)
  1276                                  JY              EQU     2           ; dw  posicao Y atual (ombros)
  1277                                  JXANT           EQU     4           ; dw  X onde foi desenhado por ultimo
  1278                                  JYANT           EQU     6           ; dw  Y onde foi desenhado por ultimo
  1279                                  JFRAME          EQU     8           ; db  frame atual da animacao
  1280                                  JFRAMEANT       EQU     9           ; db  frame desenhado por ultimo
  1281                                  JDIR            EQU     10          ; db  0 = olha p/ direita, 1 = p/ esquerda
  1282                                  JDIRANT         EQU     11          ; db  direcao desenhada por ultimo
  1283                                  JCOR            EQU     12          ; db  cor do lutador
  1284                                  JENERGIA        EQU     13          ; db  energia (comeca em 10)
  1285                                  JESTADO         EQU     14          ; db  0 idle, 1 movendo, 2 soco, 3 chute ...
  1286                                                                      ; byte 15: reserva (alinhamento)
  1287                                  JVY             EQU     16          ; dw  velocidade vertical (positiva = sobe)
  1288                                  JPULO           EQU     18          ; db  1 = no ar, 0 = no chao
  1289                                                                      ; byte 19: reserva (alinhamento)
  1290                                  JESTADOANT      EQU     19          ; 
  1291                                  
  1292                                  ALCANCE_SOCO    EQU     68          ; DIST_MIN (50) + mao (+52) -> margem soco
  1293                                  ALCANCE_CHUTE   EQU     74          ; DIST_MIN (50) + pe (+58)  -> margem chute
  1294                                  TOLERANCIA_Y    EQU     25          ; diferenca de altura para o soco pegar
  1295                                  
  1296                                  ; Y_CHAO = 156 deixa os pes (offset -84 do frame) logo acima do chao (Y = 70)
  1297                                  jogador1:
  1298 000000A9 96009C00                        DW      150, Y_CHAO         ; JX, JY
  1299 000000AD 96009C00                        DW      150, Y_CHAO         ; JXANT, JYANT
  1300 000000B1 0000                            DB      0, 0                ; JFRAME, JFRAMEANT
  1301 000000B3 0000                            DB      0, 0                ; JDIR, JDIRANT   (olha para a direita)
  1302 000000B5 09                              DB      azul_claro          ; JCOR
  1303 000000B6 0A                              DB      10                  ; JENERGIA
  1304 000000B7 00                              DB      0                   ; JESTADO
  1305 000000B8 00                              DB      0                   ; reserva
  1306 000000B9 0000                            DW      0                   ; JVY
  1307 000000BB 00                              DB      0                   ; JPULO
  1308 000000BC 00                              DB      0                   ; reserva
  1309 000000BD 00                              DB      0                   ; JESTADOANT
  1310                                  
  1311                                  jogador2:
  1312 000000BE EA019C00                        DW      490, Y_CHAO         ; JX, JY
  1313 000000C2 EA019C00                        DW      490, Y_CHAO         ; JXANT, JYANT
  1314 000000C6 0000                            DB      0, 0                ; JFRAME, JFRAMEANT
  1315 000000C8 0101                            DB      1, 1                ; JDIR, JDIRANT   (olha para a esquerda)
  1316 000000CA 04                              DB      vermelho            ; JCOR
  1317 000000CB 0A                              DB      10                  ; JENERGIA
  1318 000000CC 00                              DB      0                   ; JESTADO
  1319 000000CD 00                              DB      0                   ; reserva
  1320 000000CE 0000                            DW      0                   ; JVY
  1321 000000D0 00                              DB      0                   ; JPULO
  1322 000000D1 00                              DB      0                   ; reserva
  1323 000000D2 00                              DB      0                   ; JESTADOANT
  1324                                  
  1325                                  ; =============================================================================
  1326                                  
  1327                                  ; Limites de frames para cada estado
  1328 000000D3 010A0A0A03              limite_frames 	db 	1, 10, 10, 10, 3 ; Idle, andar, soco, chute, abaixar
  1329                                  
  1330                                  TEMPO_ROUND     EQU     180
  1331 000000D8 FFFF                    ultimo_seg      DW      0FFFFh
  1332 000000DA 00                      rounds_p1       DB      0
  1333 000000DB 00                      rounds_p2       DB      0
  1334 000000DC 00                      round_acabou    DB      0
  1335 000000DD 00                      vencedor        DB      0
  1336                                  
  1337                                  segment stack stack
  1338 00000000 <res 00000800>                  resb    2048
  1339                                  stacktop:
