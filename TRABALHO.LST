     1                                  ; =============================================================================
     2                                  ; trabalho.asm  -  Jogo de Luta em Assembly 8086 (modulo principal)
     3                                  ; -----------------------------------------------------------------------------
     4                                  ; Responsabilidades deste modulo:
     5                                  ;   - inicializacao (segmentos, vetores de interrupcao, modo de video)
     6                                  ;   - ISR de teclado (INT 9h) com TABELA DE ESTADO + buffer de eventos
     7                                  ;   - ISR de relogio (INT 8h) gerando o "tique" do loop do jogo
     8                                  ;   - loop principal sincronizado com o relogio
     9                                  ;   - movimentacao dos dois jogadores
    10                                  ;   - restauracao do sistema na saida
    11                                  ;
    12                                  ; Controles implementados nesta versao:
    13                                  ;   Jogador 1: A = esquerda, D = direita, W = pular
    14                                  ;   Jogador 2: seta esquerda, seta direita, seta cima = pular
    15                                  ;   ESC      : sai do programa (provisorio; o Q com confirmacao vem depois)
    16                                  ;
    17                                  ; Mecanica de orientacao:
    18                                  ;   - Os lutadores estao SEMPRE virados um para o outro (atualiza_direcao).
    19                                  ;   - No chao, um nao atravessa o outro (DIST_MIN).
    20                                  ;   - Pulando, o lutador pode passar por cima do adversario e trocar de lado;
    21                                  ;     ao pousar sobreposto, ele e empurrado para o lado em que caiu.
    22                                  ;
    23                                  ; Montagem (2 modulos):
    24                                  ;   nasm16 -f obj -o trabalho.obj -l trabalho.lst trabalho.asm
    25                                  ;   nasm16 -f obj -o graficos.obj -l graficos.lst graficos.asm
    26                                  ;   (ligar trabalho.obj + graficos.obj com o linker usado na disciplina)
    27                                  ; =============================================================================
    28                                  
    29                                  ; ------------------------------- Simbolos externos / publicos -----------------
    30                                  extern  desenha_jogador         ; graficos.asm
    31                                  extern  line                    ; graficos.asm
    32                                  extern  circle                  ; graficos.asm
    33                                  extern  full_circle             ; graficos.asm
    34                                  extern  cursor                  ; graficos.asm
    35                                  extern  caracter                ; graficos.asm
    36                                  
    37                                  global  cor
    38                                  global  deltAX
    39                                  global  deltay
    40                                  global  tam_corpo
    41                                  
    42                                  ; =============================================================================
    43                                  segment code public class=CODE
    44                                  ..start:
    45                                  ; ---------------------------------------------- Inicializacao dos registradores
    46 00000000 B8[0000]                        MOV     AX, data
    47 00000003 8ED8                            MOV     DS, AX
    48 00000005 B8[0000]                        MOV     AX, stack
    49 00000008 8ED0                            MOV     SS, AX
    50 0000000A BC[0008]                        MOV     SP, stacktop
    51                                  
    52                                  ; ---------------------------------------------- Instalacao das ISRs (INT 9 e INT 8)
    53 0000000D FA                              CLI                                 ; desabilita interrupcoes enquanto troca os vetores
    54 0000000E 31C0                            XOR     AX, AX
    55 00000010 8EC0                            MOV     ES, AX                      ; ES = 0000h -> tabela de vetores
    56                                  
    57 00000012 26A12400                        MOV     AX, [ES:INT9*4]             ; salva IP original da INT 9
    58 00000016 A3[0200]                        MOV     [offset_tec], AX
    59 00000019 26A12600                        MOV     AX, [ES:INT9*4+2]           ; salva CS original da INT 9
    60 0000001D A3[0000]                        MOV     [cs_tec], AX
    61 00000020 268C0E2600                      MOV     [ES:INT9*4+2], CS           ; instala nossa ISR de teclado
    62 00000025 26C7062400[E107]                MOV     WORD [ES:INT9*4], keyINT
    63                                  
    64 0000002C 26A12000                        MOV     AX, [ES:INTr*4]             ; salva IP original da INT 8
    65 00000030 A3[9100]                        MOV     [offset_clk], AX
    66 00000033 26A12200                        MOV     AX, [ES:INTr*4+2]           ; salva CS original da INT 8
    67 00000037 A3[9300]                        MOV     [cs_clk], AX
    68 0000003A 268C0E2200                      MOV     [ES:INTr*4+2], CS           ; instala nossa ISR de relogio
    69 0000003F 26C7062000[2E08]                MOV     WORD [ES:INTr*4], ClockINT
    70 00000046 FB                              STI                                 ; reabilita interrupcoes
    71                                  
    72                                  ; ---------------------------------------------- Modo grafico
    73 00000047 B40F                            MOV     AH, 0Fh                     ; le o modo de video atual
    74 00000049 CD10                            INT     10h
    75 0000004B A2[9D00]                        MOV     [modo_anterior], AL
    76                                  
    77                                  novo_round:
    78 0000004E B400                            MOV     AH, 0                       ; limpa tela 
    79 00000050 B012                            MOV     AL, 12h
    80 00000052 CD10                            INT     10h
    81                                  
    82 00000054 E81F06                          CALL    reseta_lutadores
    83 00000057 C606[9500]00                    MOV     byte [tique], 0
    84 0000005C C706[9600]0000                  MOV     WORD [segundos], 0
    85 00000062 C706[D800]FFFF                  MOV     WORD [ultimo_seg], 0FFFFh
    86 00000068 C606[DC00]00                    MOV     byte [round_acabou], 0
    87                                  
    88 0000006D E8F504                          CALL    desenha_arena
    89 00000070 BE[A900]                        MOV     SI, jogador1
    90 00000073 E85104                          CALL    pinta_jogador
    91 00000076 BE[BE00]                        MOV     SI, jogador2
    92 00000079 E84B04                          CALL    pinta_jogador
    93                                  
    94 0000007C A1[9800]                        MOV     AX, [tique_jogo]
    95 0000007F A3[9A00]                        MOV     [ultimo_tique], AX
    96                                  
    97                                  ; =============================================================================
    98                                  ; LOOP PRINCIPAL
    99                                  ; Roda uma vez a cada tique da INT 8h (~55 ms, 18,2 vezes por segundo).
   100                                  ; Nao ha atraso por laco de software: o ritmo vem do temporizador 8253.
   101                                  ; =============================================================================
   102                                  loop_jogo:
   103 00000082 A1[9800]                        MOV     AX, [tique_jogo]
   104 00000085 3B06[9A00]                      CMP     AX, [ultimo_tique]
   105 00000089 74F7                            JE      loop_jogo                   ; ainda no mesmo tique: espera
   106 0000008B A3[9A00]                        MOV     [ultimo_tique], AX
   107                                  
   108                                          ; ---- 1. Eventos pontuais (buffer circular) -------------------------
   109 0000008E E8AA00                          CALL    trata_eventos
   110 00000091 803E[A200]01                    CMP     byte [sair_flag], 1
   111 00000096 7503                            JNE     lj_cont
   112 00000098 E97200                          JMP     fim
   113                                  lj_cont:
   114                                  
   115                                          ; ---- 2. Teclas mantidas pressionadas (tabela de estado) ------------
   116 0000009B E8C900                          CALL    le_controles
   117                                  
   118                                          ; ---- 3. Fisica do pulo (gravidade e pouso) -------------------------
   119 0000009E BE[A900]                        MOV     SI, jogador1
   120 000000A1 BF[BE00]                        MOV     DI, jogador2
   121 000000A4 E87A02                          CALL    fisica_jogador
   122 000000A7 BE[BE00]                        MOV     SI, jogador2
   123 000000AA BF[A900]                        MOV     DI, jogador1
   124 000000AD E87102                          CALL    fisica_jogador
   125                                  
   126                                          ; ---- 4. Vira os lutadores um para o outro --------------------------
   127 000000B0 E8FA02                          CALL    atualiza_direcao
   128                                  
   129                                          ; ---- 5. Atualiza frames de animação --------------------------------
   130 000000B3 BE[A900]                        MOV     SI, jogador1
   131 000000B6 E84604                          CALL    atualiza_animacao
   132 000000B9 BE[BE00]                        MOV     SI, jogador2
   133 000000BC E84004                          CALL    atualiza_animacao
   134                                  
   135                                          ; ---- 5.5 Verifica colisao de golpes --------------------------------
   136 000000BF BE[A900]                        MOV     SI, jogador1                ; J1 atacando J2
   137 000000C2 BF[BE00]                        MOV     DI, jogador2
   138 000000C5 E80A03                          CALL    verifica_golpe
   139 000000C8 BE[BE00]                        MOV     SI, jogador2                ; J2 atacando J1
   140 000000CB BF[A900]                        MOV     DI, jogador1
   141 000000CE E80103                          CALL    verifica_golpe
   142                                  
   143 000000D1 E89C06                          CALL    desenha_tempo
   144 000000D4 E82C06                          CALL    verifica_fim_round
   145 000000D7 803E[DD00]00                    CMP     byte [vencedor], 0
   146 000000DC 7403                            JE      lj_checa_round
   147 000000DE E92C00                          JMP     fim
   148                                  lj_checa_round:
   149 000000E1 803E[DC00]00                    CMP     byte [round_acabou], 0
   150 000000E6 7403                            JE      lj_desenha
   151 000000E8 E963FF                          JMP     novo_round
   152                                  lj_desenha:
   153                                  
   154                                          ; ---- 6. Redesenha apenas se algo mudou -----------------------------
   155 000000EB E88D03                          CALL    houve_mudanca               ; retorna AL = 1 se precisa redesenhar
   156 000000EE 3C00                            CMP     AL, 0
   157 000000F0 7490                            JE      loop_jogo
   158                                  
   159 000000F2 BE[A900]                        MOV     SI, jogador1                ; apaga os dois na posicao antiga...
   160 000000F5 E84B04                          CALL    apaga_jogador
   161 000000F8 BE[BE00]                        MOV     SI, jogador2
   162 000000FB E84504                          CALL    apaga_jogador
   163 000000FE BE[A900]                        MOV     SI, jogador1                ; ...e redesenha os dois na nova
   164 00000101 E8C303                          CALL    pinta_jogador               ; (redesenhar ambos evita que um
   165 00000104 BE[BE00]                        MOV     SI, jogador2                ;  apague um pedaco do outro)
   166 00000107 E8BD03                          CALL    pinta_jogador
   167                                  
   168 0000010A E975FF                          JMP     loop_jogo
   169                                  
   170                                  ; =============================================================================
   171                                  ; fim: restaura vetores e modo de video e devolve o controle ao DOS
   172                                  ; =============================================================================
   173                                  fim:
   174 0000010D FA                              CLI
   175 0000010E 31C0                            XOR     AX, AX
   176 00000110 8EC0                            MOV     ES, AX
   177 00000112 A1[0000]                        MOV     AX, [cs_tec]                ; restaura INT 9
   178 00000115 26A32600                        MOV     [ES:INT9*4+2], AX
   179 00000119 A1[0200]                        MOV     AX, [offset_tec]
   180 0000011C 26A32400                        MOV     [ES:INT9*4], AX
   181 00000120 A1[9300]                        MOV     AX, [cs_clk]                ; restaura INT 8
   182 00000123 26A32200                        MOV     [ES:INTr*4+2], AX
   183 00000127 A1[9100]                        MOV     AX, [offset_clk]
   184 0000012A 26A32000                        MOV     [ES:INTr*4], AX
   185 0000012E FB                              STI
   186                                  
   187 0000012F B400                            MOV     AH, 0                       ; restaura o modo de video original
   188 00000131 A0[9D00]                        MOV     AL, [modo_anterior]
   189 00000134 CD10                            INT     10h
   190                                  
   191 00000136 B8004C                          MOV     AX, 4C00h                   ; retorna ao DOS
   192 00000139 CD21                            INT     21h
   193                                  
   194                                  ; =============================================================================
   195                                  ; trata_eventos
   196                                  ; Consome o buffer circular de codigos (eventos de "pressionou uma vez").
   197                                  ; Usado para teclas de comando (ESC agora; P, Q, Y, N, Enter depois).
   198                                  ; =============================================================================
   199                                  trata_eventos:
   200 0000013B 50                              PUSH    AX
   201 0000013C 53                              PUSH    BX
   202                                  te_prox:
   203 0000013D A1[0D00]                        MOV     AX, [p_i]
   204 00000140 3B06[0F00]                      CMP     AX, [p_t]
   205 00000144 741E                            JE      te_fim                      ; buffer vazio
   206 00000146 FF06[0F00]                      INC     WORD [p_t]
   207 0000014A 8126[0F00]0700                  AND     WORD [p_t], 7
   208 00000150 8B1E[0F00]                      MOV     BX, [p_t]
   209 00000154 8A87[0500]                      MOV     AL, [BX+tecla]
   210 00000158 A2[0400]                        MOV     [tecla_u], AL
   211                                  
   212 0000015B 3C01                            CMP     AL, TEC_ESC                 ; ESC pressionado (make 01h)
   213 0000015D 75DE                            JNE     te_prox
   214 0000015F C606[A200]01                    MOV     byte [sair_flag], 1
   215                                  te_fim:
   216 00000164 5B                              POP     BX
   217 00000165 58                              POP     AX
   218 00000166 C3                              RET
   219                                  
   220                                  ; =============================================================================
   221                                  ; le_controles
   222                                  ; Le a tabela de estado do teclado e move os jogadores.
   223                                  ; Como a tabela guarda cada tecla separadamente, os dois jogadores podem
   224                                  ; segurar suas teclas ao mesmo tempo sem um bloquear o outro.
   225                                  ; =============================================================================
   226                                  le_controles:
   227 00000167 50                              PUSH    AX
   228 00000168 53                              PUSH    BX
   229 00000169 56                              PUSH    SI
   230 0000016A 57                              PUSH    DI
   231                                  
   232 0000016B 31DB                            XOR     BX, BX
   233                                          ; ------------------------- Jogador 1 (W / A / S / D)
   234 0000016D BE[A900]                        MOV     SI, jogador1
   235 00000170 BF[BE00]                        MOV     DI, jogador2
   236                                  
   237 00000173 80BC0E0002                      CMP     byte [SI+JESTADO], 2    ; Jogador 1 está socando -> bloqueia movimentos
   238 00000178 7407                            JE      lc_p1_bloq
   239 0000017A 80BC0E0003                      CMP     byte [SI+JESTADO], 3    ; Jogador 1 está chutando -> bloqueia movimentos
   240 0000017F 7503                            JNE     lc_p1_w
   241                                  lc_p1_bloq:
   242 00000181 E98100                          JMP     lc_p2
   243                                  
   244                                  lc_p1_w:
   245 00000184 803E[2200]00                    CMP     byte [teclas+TEC_W], 0
   246 00000189 7405                            JE      lc_p1_abaixa
   247 0000018B FEC3                            INC     BL
   248 0000018D E87E01                          CALL    inicia_pulo
   249                                  lc_p1_abaixa:
   250 00000190 803E[3000]00                    CMP     byte [teclas+TEC_S], 0
   251 00000195 741D                            JE      lc_p1_esq
   252 00000197 80BC120000                      CMP     byte [SI+JPULO], 0      ; só abaixa se estiver no chão
   253 0000019C 7516                            JNE     lc_p1_esq
   254 0000019E FEC3                            INC     BL
   255 000001A0 80BC0E0004                      CMP     byte [SI+JESTADO], 4    
   256 000001A5 7435                            JE      lc_p1_soco              ; mantem o frame atual abaixado
   257 000001A7 C6840E0004                      MOV     byte [SI+JESTADO], 4
   258 000001AC C684080000                      MOV     byte [SI+JFRAME], 0
   259 000001B1 E92800                          JMP     lc_p1_soco              ; abaixado não anda, mas ainda pode atacar, HAAAIII.... YAH!!!
   260                                  lc_p1_esq:
   261 000001B4 803E[2F00]00                    CMP     byte [teclas+TEC_A], 0
   262 000001B9 740D                            JE      lc_p1_dir
   263 000001BB FEC3                            INC     BL
   264 000001BD B8FCFF                          MOV     AX, -VELOCIDADE
   265 000001C0 C6840E0001                      MOV     byte [SI+JESTADO], 1
   266 000001C5 E81101                          CALL    mover_jogador
   267                                  lc_p1_dir:
   268 000001C8 803E[3100]00                    CMP     byte [teclas+TEC_D], 0
   269 000001CD 740D                            JE      lc_p1_soco
   270 000001CF FEC3                            INC     BL
   271 000001D1 B80400                          MOV     AX, VELOCIDADE
   272 000001D4 C6840E0001                      MOV     byte [SI+JESTADO], 1
   273 000001D9 E8FD00                          CALL    mover_jogador
   274                                  lc_p1_soco:
   275 000001DC 803E[2500]00                    CMP     byte [teclas+TEC_T], 0
   276 000001E1 740F                            JE      lc_p1_chute
   277 000001E3 FEC3                            INC     BL
   278 000001E5 C6840E0002                      MOV     byte [SI+JESTADO], 2
   279 000001EA C684080000                      MOV     byte [SI+JFRAME], 0
   280 000001EF E91300                          JMP     lc_p2
   281                                  lc_p1_chute:
   282 000001F2 803E[2400]00                    CMP     byte [teclas+TEC_R], 0
   283 000001F7 740C                            JE      lc_p2
   284 000001F9 FEC3                            INC     BL
   285 000001FB C6840E0003                      MOV     byte [SI+JESTADO], 3
   286 00000200 C684080000                      MOV     byte [SI+JFRAME], 0
   287                                  
   288                                          ; ------------------------- Jogador 2 (setas)
   289                                  lc_p2:
   290 00000205 BE[BE00]                        MOV     SI, jogador2
   291 00000208 BF[A900]                        MOV     DI, jogador1
   292                                  
   293 0000020B 80BC0E0002                      CMP     byte [SI+JESTADO], 2    ; Jogador 2 está socando -> bloqueia movimentos
   294 00000210 7407                            JE      lc_p2_bloq
   295 00000212 80BC0E0003                      CMP     byte [SI+JESTADO], 3    ; Jogador 2 está chutando -> bloqueia movimentos
   296 00000217 7503                            JNE     lc_p2_cima
   297                                  lc_p2_bloq:
   298 00000219 E97E00                          JMP     lc_fim
   299                                  
   300                                  lc_p2_cima:
   301 0000021C 803E[5900]00                    CMP     byte [teclas+TEC_CIMA], 0
   302 00000221 7405                            JE      lc_p2_abaixa
   303 00000223 FEC7                            INC     BH
   304 00000225 E8E600                          CALL    inicia_pulo
   305                                  lc_p2_abaixa:
   306 00000228 803E[6100]00                    CMP     byte [teclas+TEC_BAIXO], 0
   307 0000022D 741D                            JE      lc_p2_esq
   308 0000022F 80BC120000                      CMP     byte [SI+JPULO], 0
   309 00000234 7516                            JNE     lc_p2_esq
   310 00000236 FEC7                            INC     BH
   311 00000238 80BC0E0004                      CMP     byte [SI+JESTADO], 4
   312 0000023D 7435                            JE      lc_p2_soco
   313 0000023F C6840E0004                      MOV     byte [SI+JESTADO], 4
   314 00000244 C684080000                      MOV     byte [SI+JFRAME], 0
   315 00000249 E92800                          JMP     lc_p2_soco
   316                                  lc_p2_esq:
   317 0000024C 803E[5C00]00                    CMP     byte [teclas+TEC_ESQ], 0
   318 00000251 740D                            JE      lc_p2_dir
   319 00000253 FEC7                            INC     BH
   320 00000255 B8FCFF                          MOV     AX, -VELOCIDADE
   321 00000258 C6840E0001                      MOV     byte [SI+JESTADO], 1
   322 0000025D E87900                          CALL    mover_jogador
   323                                  lc_p2_dir:
   324 00000260 803E[5E00]00                    CMP     byte [teclas+TEC_DIR], 0
   325 00000265 740D                            JE      lc_p2_soco
   326 00000267 FEC7                            INC     BH
   327 00000269 B80400                          MOV     AX, VELOCIDADE
   328 0000026C C6840E0001                      MOV     byte [SI+JESTADO], 1
   329 00000271 E86500                          CALL    mover_jogador
   330                                  lc_p2_soco:
   331 00000274 803E[4300]00                    CMP     byte [teclas+TEC_M], 0
   332 00000279 740C                            JE      lc_p2_chute
   333 0000027B FEC7                            INC     BH
   334 0000027D C6840E0002                      MOV     byte [SI+JESTADO], 2
   335 00000282 C684080000                      MOV     byte [SI+JFRAME], 0
   336                                  lc_p2_chute:
   337 00000287 803E[4200]00                    CMP     byte [teclas+TEC_N], 0
   338 0000028C 740C                            JE      lc_fim
   339 0000028E FEC7                            INC     BH
   340 00000290 C6840E0003                      MOV     byte [SI+JESTADO], 3
   341 00000295 C684080000                      MOV     byte [SI+JFRAME], 0
   342                                  lc_fim:
   343 0000029A 80FB00                          CMP     BL, 0
   344 0000029D 7518                            JNE     movp2
   345 0000029F 803E[B700]02                    CMP     byte [jogador1+JESTADO], 2
   346 000002A4 7411                            JE      movp2
   347 000002A6 803E[B700]03                    CMP     byte [jogador1+JESTADO], 3
   348 000002AB 740A                            JE      movp2
   349 000002AD C606[B700]00                    MOV     byte [jogador1 + JESTADO], 0
   350 000002B2 C606[B100]00                    MOV     byte [jogador1 + JFRAME], 0
   351                                  movp2:
   352 000002B7 80FF00                          CMP     BH, 0
   353 000002BA 7518                            JNE     lc_fim2
   354 000002BC 803E[CC00]02                    CMP     byte [jogador2+JESTADO], 2
   355 000002C1 7411                            JE      lc_fim2
   356 000002C3 803E[CC00]03                    CMP     byte [jogador2+JESTADO], 3
   357 000002C8 740A                            JE      lc_fim2
   358 000002CA C606[CC00]00                    MOV     byte [jogador2 + JESTADO], 0
   359 000002CF C606[C600]00                    MOV     byte [jogador2 + JFRAME], 0
   360                                  lc_fim2:
   361 000002D4 5F                              POP     DI
   362 000002D5 5E                              POP     SI
   363 000002D6 5B                              POP     BX
   364 000002D7 58                              POP     AX
   365 000002D8 C3                              RET
   366                                  
   367                                  ; =============================================================================
   368                                  ; mover_jogador
   369                                  ; Entrada: SI = jogador que se move, DI = adversario, AX = deslocamento em X
   370                                  ; So aplica o movimento se:
   371                                  ;   - o jogador continuar dentro dos limites da arena, e
   372                                  ;   - a distancia ate o adversario continuar >= DIST_MIN (nao atravessa).
   373                                  ; Se QUALQUER um dos dois estiver no ar, a distancia nao e verificada:
   374                                  ; e assim que um lutador passa por cima do outro e troca de lado.
   375                                  ; =============================================================================
   376                                  mover_jogador:
   377 000002D9 50                              PUSH    AX
   378 000002DA 53                              PUSH    BX
   379 000002DB 03840000                        ADD     AX, [SI+JX]                 ; AX = nova posicao X
   380 000002DF 3D2800                          CMP     AX, LIM_ESQ
   381 000002E2 7C27                            JL      mj_fim                      ; passaria da parede esquerda
   382 000002E4 3D5602                          CMP     AX, LIM_DIR
   383 000002E7 7F22                            JG      mj_fim                      ; passaria da parede direita
   384 000002E9 80BC120000                      CMP     byte [SI+JPULO], 0          ; quem anda esta no ar?
   385 000002EE 7517                            JNE     mj_aceita
   386 000002F0 80BD120000                      CMP     byte [DI+JPULO], 0          ; o adversario esta no ar?
   387 000002F5 7510                            JNE     mj_aceita
   388 000002F7 89C3                            MOV     BX, AX
   389 000002F9 2B9D0000                        SUB     BX, [DI+JX]                 ; BX = nova_x - x_adversario
   390 000002FD 7902                            JNS     mj_abs
   391 000002FF F7DB                            NEG     BX                          ; BX = |distancia|
   392                                  mj_abs:
   393 00000301 81FB3200                        CMP     BX, DIST_MIN
   394 00000305 7C04                            JL      mj_fim                      ; encostaria/atravessaria o adversario
   395                                  mj_aceita:
   396 00000307 89840000                        MOV     [SI+JX], AX                 ; movimento aceito
   397                                  mj_fim:
   398 0000030B 5B                              POP     BX
   399 0000030C 58                              POP     AX
   400 0000030D C3                              RET
   401                                  
   402                                  ; =============================================================================
   403                                  ; inicia_pulo
   404                                  ; Entrada: SI = jogador. So pula se estiver no chao.
   405                                  ; =============================================================================
   406                                  inicia_pulo:
   407 0000030E 80BC120000                      CMP     byte [SI+JPULO], 0
   408 00000313 750B                            JNE     ip_fim                      ; ja esta no ar: ignora
   409 00000315 C684120001                      MOV     byte [SI+JPULO], 1
   410 0000031A C78410001600                    MOV     WORD [SI+JVY], VEL_PULO     ; velocidade vertical inicial (para cima)
   411                                  ip_fim:
   412 00000320 C3                              RET
   413                                  
   414                                  ; =============================================================================
   415                                  ; fisica_jogador
   416                                  ; Entrada: SI = jogador, DI = adversario. Executada uma vez por tique.
   417                                  ;   Y  <- Y + VY
   418                                  ;   VY <- VY - GRAVIDADE
   419                                  ; Ao tocar o chao (Y <= Y_CHAO): fixa Y no chao, zera VY, encerra o pulo
   420                                  ; e resolve uma eventual sobreposicao com o adversario.
   421                                  ; Com VEL_PULO = 22 e GRAVIDADE = 2 o pulo sobe 132 px e dura ~1,3 s
   422                                  ; (os pes passam cerca de 30 px acima da cabeca do adversario).
   423                                  ; =============================================================================
   424                                  fisica_jogador:
   425 00000321 50                              PUSH    AX
   426 00000322 80BC120000                      CMP     byte [SI+JPULO], 0
   427 00000327 742A                            JE      fj_fim                      ; no chao: nada a fazer
   428 00000329 8B841000                        MOV     AX, [SI+JVY]
   429 0000032D 01840200                        ADD     [SI+JY], AX                 ; move na vertical
   430 00000331 81AC10000200                    SUB     WORD [SI+JVY], GRAVIDADE    ; gravidade
   431 00000337 81BC02009C00                    CMP     WORD [SI+JY], Y_CHAO
   432 0000033D 7F14                            JG      fj_fim                      ; ainda no ar
   433 0000033F C78402009C00                    MOV     WORD [SI+JY], Y_CHAO        ; pousou
   434 00000345 C78410000000                    MOV     WORD [SI+JVY], 0
   435 0000034B C684120000                      MOV     byte [SI+JPULO], 0
   436 00000350 E80200                          CALL    separa_ao_pousar
   437                                  fj_fim:
   438 00000353 58                              POP     AX
   439 00000354 C3                              RET
   440                                  
   441                                  ; =============================================================================
   442                                  ; separa_ao_pousar
   443                                  ; Entrada: SI = jogador que acabou de pousar, DI = adversario.
   444                                  ; Se pousou a menos de DIST_MIN do adversario (que esta no chao), empurra
   445                                  ; quem pousou para o lado em que caiu. Se a parede impedir, empurra o
   446                                  ; adversario para o outro lado. Se o adversario ainda estiver no ar, a
   447                                  ; separacao sera feita quando ELE pousar.
   448                                  ; =============================================================================
   449                                  separa_ao_pousar:
   450 00000355 50                              PUSH    AX
   451 00000356 53                              PUSH    BX
   452 00000357 80BD120000                      CMP     byte [DI+JPULO], 0
   453 0000035C 754C                            JNE     sp_fim                      ; adversario no ar: resolve depois
   454 0000035E 8B840000                        MOV     AX, [SI+JX]
   455 00000362 2B850000                        SUB     AX, [DI+JX]                 ; AX = x_pousou - x_adversario
   456 00000366 89C3                            MOV     BX, AX
   457 00000368 7902                            JNS     sp_abs
   458 0000036A F7DB                            NEG     BX
   459                                  sp_abs:
   460 0000036C 81FB3200                        CMP     BX, DIST_MIN
   461 00000370 7D38                            JGE     sp_fim                      ; ja estao afastados o suficiente
   462                                  
   463 00000372 8B9D0000                        MOV     BX, [DI+JX]
   464 00000376 3D0000                          CMP     AX, 0
   465 00000379 7C17                            JL      sp_esquerda
   466                                          ; ---- caiu a direita (ou exatamente em cima): vai para a direita
   467 0000037B 81C33200                        ADD     BX, DIST_MIN
   468 0000037F 81FB5602                        CMP     BX, LIM_DIR
   469 00000383 7E21                            JLE     sp_grava
   470 00000385 BB5602                          MOV     BX, LIM_DIR                 ; parede direita: encosta nela...
   471 00000388 B82402                          MOV     AX, LIM_DIR - DIST_MIN
   472 0000038B 89850000                        MOV     [DI+JX], AX                 ; ...e empurra o adversario
   473 0000038F E91400                          JMP     sp_grava
   474                                  sp_esquerda:
   475                                          ; ---- caiu a esquerda: vai para a esquerda
   476 00000392 81EB3200                        SUB     BX, DIST_MIN
   477 00000396 81FB2800                        CMP     BX, LIM_ESQ
   478 0000039A 7D0A                            JGE     sp_grava
   479 0000039C BB2800                          MOV     BX, LIM_ESQ                 ; parede esquerda: encosta nela...
   480 0000039F B85A00                          MOV     AX, LIM_ESQ + DIST_MIN
   481 000003A2 89850000                        MOV     [DI+JX], AX                 ; ...e empurra o adversario
   482                                  sp_grava:
   483 000003A6 899C0000                        MOV     [SI+JX], BX
   484                                  sp_fim:
   485 000003AA 5B                              POP     BX
   486 000003AB 58                              POP     AX
   487 000003AC C3                              RET
   488                                  
   489                                  ; =============================================================================
   490                                  ; atualiza_direcao
   491                                  ; Mantem os lutadores sempre virados um para o outro:
   492                                  ;   x1 < x2 -> J1 olha para a direita (0) e J2 para a esquerda (1)
   493                                  ;   x1 > x2 -> J1 olha para a esquerda (1) e J2 para a direita (0)
   494                                  ;   x1 = x2 -> (um sobre o outro, no pulo) mantem a direcao atual
   495                                  ; A troca de direcao e detectada por houve_mudanca (JDIR x JDIRANT) e o
   496                                  ; boneco e redesenhado espelhado automaticamente.
   497                                  ; =============================================================================
   498                                  atualiza_direcao:
   499 000003AD 50                              PUSH    AX
   500 000003AE A1[A900]                        MOV     AX, [jogador1+JX]
   501 000003B1 3B06[BE00]                      CMP     AX, [jogador2+JX]
   502 000003B5 7419                            JE      ad_fim
   503 000003B7 7F0D                            JG      ad_invertido
   504 000003B9 C606[B300]00                    MOV     byte [jogador1+JDIR], 0
   505 000003BE C606[C800]01                    MOV     byte [jogador2+JDIR], 1
   506 000003C3 E90A00                          JMP     ad_fim
   507                                  ad_invertido:
   508 000003C6 C606[B300]01                    MOV     byte [jogador1+JDIR], 1
   509 000003CB C606[C800]00                    MOV     byte [jogador2+JDIR], 0
   510                                  ad_fim:
   511 000003D0 58                              POP     AX
   512 000003D1 C3                              RET
   513                                          
   514                                          
   515                                  ; =============================================================================
   516                                  ; verifica_golpe
   517                                  ; Entrada: SI = atacante, DI = defensor.
   518                                  ; Verifica se SI esta no frame exato de impacto de um soco ou chute e se DI
   519                                  ; esta dentro do alcance horizontal e vertical.
   520                                  ; =============================================================================
   521                                  verifica_golpe:
   522 000003D2 50                              PUSH AX
   523 000003D3 53                              PUSH BX
   524                                  
   525 000003D4 8A840E00                        MOV AL, [SI+JESTADO]
   526 000003D8 8AA40800                        MOV AH, [SI+JFRAME]
   527                                  
   528 000003DC 3C02                            CMP AL, 2
   529 000003DE 7407                            JE vg_testa_soco
   530 000003E0 3C03                            CMP AL, 3
   531 000003E2 7426                            JE vg_testa_chute
   532 000003E4 E95000                          JMP vg_fim
   533                                  
   534                                  ; tratando soconelson
   535                                  vg_testa_soco:
   536 000003E7 80FC02                          CMP AH, 2
   537 000003EA 754B                            JNE vg_fim
   538                                  
   539                                          ; verifica se o defensor nao esta abaixado
   540 000003EC 80BD0E0004                      CMP byte [DI+JESTADO], 4
   541 000003F1 7444                            JE vg_fim
   542                                  
   543                                          ; verifica se o defensor e o atacante estao na mesma posicao Y
   544                                  
   545 000003F3 8B840200                        MOV AX, [SI+JY]
   546 000003F7 2B850200                        SUB AX, [DI+JY]
   547 000003FB 7902                            JNS vg_soco_abs_y
   548 000003FD F7D8                            NEG AX
   549                                  
   550                                  vg_soco_abs_y:
   551 000003FF 3D1900                          CMP AX, TOLERANCIA_Y
   552 00000402 7F33                            JG vg_fim
   553                                  
   554 00000404 BB4400                          MOV BX, ALCANCE_SOCO
   555 00000407 E90F00                          JMP vg_checa_dist_x
   556                                  
   557                                  vg_testa_chute:
   558 0000040A 80FC03                          CMP AH, 3
   559 0000040D 7528                            JNE vg_fim
   560                                  
   561 0000040F 80BD120000                      CMP byte [DI+JPULO], 0
   562 00000414 7521                            JNE vg_fim
   563                                  
   564 00000416 BB4A00                          MOV BX, ALCANCE_CHUTE
   565                                  
   566                                  vg_checa_dist_x:
   567 00000419 8B840000                        MOV     AX, [SI+JX]
   568 0000041D 2B850000                        SUB     AX, [DI+JX]                 
   569 00000421 7902                            JNS     vg_abs_x
   570 00000423 F7D8                            NEG     AX                          
   571                                  vg_abs_x:
   572 00000425 39D8                            CMP     AX, BX                      
   573 00000427 7F0E                            JG      vg_fim                      
   574                                  ; --------------------------------------------------- golpe pegou
   575 00000429 80BD0D0000                      CMP     byte [DI+JENERGIA], 0       
   576 0000042E 7407                            JE      vg_fim
   577 00000430 FE8D0D00                        DEC     byte [DI+JENERGIA]
   578 00000434 E80300                          CALL    atualiza_barra
   579                                  vg_fim:
   580 00000437 5B                              POP     BX
   581 00000438 58                              POP     AX
   582 00000439 C3                              RET
   583                                  
   584                                  
   585                                  ; =============================================================================
   586                                  ; atualiza_barra
   587                                  ; Entrada: DI = jogador que acabou de perder 1 ponto de energia.
   588                                  ; Apaga (pinta de preto) apenas o bloco de 20 px correspondente ao novo valor
   589                                  ; de [DI+JENERGIA], sem precisar redesenhar o resto da barra.
   590                                  ; =============================================================================
   591                                  atualiza_barra:
   592 0000043A 50                              PUSH    AX
   593 0000043B 53                              PUSH    BX
   594 0000043C 51                              PUSH    CX
   595 0000043D 52                              PUSH    DX
   596                                  
   597                                          
   598 0000043E 8A850D00                        MOV     AL, [DI+JENERGIA]           
   599 00000442 30E4                            XOR     AH, AH
   600 00000444 B314                            MOV     BL, LARG_BLOCO              
   601 00000446 F6E3                            MUL     BL                          
   602                                  
   603                                          
   604 00000448 81FF[A900]                      CMP     DI, jogador1
   605 0000044C 7506                            JNE     ab_jogador2
   606                                  
   607                                          
   608 0000044E 051400                          ADD     AX, BARRA_P1_X
   609 00000451 E90300                          JMP     ab_apaga
   610                                  
   611                                  ab_jogador2:
   612                                          
   613 00000454 05A401                          ADD     AX, BARRA_P2_X
   614                                  
   615                                  ab_apaga:
   616 00000457 89C1                            MOV     CX, AX                       
   617 00000459 89C2                            MOV     DX, AX
   618 0000045B 81C21400                        ADD     DX, LARG_BLOCO              
   619 0000045F C606[9C00]00                    MOV     byte [cor], preto
   620                                  
   621                                  ab_loop:
   622 00000464 51                              PUSH    CX                          
   623 00000465 B8B801                          MOV     AX, BARRA_Y_BAIXO
   624 00000468 50                              PUSH    AX                          
   625 00000469 51                              PUSH    CX                          
   626 0000046A B8CC01                          MOV     AX, BARRA_Y_TOPO
   627 0000046D 50                              PUSH    AX                          
   628 0000046E E8(0000)                        CALL    line
   629 00000471 41                              INC     CX
   630 00000472 39D1                            CMP     CX, DX
   631 00000474 7CEE                            JL      ab_loop
   632                                  
   633 00000476 5A                              POP     DX
   634 00000477 59                              POP     CX
   635 00000478 5B                              POP     BX
   636 00000479 58                              POP     AX
   637 0000047A C3                              RET
   638                                  ; =============================================================================
   639                                  ; houve_mudanca
   640                                  ; Saida: AL = 1 se algum jogador mudou de posicao/frame/direcao desde o
   641                                  ;        ultimo desenho; AL = 0 caso contrario.
   642                                  ; =============================================================================
   643                                  houve_mudanca:
   644 0000047B 56                              PUSH    SI
   645 0000047C BE[A900]                        MOV     SI, jogador1
   646 0000047F E80C00                          CALL    jogador_mudou
   647 00000482 3C01                            CMP     AL, 1
   648 00000484 7406                            JE      hm_fim
   649 00000486 BE[BE00]                        MOV     SI, jogador2
   650 00000489 E80200                          CALL    jogador_mudou
   651                                  hm_fim:
   652 0000048C 5E                              POP     SI
   653 0000048D C3                              RET
   654                                  
   655                                  ; Entrada: SI = jogador. Saida: AL = 1 se mudou, 0 se nao.
   656                                  jogador_mudou:
   657 0000048E 53                              PUSH    BX
   658 0000048F B001                            MOV     AL, 1
   659 00000491 8B9C0000                        MOV     BX, [SI+JX]
   660 00000495 3B9C0400                        CMP     BX, [SI+JXANT]
   661 00000499 752A                            JNE     jm_fim
   662 0000049B 8B9C0200                        MOV     BX, [SI+JY]
   663 0000049F 3B9C0600                        CMP     BX, [SI+JYANT]
   664 000004A3 7520                            JNE     jm_fim
   665 000004A5 8A9C0800                        MOV     BL, [SI+JFRAME]
   666 000004A9 3A9C0900                        CMP     BL, [SI+JFRAMEANT]
   667 000004AD 7516                            JNE     jm_fim
   668 000004AF 8A9C0E00                        MOV     BL, [SI+JESTADO]
   669 000004B3 3A9C1300                        CMP     BL, [SI+JESTADOANT]
   670 000004B7 750C                            JNE     jm_fim
   671 000004B9 8A9C0A00                        MOV     BL, [SI+JDIR]
   672 000004BD 3A9C0B00                        CMP     BL, [SI+JDIRANT]
   673 000004C1 7502                            JNE     jm_fim
   674 000004C3 B000                            MOV     AL, 0
   675                                  jm_fim:
   676 000004C5 5B                              POP     BX
   677 000004C6 C3                              RET
   678                                  
   679                                  ; =============================================================================
   680                                  ; pinta_jogador
   681                                  ; Entrada: SI = jogador. Desenha na posicao ATUAL, com a cor do jogador, e
   682                                  ; guarda essa posicao/frame/direcao como "anterior" (para poder apagar depois).
   683                                  ; =============================================================================
   684                                  pinta_jogador:
   685 000004C7 50                              PUSH    AX
   686 000004C8 53                              PUSH    BX
   687 000004C9 51                              PUSH    CX
   688 000004CA 52                              PUSH    DX
   689 000004CB 8A840C00                        MOV     AL, [SI+JCOR]
   690 000004CF 8AA40800                        MOV     AH, [SI+JFRAME]
   691 000004D3 8A9C0A00                        MOV     BL, [SI+JDIR]
   692 000004D7 8ABC0E00                        MOV     BH, [SI+JESTADO]
   693 000004DB 8B8C0000                        MOV     CX, [SI+JX]
   694 000004DF 8B940200                        MOV     DX, [SI+JY]
   695 000004E3 E8(0000)                        CALL    desenha_jogador             ; preserva todos os registradores
   696 000004E6 898C0400                        MOV     [SI+JXANT], CX
   697 000004EA 89940600                        MOV     [SI+JYANT], DX
   698 000004EE 88A40900                        MOV     [SI+JFRAMEANT], AH
   699 000004F2 88BC1300                        MOV     [SI+JESTADOANT], BH
   700 000004F6 889C0B00                        MOV     [SI+JDIRANT], BL
   701 000004FA 5A                              POP     DX
   702 000004FB 59                              POP     CX
   703 000004FC 5B                              POP     BX
   704 000004FD 58                              POP     AX
   705 000004FE C3                              RET
   706                                  
   707                                  ; =============================================================================
   708                                  ; atualiza_animacao
   709                                  ; Entrada: SI = jogador. 
   710                                  ; Incrementa o frame atual e faz o loop (zera) se atingir o limite do estado.
   711                                  ; =============================================================================
   712                                  atualiza_animacao:
   713 000004FF 50                              PUSH    AX
   714 00000500 53                              PUSH    BX
   715                                  
   716                                          ; 1. Lê o estado atual do jogador
   717 00000501 8A9C0E00                        MOV     BL, [SI+JESTADO]
   718 00000505 30FF                            XOR     BH, BH
   719                                  
   720                                          ; 2. Pega o número máximo de frames para este estado
   721 00000507 8A87[D300]                      MOV     AL, [limite_frames + BX] 
   722                                  
   723                                          ; 3. Incrementa o frame
   724 0000050B FE840800                        INC     byte [SI+JFRAME]
   725                                  
   726                                          ; 4. Verifica se estourou o limite
   727 0000050F 38840800                        CMP     [SI+JFRAME], AL
   728 00000513 7C2B                            JL      aa_fim              ; Se frame < limite, termina
   729                                  
   730                                          ; Se estiver abaixado (Estado 4), trava no último frame (Frame 2) enquanto segurar
   731 00000515 80BC0E0004                      CMP     byte [SI+JESTADO], 4
   732 0000051A 7509                            JNE     aa_ciclo
   733 0000051C FEC8                            DEC     AL
   734 0000051E 88840800                        MOV     [SI+JFRAME], AL
   735 00000522 E91B00                          JMP     aa_fim
   736                                  
   737                                  aa_ciclo:
   738                                          ; Se chegou ao limite do ciclo:
   739 00000525 C684080000                      MOV     byte [SI+JFRAME], 0 ; Reseta o frame para 0
   740                                  
   741                                          ; Se estiver num golpe (Estado 2: Soco, Estado 3: Chute), reseta para Idle (0)
   742 0000052A 80BC0E0002                      CMP     byte [SI+JESTADO], 2
   743 0000052F 740A                            JE      aa_reseta_idle
   744 00000531 80BC0E0003                      CMP     byte [SI+JESTADO], 3
   745 00000536 7403                            JE      aa_reseta_idle
   746 00000538 E90500                          JMP     aa_fim
   747                                  
   748                                  aa_reseta_idle:
   749 0000053B C6840E0000                      MOV     byte [SI+JESTADO], 0
   750                                  
   751                                  aa_fim:
   752 00000540 5B                              POP     BX
   753 00000541 58                              POP     AX
   754 00000542 C3                              RET
   755                                  
   756                                  ; =============================================================================
   757                                  ; apaga_jogador
   758                                  ; Entrada: SI = jogador. Redesenha em PRETO na posicao ANTERIOR.
   759                                  ; =============================================================================
   760                                  apaga_jogador:
   761 00000543 50                              PUSH    AX
   762 00000544 53                              PUSH    BX
   763 00000545 51                              PUSH    CX
   764 00000546 52                              PUSH    DX
   765 00000547 B000                            MOV     AL, preto
   766 00000549 8AA40900                        MOV     AH, [SI+JFRAMEANT]
   767 0000054D 8A9C0B00                        MOV     BL, [SI+JDIRANT]
   768 00000551 8ABC1300                        MOV     BH, [SI+JESTADOANT]
   769 00000555 8B8C0400                        MOV     CX, [SI+JXANT]
   770 00000559 8B940600                        MOV     DX, [SI+JYANT]
   771 0000055D E8(0000)                        CALL    desenha_jogador
   772 00000560 5A                              POP     DX
   773 00000561 59                              POP     CX
   774 00000562 5B                              POP     BX
   775 00000563 58                              POP     AX
   776 00000564 C3                              RET
   777                                  
   778                                  ; =============================================================================
   779                                  ; desenha_arena
   780                                  ; Retangulo da arena: chao em Y = ARENA_BAIXO, teto em Y = ARENA_TOPO,
   781                                  ; paredes em X = ARENA_ESQ e X = ARENA_DIR. A faixa acima do teto fica
   782                                  ; reservada para o HUD (energia, tempo, rounds).
   783                                  ; =============================================================================
   784                                  desenha_arena:
   785 00000565 50                              PUSH    AX
   786 00000566 C606[9C00]0F                    MOV     byte [cor], branco_intenso
   787                                  
   788 0000056B B80A00                          MOV     AX, ARENA_ESQ               ; chao
   789 0000056E 50                              PUSH    AX
   790 0000056F B84600                          MOV     AX, ARENA_BAIXO
   791 00000572 50                              PUSH    AX
   792 00000573 B87502                          MOV     AX, ARENA_DIR
   793 00000576 50                              PUSH    AX
   794 00000577 B84600                          MOV     AX, ARENA_BAIXO
   795 0000057A 50                              PUSH    AX
   796 0000057B E8(0000)                        CALL    line
   797                                  
   798 0000057E B80A00                          MOV     AX, ARENA_ESQ               ; teto
   799 00000581 50                              PUSH    AX
   800 00000582 B8A401                          MOV     AX, ARENA_TOPO
   801 00000585 50                              PUSH    AX
   802 00000586 B87502                          MOV     AX, ARENA_DIR
   803 00000589 50                              PUSH    AX
   804 0000058A B8A401                          MOV     AX, ARENA_TOPO
   805 0000058D 50                              PUSH    AX
   806 0000058E E8(0000)                        CALL    line
   807                                  
   808 00000591 B80A00                          MOV     AX, ARENA_ESQ               ; parede esquerda
   809 00000594 50                              PUSH    AX
   810 00000595 B84600                          MOV     AX, ARENA_BAIXO
   811 00000598 50                              PUSH    AX
   812 00000599 B80A00                          MOV     AX, ARENA_ESQ
   813 0000059C 50                              PUSH    AX
   814 0000059D B8A401                          MOV     AX, ARENA_TOPO
   815 000005A0 50                              PUSH    AX
   816 000005A1 E8(0000)                        CALL    line
   817                                  
   818 000005A4 B87502                          MOV     AX, ARENA_DIR               ; parede direita
   819 000005A7 50                              PUSH    AX
   820 000005A8 B84600                          MOV     AX, ARENA_BAIXO
   821 000005AB 50                              PUSH    AX
   822 000005AC B87502                          MOV     AX, ARENA_DIR
   823 000005AF 50                              PUSH    AX
   824 000005B0 B8A401                          MOV     AX, ARENA_TOPO
   825 000005B3 50                              PUSH    AX
   826 000005B4 E8(0000)                        CALL    line
   827                                          
   828 000005B7 E80200                          CALL desenha_barras
   829                                  
   830 000005BA 58                              POP     AX
   831 000005BB C3                              RET
   832                                          
   833                                  
   834                                  ; =============================================================================
   835                                  ; desenha_barras
   836                                  ; Desenha as duas barras de energia completas (200 px cada) no topo da tela:
   837                                  ;   Jogador 1 (esquerda): X = 20..219, cor = [jogador1+JCOR] (vermelho)
   838                                  ;   Jogador 2 (direita) : X = 420..619, cor = [jogador2+JCOR] (azul_claro)
   839                                  ; =============================================================================
   840                                  desenha_barras:
   841 000005BC 50                              PUSH    AX
   842 000005BD 51                              PUSH    CX
   843                                  
   844                                          ; ---- Barra do Jogador 1 (Esquerda) ---------------------------------
   845 000005BE A0[B500]                        MOV     AL, [jogador1+JCOR]
   846 000005C1 A2[9C00]                        MOV     [cor], AL
   847 000005C4 B91400                          MOV     CX, BARRA_P1_X              ; comeca em X = 20
   848                                  db_loop_p1:
   849 000005C7 51                              PUSH    CX                          ; x1 = CX
   850 000005C8 B8B801                          MOV     AX, BARRA_Y_BAIXO
   851 000005CB 50                              PUSH    AX                          ; y1 = 440
   852 000005CC 51                              PUSH    CX                         
   853 000005CD B8CC01                          MOV     AX, BARRA_Y_TOPO
