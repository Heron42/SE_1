 ;-----------------------------------------------------------------------------
+; escreve_texto
+; Entrada: DS:SI = texto terminado em 0, DH = linha (0-29), DL = coluna (0-79)
+;          cor definida na variavel cor
+; Preserva todos os registradores.
+;-----------------------------------------------------------------------------
+escreve_texto:
+        PUSHF
+        PUSH    AX
+        PUSH    DX
+        PUSH    SI
+        CLD
+et_loop:
+        LODSB
+        CMP     AL, 0
+        JE      et_fim
+        CALL    cursor
+        CALL    caracter
+        INC     DL
+        JMP     et_loop
+et_fim:
+        POP     SI
+        POP     DX
+        POP     AX
+        POPF
+        RET
+
+;-----------------------------------------------------------------------------
+; apaga_texto
+; Entrada: DH = linha, DL = coluna inicial, CX = numero de caracteres.
+; Escreve espacos (a BIOS preenche a celula 8x16 com o fundo preto).
+; Preserva todos os registradores.
+;-----------------------------------------------------------------------------
+apaga_texto:
+        PUSHF
+        PUSH    AX
+        PUSH    CX
+        PUSH    DX
+        JCXZ    at_fim
+        MOV     AL, ' '
+at_loop:
+        CALL    cursor
+        CALL    caracter
+        INC     DL
+        LOOP    at_loop
+at_fim:
+        POP     DX
+        POP     CX
+        POP     AX
+        POPF
+        RET
+
+;-----------------------------------------------------------------------------
+; limpa_tela
+; Reprograma o modo 12h (VGA 640x480, 16 cores), o que tambem apaga a tela.
+; Preserva todos os registradores.
+;-----------------------------------------------------------------------------
+limpa_tela:
+        PUSH    AX
+        MOV     AX, 0012h
+        INT     10h
+        POP     AX
+        RET
+
